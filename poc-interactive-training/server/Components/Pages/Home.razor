							@if (_session?.ContextAudit.Initial is { } initial)
							{
								<div class="audit-body">
									<div class="audit-scoreline">
										<span class="ctx-label ctx-@initial.PredictedLabel.ToLowerInvariant()">@initial.PredictedLabel</span>
										<div><strong>@initial.Score/100</strong><small>context readiness · @initial.Confidence% confidence</small></div>
