	private async Task RunBenchmark()
	{
		if (_benchmarkRunning) return;
		_benchmarkRunning = true;
		try
		{
			var measured = await Task.Run(() => (Conformance: ClaraConformance.Run(), Benchmark: Benchmark.Run()));
			_conformance = measured.Conformance;
			_benchmark = measured.Benchmark;
		}
		finally
		{
			_benchmarkRunning = false;
		}
	}
