												<td>@row.NanosecondsPerCall.ToString("N1")</td>
												<td>@row.MillionCallsPerSecond.ToString("N1")</td>
												<td>@row.RelativeToCSharp.ToString("N2")x</td>
												<td>@row.Detail</td>
											</tr>
										}
									</tbody>
								</table>
								<p class="rt-reco">@measurement.Summary</p>
								<small>Policy @measurement.PolicyName compiled once in @measurement.CompileMilliseconds.ToString("N2") ms, then executed @measurement.Iterations.ToString("N0") times per round, best of @measurement.Rounds rounds after warm-up. Output parity verified on @measurement.ParityChecks.ToString("N0") inputs with @measurement.ParityMismatches mismatches.</small>
							}
							else if (!_benchmarkRunning)
							{
								<div class="rt-placeholder">Run the benchmark to see whether the language is fast enough to sit on a hot path.</div>
							}
						</section>
					</section>
					break;
				case 14:
					<section>
						<p class="kicker">DOES THE REPRESENTATION CHANGE THE OUTCOME?</p>
						<h2 id="scene-title">The same ticket, the same model, no context either way</h2>
						<p class="rt-intro">An agent starts with no knowledge of your business. Here Gemma 4 is given one JIRA ticket twice, with <strong>no context artifacts in either arm</strong>. One arm sees an ordinary C# class where the local policy knowledge lives only in people's heads; the other sees a CLARA policy carrying that knowledge inline as descriptions, <code>because</code> citations, preconditions and invariants. Claude Opus 5.0 then grades both against sealed criteria neither arm ever saw.</p>

						@if (_session?.LanguageTest is { } test)
						{
							<div class="clara-signature">
								Context cost for the same logic · C# class alone <strong>@test.CSharpTokens.ToString("N0")</strong> tokens ·
								C# plus the policy documents it would need <strong>@((test.CSharpTokens + test.ContextPackTokens).ToString("N0"))</strong> ·
								CLARA policy, knowledge and 8 executable examples included <strong>@test.ClaraTokens.ToString("N0")</strong> ·
								<small>@test.TokenMethod</small>
							</div>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>The C# class</strong><small>the rules are all here; the reasons are not</small></div></header>
								<pre class="rt-code">@test.CSharpSource</pre>
							</section>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>The same logic in CLARA</strong><small>the rules and the local knowledge that governs them</small></div></header>
								<pre class="rt-code">@test.ClaraSource</pre>
							</section>

							<section class="rt-box rt-input-box">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>The JIRA</strong><small>given identically to both arms</small></div></header>
								<textarea class="rt-code-input" spellcheck="false" maxlength="8000" @bind="_languageJira" @bind:event="oninput" disabled="@LanguageBusy" aria-label="JIRA ticket"></textarea>
								<div class="rt-actions">
									<small>@_languageJira.Length / 8000</small>
									<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || _languageJira.Trim().Length < 20 || LanguageBusy)" @onclick="RunLanguageTest">@LanguageButtonText</button>
								</div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running the test.</p>
								}
							</section>

							@foreach (var pair in new[] { ("csharp", "4", "Gemma 4 working from the C# class", "no context beyond the class"), ("clara", "5", "Gemma 4 working from the CLARA policy", "no context beyond the policy") })
							{
								var arm = ArmFor(pair.Item1);
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">@pair.Item2</span><div><strong>@pair.Item3</strong><small>@(arm?.ModelUsed ?? "Gemma 4") · @pair.Item4 · @(arm is null ? "—" : $"{arm.PromptTokens:N0} prompt tokens")</small></div></header>
									@if (arm?.Answer is { Length: > 0 } answer)
									{
										<pre class="rt-code">@answer</pre>
										@if (arm.Verification is { } verification)
										{
											<div class="@(verification.Compiled && verification.Examples.All(example => example.Passed != false) ? "compare-status" : "compare-status failed")" role="status">
												@if (!verification.Compiled)
												{
													<text>The edited policy did not compile — @verification.Errors.Count error(s). The agent's mistake was caught before review.</text>
												}
												else
												{
													<text>Compiled. @verification.Examples.Count(example => example.Passed == true) of @verification.Examples.Count declared examples pass; @verification.Warnings.Count lint warning(s).</text>
												}
											</div>
											@if (verification.Diagnostics.Count > 0)
											{
												<ul class="rt-list warn">@foreach (var diagnostic in verification.Diagnostics.Take(8)) { <li>@diagnostic.Format()</li> }</ul>
											}
											@if (verification.Examples.Any(example => example.Passed == false))
											{
												<ul class="rt-list warn">@foreach (var example in verification.Examples.Where(example => example.Passed == false)) { <li>@example.Description — @example.Note</li> }</ul>
											}
										}
										else
										{
											<p class="rt-reco">There is no compiler for this arm's answer: correctness can only be judged by reading it.</p>
										}
									}
									else if (arm?.Status == "failed")
									{
										<div class="compare-status failed" role="alert">@(arm.Error ?? "This arm did not answer.")</div>
									}
									else if (LanguageBusy)
									{
										<div class="rt-pending"><span></span>Gemma 4 is implementing the ticket…</div>
									}
									else
									{
										<div class="rt-placeholder">This arm's answer will appear here.</div>
									}
								</section>
							}

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">6</span><div><strong>Independent review</strong><small>@(test.Verdict?.JudgeModel ?? "Claude Opus 5.0") · sealed criteria, graded per arm</small></div></header>
								@if (test.Verdict is { } grade)
								{
									<div class="clara-signature">
										C# arm <strong>@grade.CSharpMet / @grade.CriteriaTotal</strong> criteria met ·
										CLARA arm <strong>@grade.ClaraMet / @grade.CriteriaTotal</strong> ·
										winner <strong>@(grade.Winner switch { "clara" => "CLARA", "csharp" => "C#", _ => "tie" })</strong>
									</div>
									<p class="rt-reco">@grade.Rationale</p>
									<table class="audit-table">
										<thead><tr><th>Criterion</th><th>Arm</th><th>Met</th><th>Evidence</th></tr></thead>
										<tbody>
											@foreach (var score in grade.Scores)
											{
												<tr>
													<td>@score.Criterion</td>
													<td>@(score.Arm == "clara" ? "CLARA" : "C#")</td>
													<td>@(score.Met ? "yes" : "no")</td>
													<td>@score.Evidence</td>
												</tr>
											}
										</tbody>
									</table>
									@if (grade.LocalKnowledgeMissed.Count > 0)
									{
										<h4>Local knowledge an arm could not have known</h4>
										<ul class="rt-list warn">@foreach (var item in grade.LocalKnowledgeMissed) { <li>@item</li> }</ul>
									}
									@if (test.SealedCriteria.Count > 0)
									{
										<h4>The sealed criteria (revealed after grading)</h4>
										<ol class="rt-list">@foreach (var item in test.SealedCriteria) { <li>@item</li> }</ol>
									}
									<h4>Read this carefully</h4>
									<ul class="rt-list warn">
										<li>This is a single ticket on a single policy: n=1. It is a demonstration of the method, not evidence for the language.</li>
										<li>The judge can see which arm is CLARA, so it is not blind to language identity. Only the criteria are sealed.</li>
										<li>The CLARA arm's prompt includes a language primer the C# arm does not need, and that cost is counted in its prompt tokens.</li>
										@foreach (var caveat in grade.Caveats) { <li>@caveat</li> }
									</ul>
								}
								else if (test.Status == "judging")
								{
									<div class="rt-pending"><span></span>Claude Opus 5.0 is grading both answers against the sealed criteria…</div>
								}
								else if (test.Status == "failed")
								{
									<div class="compare-status failed" role="alert">@(test.Error ?? "The comparison did not complete.")</div>
								}
								else
								{
									<div class="rt-placeholder">The graded comparison will appear here once both arms have answered.</div>
								}
							</section>
						}
					</section>
					break;
				case 15:
					<section>
						<p class="kicker">GROUNDING, GRADED BY A COMPILER</p>
						<h2 id="scene-title">Three migrations of one COBOL program</h2>
						<p class="rt-intro">The same legacy program is migrated three times by the same model, with increasing grounding: <strong>none</strong>, then <strong>static-analysis artifacts</strong>, then <strong>facts the COBOL compiler itself resolved</strong>. Every answer is compiled and executed against outputs captured from the real legacy program. <strong>No model grades anything here</strong> — correctness is arithmetic.</p>

						@if (_session?.Migration is { } migration)
						{
							<div class="@(migration.ToolchainAvailable ? "compare-status" : "compare-status failed")" role="status">@migration.ToolchainStatus</div>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>The legacy program</strong><small>REDEFINES overlay · implied decimals · COMP-3 · PERFORM THRU · 88-level range</small></div></header>
								<pre class="rt-code">@migration.CobolSource</pre>
							</section>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>The oracle</strong><small>the compiled COBOL, executed — this is the ground truth</small></div></header>
								@if (migration.Oracle.Count > 0)
								{
									<table class="audit-table">
										<thead><tr><th>Input record</th><th>Legacy output</th></tr></thead>
										<tbody>
											@foreach (var run in migration.Oracle)
											{
												<tr><td><code>@run.Input</code></td><td>@(string.IsNullOrEmpty(run.Error) ? run.Output : run.Error)</td></tr>
											}
										</tbody>
									</table>
								}
								else
								{
									<div class="rt-placeholder">The oracle runs when you start the migration.</div>
								}

								@if (migration.CompilerFields.Count > 0)
								{
									<h4>What the compiler resolved (given only to arm C)</h4>
									<table class="audit-table">
										<thead><tr><th>Field</th><th>Offset</th><th>Bytes</th><th>Type, digits, scale</th></tr></thead>
										<tbody>
											@foreach (var field in migration.CompilerFields)
											{
												<tr><td>@field.Name</td><td>@field.Offset</td><td>@field.Size</td><td>@field.Attribute</td></tr>
											}
										</tbody>
									</table>
								}
							</section>

							<section class="rt-box rt-input-box">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>Run the comparison</strong><small>@migration.Arms.Count of 3 arms complete</small></div></header>
								<div class="rt-actions">
									<small>Gemma 4 migrates the same program three times</small>
									<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || MigrationBusy || !migration.ToolchainAvailable)" @onclick="RunMigration">@MigrationButtonText</button>
								</div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
								}
							</section>

							@foreach (var arm in migration.Arms)
							{
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">@arm.Arm</span><div><strong>Arm @arm.Arm — @GroundingLabel(arm.Grounding)</strong><small>@(arm.ModelUsed ?? arm.RequestedModel) · @arm.PromptTokens.ToString("N0") prompt tokens</small></div></header>
									@if (arm.Cases.Count > 0)
									{
										<div class="@(arm.Passed == arm.Cases.Count ? "compare-status" : "compare-status failed")" role="status">
											@arm.Passed of @arm.Cases.Count cases match the legacy program.
										</div>
										<table class="audit-table">
											<thead><tr><th>Input</th><th>Legacy says</th><th>This arm says</th><th></th></tr></thead>
											<tbody>
												@foreach (var item in arm.Cases)
												{
													<tr>
														<td><code>@item.Input</code></td>
														<td>@item.Expected</td>
														<td>@item.Actual@(string.IsNullOrEmpty(item.Note) ? "" : $" ({item.Note})")</td>
														<td>@(item.Matched ? "match" : "MISMATCH")</td>
													</tr>
												}
											</tbody>
										</table>
									}
									else if (!string.IsNullOrEmpty(arm.Error))
									{
										<div class="compare-status failed" role="alert">@arm.Error</div>
										@if (arm.CompileErrors.Count > 0)
										{
											<ul class="rt-list warn">@foreach (var error in arm.CompileErrors) { <li>@error</li> }</ul>
										}
									}
									else if (arm.Status is "pending" or "running")
									{
										<div class="rt-pending"><span></span>Migrating…</div>
									}

									@if (!string.IsNullOrEmpty(arm.Code))
									{
										<pre class="rt-code">@arm.Code</pre>
									}
								</section>
							}

							@if (migration.Status == "completed" && migration.Arms.Count == 3)
							{
								<section class="rt-qa">
									<header class="rt-head"><span class="rt-step">✓</span><div><strong>Verdict</strong><small>decided by execution, not by a model</small></div></header>
									<table class="audit-table">
										<thead><tr><th>Arm</th><th>Grounding</th><th>Cases passed</th><th>Prompt tokens</th></tr></thead>
										<tbody>
											@foreach (var arm in migration.Arms)
											{
												<tr><td>@arm.Arm</td><td>@GroundingLabel(arm.Grounding)</td><td>@arm.Passed / @arm.Cases.Count</td><td>@arm.PromptTokens.ToString("N0")</td></tr>
											}
										</tbody>
									</table>
									<h4>Read this carefully</h4>
									<ul class="rt-list warn">
										<li>One program, one run per arm. This demonstrates a method; it does not measure a migration programme.</li>
										<li>The case set covers the branches we thought of. A boundary we did not think of is not covered.</li>
										<li>The target is C# rather than Java because the server can execute C# deterministically. The grounding question is the same either way.</li>
										<li>Arm C's advantage, if any, comes from facts the compiler resolved — not from the compiler's C being easier to read. It is not.</li>
									</ul>
								</section>
							}
						}
					</section>
					break;
			}
		</article>

		<footer class="stage-footer">
			<button class="secondary-command" type="button" disabled="@(_scene == 0)" @onclick="Previous">← Previous</button>
			<div class="narration-text"><span>Narration transcript</span><p>@CurrentNarration</p></div>
			<button class="secondary-command" type="button" disabled="@(_scene == Scenes.Length - 1)" @onclick="Next">Next →</button>
		</footer>
	</section>

	<aside class="connection-drawer" aria-hidden="@(!_drawerOpen)">
		<button class="drawer-toggle" type="button" title="Hide the local bridge panel" aria-label="Hide the local bridge panel" aria-expanded="true" aria-controls="bridge-drawer" @onclick="ToggleDrawer">Hide &rsaquo;</button>
		<p class="eyebrow">LOCAL BRIDGE</p><h2>Connect VS Code</h2><p>Run <strong>POC Training: Connect</strong> in VS Code and paste this session token.</p>
		<code>@_session?.BridgeToken</code><button type="button" @onclick="CopyToken">Copy token</button>
		<dl><dt>Server</dt><dd>127.0.0.1:5000</dd><dt>Coach</dt><dd>Gemma 4</dd><dt>Review</dt><dd>Claude Opus 5</dd></dl>
	</aside>

	@if (!_drawerOpen)
	{
		<button class="drawer-reopen" type="button" title="Show the local bridge panel" aria-label="Show the local bridge panel" aria-expanded="false" aria-controls="bridge-drawer" @onclick="ToggleDrawer">
			<span class="status-dot @(_bridgeConnected ? "online" : null)"></span>&lsaquo; Local bridge
		</button>
	}
</div>

@code {
	private static readonly (string Id, string Title)[] Scenes = [("welcome", "The investigation"), ("why-okf", "Why OKF"), ("artifact-tree", "Artifact structure"), ("jira-trace", "JIRA to code"), ("animation-demo", "Animation demo"), ("image-demo", "Image demo"), ("knowledge-check", "Knowledge check"), ("prompt-challenge", "Prompt challenge"), ("model-comparison", "Model comparison"), ("round-trip", "Round-trip grounding"), ("modernize", "Modernize legacy"), ("audit-code", "Audit Repo (code)"), ("audit-context", "Audit Repo (context)"), ("llm-language", "LLM Language POC"), ("language-test", "POC Language test"), ("cobol-migration", "COBOL migration")];
	private static readonly (string Title, string Path, string Finding, string Result)[] TraceSteps =
	[
		("Open the index", "okf/index.md", "The delivery-estimate concept is the governed entry point.", "Do not search the whole repository yet."),
		("Resolve the concept", "okf/concepts/delivery-estimate.md", "Delivery estimate is distinct from order-status formatting.", "Exclude superficial UI matches."),
		("Check the boundary", "okf/architecture/service-boundaries.md", "Fulfillment owns customer-facing estimates; Shipping supplies events.", "Identify the owning service before code."),
		("Read the decision", "okf/decisions/adr-024-delay-source.md", "Only confirmed carrier-delay events may revise an estimate.", "Translate policy into a code constraint."),
		("Follow the code map", "okf/code-map/fulfillment-components.md", "DeliveryEstimateService.cs is primary; the handler is a caller.", "Locate implementation and contract impact."),
		("Inspect verification", "src/Fulfillment.Application/DeliveryEstimateServiceTests.cs", "Tests expose delayed and unchanged paths.", "Plan proof before proposing a change.")
	];
	private static readonly QuizQuestion[] Questions =
	[
		new("Why begin with the OKF index?", ["It contains all source code", "It routes to governed concepts and authoritative artifacts", "It approves the change", "It replaces code inspection"], 1, "The index routes the investigation. Current code still verifies the artifact."),
		new("What most strongly excludes a similarly named UI component?", ["The project name", "A keyword count", "The documented service boundary", "The JIRA label"], 2, "A verified ownership boundary is stronger evidence than naming proximity."),
		new("OKF identifies the owner but not the new API field name. What next?", ["Invent a conventional name", "Ignore the criterion", "Ask the authoritative owner and mark it unresolved", "Edit every response model"], 2, "Good grounding reveals missing knowledge instead of hiding it behind a plausible guess.")
	];
	private static readonly string[] BuiltInNarration =
	[
		"A JIRA story names the desired outcome, but not always the system boundary or implementation path. This lesson follows governed evidence before code.",
		"Search can find matching words. OKF adds concepts, ownership, decisions, and links that make those matches meaningful and reviewable.",
		"The index is the entry point. Small linked artifacts disclose only the context needed for this task, while retaining provenance and freshness.",
		"This is an illustration, not hidden model reasoning. Each step shows an observable source and the conclusion it supports.",
		"Motion can make sequence and causality easier to inspect. Here it shows the investigation narrowing from a broad story to one evidence-backed code path.",
		"This reviewed bitmap summarizes the same flow. The semantic lesson content remains authoritative because images alone are not searchable, localizable, or sufficient for accessibility.",
		"Choose the evidence that should control the investigation. These checks practice the mental model; they are not a workplace competency grade.",
		"Write a prompt that controls the investigation and requires evidence. Claude will return coaching commentary against the rubric, not a grade.",
		"Ask three models the same Google Cloud question, then let an impartial judge model blind-score the anonymized answers against a reference checklist. This is an illustrative harness, not a validated benchmark.",
		"Grounding round trip: Gemma turns a class into a JIRA story, then rebuilds the class from only that story. Claude then reviews how much behavior survived the round trip.",
		"Legacy comprehension is a recurring token tax. Spend the tokens once: modernize the code, expose the business rules, and make the seams for future microservices visible.",
		"Audit at scale with deterministic tooling first: Roslyn rates the C# code reproducibly, then Gemma grounds its recommendations on that rating. The numbers come from static analysis; the model supplies the judgment.",
		"Context audit funnel: a deterministic scan plus an ML.NET classifier decide cheaply whether a repo has usable context. If it passes, Gemma hunts planted traps using the context, and Claude grades how many it caught.",
		"What if the core business logic lived in a language built for models? CLARA is a deterministic, auditable rule language: the model writes it from a requirement, it compiles and runs, and a second model reviews it — logic a human and an LLM read the same way.",
		"The same ticket, the same model, no context either way. One arm sees an ordinary C# class where the local policy knowledge lives only in people's heads; the other sees a CLARA policy that carries that knowledge inline. Claude then grades both against sealed criteria neither arm ever saw.",
		"Three migrations of the same COBOL program, with increasing amounts of grounding — none, static analysis, and facts resolved by the COBOL compiler itself. Every answer is compiled and executed against outputs captured from the real legacy program. Nothing here is graded by a model."
	];

	private TrainingSession? _session;
	private readonly Dictionary<int, int> _answers = [];
	private readonly CancellationTokenSource _pollCancellation = new();
	private PeriodicTimer? _timer;
	private int _scene;
	private int _traceStep;
	private int _animationRun;
	private bool _started;
	private bool _bridgeConnected;
	private string _learnerPrompt = string.Empty;
	private string _comparisonTopicId = string.Empty;
	private string _roundTripClass = RoundTripSamples.LateFeeCalculator;
	private string _legacyCode = RoundTripSamples.LegacyOrder;
	private string _auditCode = RoundTripSamples.AuditProject;
	private string _contextCode = RoundTripSamples.ContextBundle;
	private string _claraJira = RoundTripSamples.ClaraJira;
	private string _languageJira = LanguageTestSamples.Jira;
	private ClaraBenchmarkResult? _benchmark;
	private ClaraConformanceReport? _conformance;
	private bool _benchmarkRunning;
	private bool _drawerOpen = true;

	private string CurrentNarration => _session?.Coach?.Scenes.FirstOrDefault(scene => scene.SceneId == Scenes[_scene].Id)?.Narration ?? BuiltInNarration[_scene];
	private string ReviewButtonText => !_bridgeConnected ? "Connect VSIX to request Claude" : _session?.ReviewStatus is "queued" or "running" ? "Claude is reviewing…" : "Request Claude feedback";
	private string ReviewTraceState => _session?.ReviewStatus switch { "queued" => "WAITING", "running" => "LIVE", "failed" => "FAILED", _ => "TRACE" };
	private string ReviewTraceMessage => _session?.ReviewStatus switch
	{
		"queued" => "Waiting for the VSIX to claim the Claude review task…",
		"running" => "Claude is responding; waiting for the first evidence-backed decision…",
		"failed" => "The review did not complete. Check the message above, confirm a language model is available in VS Code, and request feedback again.",
		_ => "Submit a prompt to see how Claude applies each rubric area."
	};

	private ComparisonTopic? SelectedTopic => string.IsNullOrEmpty(_comparisonTopicId) ? null : ComparisonCatalog.Find(_comparisonTopicId);
	private bool ComparisonBusy => _session?.Comparison.Status is "queued" or "running" or "judging";
	private string CompareButtonText => !_bridgeConnected
		? "Connect VSIX to compare"
		: ComparisonBusy ? "Comparing…" : "Run comparison";
	private string? WinningSlot => _session?.Comparison.Verdict?.Ranking.FirstOrDefault();
	private ComparisonDimensionScore? ScoreFor(string slot) => _session?.Comparison.Verdict?.Scores.FirstOrDefault(score => score.Slot == slot);
	private string ModelForSlot(string slot) => _session?.Comparison.Answers.FirstOrDefault(answer => answer.Slot == slot) is { } match ? (match.ModelUsed ?? match.RequestedModel) : slot;
	private bool JudgeSharesCandidateModel => _session?.Comparison.Verdict is { } verdict &&
		_session.Comparison.Answers.Any(answer => string.Equals(answer.ModelUsed, verdict.JudgeModel, StringComparison.OrdinalIgnoreCase));
	private bool DuplicateModels => _session?.Comparison.Answers
		.Where(answer => !string.IsNullOrEmpty(answer.ModelUsed))
		.GroupBy(answer => answer.ModelUsed, StringComparer.OrdinalIgnoreCase)
		.Any(group => group.Count() > 1) ?? false;

	private bool RoundTripBusy => _session?.RoundTrip.Status is "queued" or "story" or "recreating" or "qa";
	private string RoundTripButtonText => !_bridgeConnected
		? "Connect VSIX to run"
		: RoundTripBusy ? "Running round-trip…" : "Run round-trip";

