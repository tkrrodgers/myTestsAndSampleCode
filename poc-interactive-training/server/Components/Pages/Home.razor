@page "/"
@implements IAsyncDisposable
@inject TrainingSessionStore Store
@inject ClaraBenchmark Benchmark
@inject AgentRegistryService Registry
@inject DataTierClassifier DataTier
@inject ActionAuthorityService Authority
@inject RegressionAdequacyService Regression
@inject PortfolioContextService Portfolio
@inject CommonCodeAuditService CommonCode
@inject TokenEconomicsService Economics
@inject PatternLibraryService Library
@inject IJSRuntime JS

<PageTitle>OKF Context Navigator</PageTitle>

<div class="app-shell @(_drawerOpen ? null : "drawer-closed")">
	<aside class="rail" aria-label="Lesson navigation">
		<div class="brand-mark" aria-hidden="true">OKF</div>
		<div>
			<p class="eyebrow">CES AI PRACTICE LAB</p>
			<h1>Context<br />Navigator</h1>
		</div>
		<ol class="scene-list">
			@for (var index = 0; index < Scenes.Length; index++)
			{
				var sceneIndex = index;
				<li class="@(sceneIndex == _scene ? "active" : null)">
					<button type="button" @onclick="() => GoTo(sceneIndex)">
						<span>@(sceneIndex + 1)</span>@Scenes[sceneIndex].Title
					</button>
				</li>
			}
		</ol>
		<div class="bridge-state" aria-live="polite">
			<span class="status-dot @(_bridgeConnected ? "online" : null)"></span>
			<div>
				<strong>@(_bridgeConnected ? "VSIX connected" : "Waiting for VSIX")</strong>
				<small>@(_session?.CoachStatus ?? "not started")</small>
			</div>
		</div>
	</aside>

	<section class="stage">
		<header class="stage-header">
			<div><p class="eyebrow">SCENE @(_scene + 1) / @Scenes.Length</p><strong>@Scenes[_scene].Title</strong></div>
			<div class="header-actions">
				<button class="icon-button" type="button" title="Play narration" aria-label="Play narration" @onclick="Speak">?</button>
				<button class="icon-button" type="button" title="Stop narration" aria-label="Stop narration" @onclick="StopSpeaking">¦</button>
			</div>
		</header>

		@if (_session is not null && _session.CoachFallbackUsed)
		{
			<div class="model-banner warning" role="status">Gemma was unavailable. Narration text was authored by <strong>@_session.CoachModel</strong>; browser speech remains the audio provider.</div>
		}
		else if (_session?.CoachStatus == "completed")
		{
			<div class="model-banner" role="status">Grounded coach ready: <strong>@_session.CoachModel</strong></div>
		}
		@if (!string.IsNullOrWhiteSpace(_session?.LastError))
		{
			<div class="model-banner error" role="alert">@_session.LastError</div>
		}

		<article class="scene" aria-labelledby="scene-title">
			@switch (_scene)
			{
				case 0:
					<section class="opening-scene">
						<div class="opening-copy">
							<p class="kicker">GROUND BEFORE YOU GENERATE</p>
							<h2 id="scene-title">Find the right code.<br /><em>Know why it is right.</em></h2>
							<p class="lede">A guided investigation from a JIRA story, through an OKF knowledge graph, to one defensible implementation path.</p>
							@if (!_started)
							{
								<button class="primary-command" type="button" @onclick="StartLesson">Start the investigation <span>?</span></button>
							}
							else
							{
								<button class="primary-command" type="button" @onclick="Next">Continue <span>?</span></button>
							}
						</div>
						<div class="path-visual" aria-label="JIRA story connects through OKF to code and tests">
							<div class="path-node jira"><span>01</span><strong>JIRA</strong><small>FUL-1842</small></div>
							<div class="path-line"><i></i></div>
							<div class="path-node okf"><span>02</span><strong>OKF</strong><small>governed context</small></div>
							<div class="path-line"><i></i></div>
							<div class="path-node code"><span>03</span><strong>CODE</strong><small>one owned path</small></div>
						</div>
					</section>
					break;
				case 1:
					<section>
						<p class="kicker">SEARCH FINDS WORDS. CONTEXT FINDS MEANING.</p>
						<h2 id="scene-title">Why OKF changes the investigation</h2>
						<div class="comparison-grid">
							<div class="comparison bad">
								<div class="comparison-label">Ungrounded path</div>
								<ol><li>Copy the ticket into chat</li><li>Search every “estimate” match</li><li>Choose the first plausible class</li><li>Ship an unsupported assumption</li></ol>
								<p>No ownership boundary. No decision history. No evidence trail.</p>
							</div>
							<div class="comparison good">
								<div class="comparison-label">OKF-grounded path</div>
								<ol><li>Start from the governed index</li><li>Resolve the business concept</li><li>Follow boundaries and decisions</li><li>Verify the mapped code and tests</li></ol>
								<p>Every material conclusion points back to a reviewable source.</p>
							</div>
						</div>
					</section>
					break;
				case 2:
					<section>
						<p class="kicker">THE CONTEXT ARTIFACT</p>
						<h2 id="scene-title">A map the human and model can inspect</h2>
						<div class="artifact-layout">
							<div class="artifact-tree" role="img" aria-label="Training fixture tree with OKF, JIRA, and source code folders">
								<div class="tree-root">training-fixture/</div>
								<ul>
									<li class="file primer-file">README.md <span>LLM consumer guide</span></li>
									<li class="folder open">okf/<ul><li class="file active">index.md</li><li class="folder">concepts/ <span>delivery-estimate.md</span></li><li class="folder">architecture/ <span>service-boundaries.md</span></li><li class="folder">decisions/ <span>adr-024-delay-source.md</span></li><li class="folder">code-map/ <span>fulfillment-components.md</span></li></ul></li>
									<li class="folder">jira/ <span>FUL-1842.md</span></li>
									<li class="folder">src/ <span>Fulfillment.Application/</span></li>
								</ul>
							</div>
							<div class="artifact-note">
								<span class="note-number">01</span>
								<h3>What OKF means</h3>
								<p><strong>Open Knowledge Format</strong> is a model-neutral directory of small Markdown concepts with YAML metadata and links that form a navigable knowledge graph.</p>
								<ul class="okf-primer-list">
									<li>Read the consumer guide, then start at <code>okf/index.md</code>.</li>
									<li>Follow concept ? boundary/decision ? code map ? current code/tests.</li>
									<li>Check provenance, verification, lifecycle, and freshness.</li>
									<li>Cite paths and surface missing knowledge instead of guessing.</li>
								</ul>
								<p class="trust-note">Structure improves inspectability; it does not guarantee truth or train model weights.</p>
								<div class="source-chip">training-fixture/README.md ? okf/index.md</div>
							</div>
						</div>
					</section>
					break;
				case 3:
					<section>
						<p class="kicker">DOES THE CONTEXT ACTUALLY CARRY THE WORK?</p>
						<h2 id="scene-title">From FUL-1842 to a grounded change</h2>
						<p class="rt-intro">The claim behind every context artifact is that an agent given <em>only</em> the governed context can resolve the ticket correctly. Here it is tested: Gemma 4 gets the OKF bundle and the source, implements <strong>FUL-1842</strong>, and Claude then traces each change back to the <strong>specific document and sentence</strong> that justifies it — and checks whether the deliberately missing fact was flagged rather than invented.</p>

						<div class="trace-grid">
							@for (var index = 0; index < TraceSteps.Length; index++)
							{
								var stepIndex = index;
								<button type="button" class="trace-step @(stepIndex == _traceStep ? "active" : null)" @onclick="() => _traceStep = stepIndex"><span>@(stepIndex + 1)</span><div><strong>@TraceSteps[stepIndex].Title</strong><small>@TraceSteps[stepIndex].Path</small></div></button>
							}
						</div>
						<div class="trace-evidence" aria-live="polite"><p class="eyebrow">OBSERVABLE EVIDENCE</p><h3>@TraceSteps[_traceStep].Finding</h3><p>@TraceSteps[_traceStep].Result</p><code>@TraceSteps[_traceStep].Path</code></div>

						@if (_session?.GroundedChange is { } change)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>The context the agent is given</strong><small>the OKF bundle and the current source · nothing else is available to it</small></div></header>
								@foreach (var artifact in change.Context.Where(item => item.Kind != "jira"))
								{
									<details class="artifact-detail">
										<summary><code>@artifact.Path</code> <small>@artifact.Kind</small></summary>
										<pre class="rt-code">@artifact.Content</pre>
									</details>
								}
							</section>

							<section class="rt-box rt-input-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>The ticket</strong><small>FUL-1842 · it never names the API field for estimate source — that omission is deliberate</small></div></header>
								<textarea class="rt-code-input" spellcheck="false" maxlength="8000" @bind="_changeJira" @bind:event="oninput" disabled="@ChangeBusy" aria-label="JIRA ticket"></textarea>
								<div class="rt-actions">
									<small>@(change.PromptTokens > 0 ? $"{change.PromptTokens:N0} prompt tokens" : "context + ticket")</small>
									<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || ChangeBusy)" @onclick="RunGroundedChange">@ChangeButtonText</button>
								</div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
								}
							</section>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>The implemented change</strong><small>@(change.ImplementationModel ?? "Gemma 4") · working only from the artifacts above</small></div></header>
								@if (!string.IsNullOrEmpty(change.Implementation))
								{
									<pre class="rt-code">@change.Implementation</pre>
								}
								else if (change.Status == "implementing")
								{
									<div class="rt-pending"><span></span>Gemma 4 is implementing the ticket from the OKF bundle…</div>
								}
								else
								{
									<div class="rt-placeholder">The implementation will appear here.</div>
								}
							</section>

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">4</span><div><strong>Where did each change come from?</strong><small>@(change.Audit?.Model ?? "Claude Opus 5") · every decision traced to a quoted sentence</small></div></header>
								@if (change.Audit is { } audit)
								{
									<div class="@(audit.OpenQuestionRaised && audit.PlaceholdersMarked ? "compare-status" : "compare-status failed")" role="status">
										@(!audit.OpenQuestionRaised
											? "The missing API field name was NOT raised — the agent invented or ignored it."
											: audit.PlaceholdersMarked
												? "The missing API field name was raised, and the code left it genuinely unresolved."
												: "Raised as an open question — then hard-coded anyway. Naming a gap in prose is not the same as leaving it open in the code.")
									</div>
									@if (!string.IsNullOrEmpty(audit.OpenQuestionNote))
									{
										<p class="rt-reco">@audit.OpenQuestionNote</p>
									}
									@if (!string.IsNullOrEmpty(audit.PlaceholderNote))
									{
										<p class="rt-reco">@audit.PlaceholderNote</p>
									}
									<table class="audit-table">
										<thead><tr><th>Change</th><th>Justified by</th><th>The statement it rests on</th><th></th></tr></thead>
										<tbody>
											@foreach (var citation in audit.Citations)
											{
												<tr>
													<td>@citation.Change</td>
													<td><code>@citation.Document</code></td>
													<td>“@citation.Statement”</td>
													<td>@(citation.Grounded ? "grounded" : "UNSUPPORTED")</td>
												</tr>
											}
										</tbody>
									</table>
									@if (audit.Ungrounded.Count > 0)
									{
										<h4>Asserted without support in any artifact</h4>
										<ul class="rt-list warn">@foreach (var item in audit.Ungrounded) { <li>@item</li> }</ul>
									}
									<p class="rt-reco">@audit.Verdict</p>
									<h4>Read this carefully</h4>
									<ul class="rt-list warn">
										<li>This shows the context was <em>sufficient</em> for this ticket. It does not show it is sufficient for the next one.</li>
										<li>A quoted sentence proves the claim exists in the artifact. It does not prove the artifact is correct or current — check <code>verified</code> and <code>stale_after</code>.</li>
										<li>The audit is a model reading another model. The planted gap is the firmest signal, and it has two parts: the agent has to name what is missing <em>and</em> leave it unresolved in the code. An implementation that raises the question and then hard-codes an invented literal has reintroduced the failure the omission exists to catch.</li>
									</ul>
								}
								else if (change.Status == "auditing")
								{
									<div class="rt-pending"><span></span>Claude is tracing each change back to its source statement…</div>
								}
								else if (change.Status == "failed")
								{
									<div class="compare-status failed" role="alert">@(change.Error ?? "The demo did not complete.")</div>
								}
								else
								{
									<div class="rt-placeholder">The citation audit will appear here once the change is implemented.</div>
								}
							</section>
						}
					</section>
					break;
				case 4:
					<section>
						<p class="kicker">MOTION WITH A PURPOSE</p>
						<h2 id="scene-title">Watch context narrow the search</h2>
						<p class="animation-intro">The moving signal represents an observable investigation step, not hidden reasoning. Replay it to see the search space contract as evidence accumulates.</p>
						<div class="animation-demo" @key="_animationRun" role="img" aria-label="Animated context path from JIRA through OKF index, concept and decision to code">
							<div class="motion-track" aria-hidden="true"><i></i></div>
							<div class="motion-node jira"><span>1</span><strong>JIRA</strong><small>intent</small></div>
							<div class="motion-node index"><span>2</span><strong>INDEX</strong><small>entry</small></div>
							<div class="motion-node context"><span>3</span><strong>CONTEXT</strong><small>constraint</small></div>
							<div class="motion-node target"><span>4</span><strong>CODE</strong><small>owned path</small></div>
						</div>
						<ol class="animation-transcript">
							<li>Read the story intent.</li><li>Enter through the OKF index.</li><li>Apply concept, boundary, and ADR evidence.</li><li>Inspect the mapped code and tests.</li>
						</ol>
						<button class="secondary-command replay-command" type="button" @onclick="ReplayAnimation">? Replay animation</button>
					</section>
					break;
				case 5:
					<section>
						<p class="kicker">REVIEWED VISUAL ASSET</p>
						<h2 id="scene-title">The same flow as an image</h2>
						<div class="image-demo-layout">
							<figure class="image-demo">
								<img src="okf-artifact-structure.png" alt="Context navigation from JIRA story FUL-1842 through the OKF index and contextual decisions to DeliveryEstimateService code." />
								<figcaption>Bitmap demonstration: intent ? governed index ? decision context ? owned code.</figcaption>
							</figure>
							<aside class="image-provenance">
								<p class="eyebrow">ASSET RECORD</p>
								<dl><dt>Source</dt><dd>Rendered POC context map</dd><dt>Format</dt><dd>PNG · 1080×608</dd><dt>Data</dt><dd>Synthetic Public fixture</dd><dt>Review</dt><dd>Human-inspected for crop and readability</dd></dl>
								<p>The image supports the lesson, but structured HTML remains the accessible and localizable source of truth.</p>
							</aside>
						</div>
					</section>
					break;
				case 6:
					<section>
						<p class="kicker">CHECK THE MENTAL MODEL</p>
						<h2 id="scene-title">Three decisions before code</h2>
						<div class="quiz-list">
							@for (var questionIndex = 0; questionIndex < Questions.Length; questionIndex++)
							{
								var currentQuestion = questionIndex;
								var question = Questions[questionIndex];
								<div class="question-block" role="group" aria-labelledby="question-label-@questionIndex">
									<p class="question-prompt" id="question-label-@questionIndex"><span>@(questionIndex + 1)</span>@question.Prompt</p>
									<div class="question-options">
									@for (var optionIndex = 0; optionIndex < question.Options.Count; optionIndex++)
									{
										var currentOption = optionIndex;
										<label class="answer-option @AnswerClass(currentQuestion, currentOption)"><input type="radio" name="question-@questionIndex" checked="@(_answers.GetValueOrDefault(currentQuestion, -1) == currentOption)" @onchange="() => Answer(currentQuestion, currentOption)" /><span>@((char)('A' + optionIndex))</span>@question.Options[optionIndex]</label>
									}
									@if (_answers.ContainsKey(currentQuestion)) { <p class="answer-feedback">@question.Feedback</p> }
									</div>
								</div>
							}
						</div>
					</section>
					break;
				case 7:
					<section>
						<p class="kicker">YOU DRIVE THE INVESTIGATION</p>
						<h2 id="scene-title">Write the prompt Claude will review</h2>
						<div class="challenge-grid">
							<div>
								<p class="challenge-intro">Direct an AI to investigate FUL-1842. Require evidence, restraint, and a verification path — not an immediate code dump.</p>
								<div class="rubric-list"><span>Index first</span><span>Source paths</span><span>Concept + boundary</span><span>ADR constraint</span><span>Code + tests</span><span>Open questions</span></div>
								<label for="learner-prompt">Your investigation prompt</label>
								<textarea id="learner-prompt" maxlength="6000" @bind="_learnerPrompt" @bind:event="oninput" placeholder="Investigate FUL-1842 by starting with..."></textarea>
								<div class="prompt-actions"><small>@_learnerPrompt.Length / 6000</small><button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || _learnerPrompt.Trim().Length < 40 || _session?.ReviewStatus is "queued" or "running")" @onclick="SubmitReview">@ReviewButtonText</button></div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before requesting Claude.</p>
								}
							</div>
							<aside class="review-panel" id="review-feedback" tabindex="-1" aria-live="polite">
								<p class="eyebrow">INDEPENDENT REVIEW</p>
								@if (_session?.Review is null)
								{
									@if (_session?.ReviewStatus == "failed")
									{
										<div class="review-empty failed"><span>!</span><h3>Claude review didn't finish</h3><p>@(_session?.LastError ?? "The review task failed. Confirm a language model is signed in and available in VS Code, then request feedback again.")</p></div>
									}
									else
									{
										<div class="review-empty"><span>CL</span><h3>Feedback appears here</h3><p>Claude reviews the prompt against the visible rubric. It does not assign a validated grade.</p></div>
									}
								}
								else
								{
									<div class="coach-label">AI coaching commentary — not a validated grade.</div>
									<h3>@_session.Review.Summary</h3>
									<h4>Strengths</h4><ul>@foreach (var item in _session.Review.Strengths) { <li>@item</li> }</ul>
									<h4>Improve next</h4><ul>@foreach (var item in _session.Review.Improvements) { <li>@item</li> }</ul>
									@if (_session.Review.UnsupportedAssumptions.Count > 0) { <h4>Unsupported assumptions</h4><ul>@foreach (var item in _session.Review.UnsupportedAssumptions) { <li>@item</li> }</ul> }
									<details><summary>Suggested revision</summary><p>@_session.Review.SuggestedPrompt</p></details>
									<small>Reviewed by @_session.ReviewModel</small>
								}
								<section class="review-trace-window" aria-label="Claude decision trace">
									<div class="trace-window-heading">
										<div><p class="eyebrow">CLAUDE DECISION TRACE</p><h4>Evidence and review decisions</h4></div>
										<span class="live-indicator @(_session?.ReviewStatus == "running" ? "active" : _session?.ReviewStatus == "failed" ? "failed" : null)">@ReviewTraceState</span>
									</div>
									<p class="trace-disclosure">Observable rubric checks streamed by Claude. This is not private chain-of-thought and is not proof that the final feedback is correct.</p>
									@if (_session?.ReviewTrace.Count > 0)
									{
										<ol class="review-trace-list">
											@foreach (var traceEvent in _session.ReviewTrace)
											{
												<li>
													<span>@traceEvent.Sequence.ToString("00")</span>
													<div><strong>@traceEvent.Stage</strong><blockquote>@traceEvent.Evidence</blockquote><p>@traceEvent.Decision</p></div>
												</li>
											}
										</ol>
									}
									else
									{
										<div class="trace-awaiting"><span></span><p>@ReviewTraceMessage</p></div>
									}
								</section>
							</aside>
						</div>
					</section>
					break;
				case 8:
					<section>
						<p class="kicker">CAPABILITY COMPARISON</p>
						<h2 id="scene-title">Ask three models the same question</h2>
						<p class="compare-intro">This measures <strong>what the three models already know about Google Cloud</strong>. They are asked the question and given nothing else — no documentation, no hints, no retrieval. Then the official Google Cloud documentation is <strong>fetched over the network</strong> and handed to <strong>Claude Opus 4.8</strong>, which scores the anonymised answers against that retrieved text and must quote it to justify every factuality judgement.</p>

						<div class="know-grid">
							<div class="know-col unverified"><p class="eyebrow">1 · CLOSED BOOK</p><ul><li>Three models, same question, no context. Each answers from its own training alone, in its own column.</li></ul></div>
							<div class="know-col own"><p class="eyebrow">2 · RETRIEVE</p><ul><li>The server fetches the real documentation pages listed below and converts them to text. Retrieval status is shown, so a dead link is visible rather than silent.</li></ul></div>
							<div class="know-col learned"><p class="eyebrow">3 · GROUNDED JUDGE</p><ul><li>Claude Opus 4.8 sees the answers blinded as A / B / C and the retrieved text. It scores against that text only, and separates "contradicted" from "not covered".</li></ul></div>
						</div>

						<div class="compare-controls">
							<select class="compare-select" @bind="_comparisonTopicId" disabled="@ComparisonBusy">
								<option value="">Choose a topic…</option>
								@foreach (var topic in ComparisonCatalog.Topics)
								{
									<option value="@topic.Id">@topic.Title</option>
								}
							</select>
							<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || string.IsNullOrEmpty(_comparisonTopicId) || ComparisonBusy)" @onclick="RunComparison">@CompareButtonText</button>
						</div>
						@if (!_bridgeConnected)
						{
							<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running a comparison.</p>
						}
						@if (SelectedTopic is not null)
						{
							<div class="compare-question">
								<p class="eyebrow">QUESTION PUT TO ALL THREE MODELS — AND NOTHING ELSE</p>
								<p>@SelectedTopic.Question</p>
								<p class="eyebrow">AUTHORITATIVE DOCUMENTATION USED TO JUDGE THEM</p>
								<div class="compare-refs">@foreach (var url in SelectedTopic.ReferenceUrls) { <span><a href="@url" target="_blank" rel="noopener noreferrer">@url</a></span> }</div>
								<p class="ctx-method">The candidate models never see these pages. They are retrieved only after all three answers are in, and only the judge reads them.</p>
							</div>
						}

						@if (_session?.Comparison.Answers.Count > 0)
						{
							<div class="compare-columns">
								@foreach (var answer in _session.Comparison.Answers)
								{
									<article class="compare-col @(WinningSlot == answer.Slot ? "winner" : null)">
										<header class="compare-col-head">
											<span class="slot-badge">Answer @answer.Slot</span>
											<strong>@(answer.ModelUsed ?? answer.RequestedModel)</strong>
											<small>requested: @answer.RequestedModel@(answer.FallbackUsed ? " · substitute" : string.Empty)</small>
										</header>
										@switch (answer.Status)
										{
											case "completed":
												<div class="answer-body">@answer.Content</div>
												<div class="answer-metrics">
													<span class="coverage">Keyword coverage @answer.KeywordCoverage%</span>
													@if (ScoreFor(answer.Slot) is { } score)
													{
														<div class="dim-row"><span>Factuality</span><b>@score.Factuality/5</b></div>
														<div class="dim-row"><span>Completeness</span><b>@score.Completeness/5</b></div>
														<div class="dim-row"><span>Conciseness</span><b>@score.Conciseness/5</b></div>
														@if (!string.IsNullOrWhiteSpace(score.Notes)) { <p class="dim-notes">@score.Notes</p> }
													}
												</div>
												break;
											case "failed":
												<div class="answer-failed">
													<strong>No answer from @(answer.ModelUsed ?? answer.RequestedModel).</strong>
													<span>@(answer.Error ?? "The model returned no content and gave no reason.")</span>
													@if (answer.ErrorCode is { Length: > 0 } failureCode)
													{
														<code>@failureCode</code>
													}
													<span class="answer-failed-hint">Check the <em>POC Interactive Training</em> output channel in VS Code for the full client-side error.</span>
												</div>
												break;
											default:
												<div class="answer-pending"><span></span>Waiting for @answer.RequestedModel…</div>
												break;
										}
									</article>
								}
							</div>
						}

						@if (_session?.Comparison.Answers.Count > 0 && _session.Comparison.Answers.Any(answer => answer.Status == "failed") && !ComparisonBusy)
						{
							<div class="compare-status failed" role="status">
								<strong>This comparison is incomplete.</strong>
								@(_session.Comparison.Answers.Count(answer => answer.Status == "completed")) of @_session.Comparison.Answers.Count models answered, so the ranking below covers only those. A model that fails to answer has not been shown to be worse than one that did — most often the model is simply not available or not signed in for this VS Code session. Treat the missing column as no data, not as a result.
							</div>
						}

						@if (_session?.Comparison.Status == "judging")
						{
							<div class="compare-status working" role="status" aria-live="polite"><span class="working-spinner" aria-hidden="true"></span><span>Answers collected. Claude Opus 4.8 is scoring A / B / C against the retrieved documentation<span class="working-dots"><i>.</i><i>.</i><i>.</i></span>@JudgeElapsed</span></div>
						}
						else if (_session?.Comparison.Status == "grounding")
						{
							<div class="compare-status working" role="status" aria-live="polite"><span class="working-spinner" aria-hidden="true"></span><span>Answers collected. Retrieving the official Google Cloud documentation to judge against<span class="working-dots"><i>.</i><i>.</i><i>.</i></span>@JudgeElapsed</span></div>
						}
						else if (_session?.Comparison.Status == "failed")
						{
							<div class="compare-status failed" role="alert">@(_session?.Comparison.Error ?? "The comparison did not complete.")</div>
						}

						@if (_session?.Comparison.Sources.Count > 0)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">D</span><div><strong>Documentation actually retrieved</strong><small>@_session.Comparison.Sources.Count(source => source.Retrieved) of @_session.Comparison.Sources.Count fetched · @_session.Comparison.GroundingTokens.ToString("N0") tokens in the judge prompt</small></div></header>
								<table class="audit-table">
									<thead><tr><th>Status</th><th>Page</th><th>Characters used</th><th>Retrieved at</th></tr></thead>
									<tbody>
										@foreach (var source in _session.Comparison.Sources)
										{
											<tr class="@(source.Retrieved ? "p0-opt" : "p0-req")">
												<td>@(source.Retrieved ? (source.FromCache ? "cached" : "fetched") : "FAILED")</td>
												<td><a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Title</a><br /><code>@source.Url</code></td>
												<td>@(source.Retrieved ? source.Characters.ToString("N0") + (source.Truncated ? " (truncated)" : "") : "—")</td>
												<td>@(source.Retrieved ? source.AttemptedAt.ToLocalTime().ToString("HH:mm:ss") : source.Error)</td>
											</tr>
										}
									</tbody>
								</table>
								<p class="ctx-method">This is the text the judge read. Nothing else was supplied to it about Google Cloud, and the three candidate models never saw any of it.</p>
							</section>
						}

						@if (_session?.Comparison.Verdict is { } verdict)
						{
							<aside class="compare-verdict">
								<p class="eyebrow">GROUNDED JUDGE VERDICT</p>
								<div class="coach-label">Scored by @verdict.JudgeModel against documentation retrieved at judging time — blinded and rubric-based, still not a validated benchmark.</div>
								@if (verdict.Ranking.Count > 0)
								{
									<ol class="verdict-ranking">
										@foreach (var slot in verdict.Ranking)
										{
											<li><span class="slot-badge">@slot</span> @ModelForSlot(slot)</li>
										}
									</ol>
								}
								<p class="verdict-rationale">@verdict.Rationale</p>

								@foreach (var score in verdict.Scores.Where(item => item.Evidence.Count > 0 || item.Unsupported.Count > 0))
								{
									<h4>Answer @score.Slot — @ModelForSlot(score.Slot)</h4>
									@if (score.Evidence.Count > 0)
									{
										<p class="eyebrow">DOCUMENTATION QUOTED IN SUPPORT</p>
										<ul class="rt-list good">@foreach (var quote in score.Evidence) { <li>@quote</li> }</ul>
									}
									@if (score.Unsupported.Count > 0)
									{
										<p class="eyebrow">NOT COVERED BY THE RETRIEVED DOCS — NEITHER CONFIRMED NOR REFUTED</p>
										<ul class="rt-list warn">@foreach (var claim in score.Unsupported) { <li>@claim</li> }</ul>
									}
								}

								@if (!string.IsNullOrWhiteSpace(verdict.CoverageNote))
								{
									<h4>Limits of this evidence</h4>
									<p class="verdict-caveat">@verdict.CoverageNote</p>
								}
								<dl class="verdict-meta"><dt>Judge</dt><dd>@verdict.JudgeModel</dd></dl>
								@if (JudgeSharesCandidateModel)
								{
									<p class="verdict-caveat">Caveat: the judge resolved to the same underlying model as a candidate in this environment. Independence is reduced — treat the ranking with extra caution.</p>
								}
								@if (DuplicateModels)
								{
									<p class="verdict-caveat">Note: two or more columns resolved to the same underlying model. Sign in to additional model families in VS Code for a meaningful comparison.</p>
								}
								<p class="verdict-caveat">Keyword coverage beside each answer is a separate deterministic measure. It counts vocabulary, not correctness — a wrong answer using the right words still scores well on it, which is why the judge's grounded factuality score sits alongside it rather than being replaced by it.</p>
							</aside>
						}
					</section>
					break;
				case 9:
					<section>
						<p class="kicker">ONE MODEL GROUNDS ANOTHER</p>
						<h2 id="scene-title">Using a specialist model as a source, not an oracle</h2>
						<p class="rt-intro">Claude's knowledge of Google Cloud has a boundary; a Google-specialist model may sit past it. The legitimate pattern is to treat the specialist as a <strong>retrieval and gap-finding instrument</strong> — harvest its services, constraints and citations — then have the designer state plainly what it already knew, what it just learned, and what it refuses to trust until the primary docs are checked. Model output is a claim with provenance, never a baseline of truth.</p>

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>Design requirement — migrate to GCP</strong><small>editable</small></div></header>
