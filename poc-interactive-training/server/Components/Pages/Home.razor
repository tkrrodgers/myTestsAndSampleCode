	private void StartRoom() { _roomStartedAt = DateTimeOffset.UtcNow; _ = Room.StartAsync(CancellationToken.None); }

	private async Task StopRoom()
	{
		if (_roomRecording) { await JS.InvokeVoidAsync("roomMic.cancel"); _roomRecording = false; }
		await JS.InvokeVoidAsync("roomSpeech.stop");
		Room.Stop();
	}

	private async Task ClearRoom()
	{
		await JS.InvokeVoidAsync("roomSpeech.stop");
		_roomSpokenTurnId = 0;
		_roomSpokenChars = 0;
		_roomOwnedAnswerId = 0;
		Room.ClearConversation();
	}

	private async Task ToggleRoomMic()
	{
		_roomMicError = null;
		if (!_roomRecording)
		{
			try
			{
				await JS.InvokeVoidAsync("roomSpeech.stop");
				await JS.InvokeAsync<double>("roomMic.start");
				_roomRecording = true;
				_roomRecordingStartedAt = DateTimeOffset.UtcNow;
				_roomMicSupported = true;
			}
			catch (JSException ex)
			{
				_roomMicSupported = false;
				_roomMicError = "Microphone unavailable: " + ex.Message;
			}

			return;
		}

		_roomRecording = false;
		_roomTranscribing = true;
		try
		{
			var result = await JS.InvokeAsync<RoomMicResult>("roomMic.stop");
			if (result.Error is not null)
			{
				_roomMicError = result.Error;
			}
			else if (string.IsNullOrWhiteSpace(result.Text))
			{
				_roomMicError = result.Seconds < 0.5 ? "That was too short to hear. Hold the button while you ask." : "Nothing was heard. Check the microphone and try again.";
			}
			else
			{
				_roomOwnedAnswerId = Room.Ask(_roomSpeaker, result.Text, result.SttMs);
			}
		}
		catch (JSException ex)
		{
			_roomMicError = "Transcription failed: " + ex.Message;
		}
		finally
		{
			_roomTranscribing = false;
		}
	}

	private async Task SendRoomTyped()
	{
		var text = _roomTyped.Trim();
		if (text.Length == 0) return;
		_roomTyped = string.Empty;
		await JS.InvokeVoidAsync("roomSpeech.stop");
		_roomOwnedAnswerId = Room.Ask(_roomSpeaker, text, 0);
	}

	// Streams the model's text to the screen and hands each finished sentence to the speaker queue once.
	// Renders are coalesced (tokens arrive ~20/s) and only the tab that asked the question speaks the
	// answer: speechSynthesis is one queue per browser, so every open tab speaking means every sentence twice.
	private void OnRoomChanged()
	{
		if (_roomRenderPending) return;
		_roomRenderPending = true;
		_ = InvokeAsync(async () =>
		{
			await Task.Delay(120);
			_roomRenderPending = false;
			if (_scene != SceneIndex("llm-in-the-room")) return;
			StateHasChanged();
			try { await JS.InvokeVoidAsync("trainingSpeech.stickToBottom", "room-transcript"); } catch (JSException) { }
			if (!_roomSpeakAloud || _roomOwnedAnswerId == 0) return;
			var turn = Room.Snapshot().Turns.FirstOrDefault(t => t.Id == _roomOwnedAnswerId);
			if (turn is null || turn.Status == "failed") return;
			if (turn.Id != _roomSpokenTurnId) { _roomSpokenTurnId = turn.Id; _roomSpokenChars = 0; }

			var text = turn.Text;
			var end = turn.Status == "completed" ? text.Length : LastSentenceEnd(text);
			if (end <= _roomSpokenChars) return;
			var sentence = text[_roomSpokenChars..end].Trim().Replace("`", "").Replace("*", "").Replace("_", " ");
			_roomSpokenChars = end;
			if (sentence.Length > 0)
			{
				try { await JS.InvokeVoidAsync("roomSpeech.enqueue", sentence); } catch (JSException) { }
			}
		});
	}

	private static int LastSentenceEnd(string text)
	{
		for (var i = text.Length - 1; i > 0; i--)
		{
			if (text[i] is '.' or '?' or '!' && (i == text.Length - 1 || char.IsWhiteSpace(text[i + 1])) && i >= 20)
			{
				return i + 1;
			}
		}

		return 0;
	}

	private static string Trunc(string text, int max) => string.IsNullOrEmpty(text) ? "" : text.Length <= max ? text : text[..max] + "…";

