	private sealed record RoomMicResult(string Text, int SttMs, double Seconds, string? Error);

	private string RoomElapsed => _roomStartedAt is { } started ? $"{(int)(DateTimeOffset.UtcNow - started).TotalSeconds}s" : "0s";
