								<button class="primary-command compact" type="button" disabled="@_commonCodeRunning" @onclick="RunCommonCode">@(_commonCodeRunning ? "Embedding…" : "Run the audit")</button>
							</div>
						</section>

						@if (_commonCode is { } codeAudit)
						{
							@if (!codeAudit.CorpusAvailable)
							{
								<div class="rt-error" role="alert">@codeAudit.CorpusStatus</div>
							}
							else
							{
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">2</span><div><strong>Did it actually separate them?</strong><small>scored against the source tree, not asserted</small></div></header>
									<div class="audit-body">
										<div class="know-grid">
											<div class="know-col learned"><p class="eyebrow">KNOWN DUPLICATES</p><ul><li>mean @codeAudit.Separation.DuplicateMean.ToString("0.000"), weakest @codeAudit.Separation.DuplicateMin.ToString("0.000")</li></ul></div>
											<div class="know-col unverified"><p class="eyebrow">EVERYTHING ELSE</p><ul><li>mean @codeAudit.Separation.UnrelatedMean.ToString("0.000"), strongest @codeAudit.Separation.UnrelatedMax.ToString("0.000")</li></ul></div>
											<div class="know-col own"><p class="eyebrow">MARGIN</p><ul><li>@codeAudit.Separation.Margin.ToString("0.000") — @codeAudit.Separation.NearestNeighbourHits/@codeAudit.Separation.NearestNeighbourTotal framework files whose nearest cross-repo neighbour is the same class</li></ul></div>
										</div>
										<p class="ctx-method">@codeAudit.CorpusStatus Method: @(codeAudit.UsedEmbeddings ? "embeddinggemma-300m int8, windowed mean-pooling over whole files" : "token-overlap fallback") at cosine ≥ @codeAudit.Threshold.ToString("0.000"). @(codeAudit.Separation.Margin > 0 ? $"The two populations do not overlap, but the margin is only {codeAudit.Separation.Margin:0.000} wide — a single threshold works here and would not survive a noisier estate." : "The populations overlap: no single threshold separates them cleanly, so treat the clusters as candidates for review rather than findings.")</p>
									</div>
								</section>

								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">3</span><div><strong>The prize</strong><small>@codeAudit.DuplicatedClusters duplicated cluster(s) across @codeAudit.UnitCount files</small></div></header>
									<div class="audit-body">
										<div class="know-grid">
											<div class="know-col learned"><p class="eyebrow">NON-FUNCTIONAL DUPLICATION</p><ul><li>@codeAudit.NonFunctionalPrize lines — framework code with one correct answer. Start here.</li></ul></div>
											<div class="know-col unverified"><p class="eyebrow">FUNCTIONAL DUPLICATION</p><ul><li>@(codeAudit.FunctionalPrize == 0 ? "None found. The trading logic genuinely diverges by asset class — which is also evidence the audit is not simply clustering everything that looks like C#." : $"{codeAudit.FunctionalPrize} lines — business rules encoded more than once. Higher prize, higher risk.")</li></ul></div>
										</div>
										<table class="audit-table">
											<thead><tr><th>Kind</th><th>Members</th><th>Repos</th><th>Duplicate lines</th><th>Recommendation</th></tr></thead>
											<tbody>
												@foreach (var cluster in codeAudit.Clusters.Where(cluster => cluster.IsDuplication))
												{
													<tr class="p0-req">
														<td>@cluster.Kind</td>
														<td>@string.Join(", ", cluster.Members.Select(member => $"{member.Repo}/{member.Name}"))</td>
														<td>@cluster.Repos.Count</td>
														<td>@cluster.DuplicateLines</td>
														<td>@cluster.Recommendation</td>
													</tr>
												}
											</tbody>
										</table>
										<ol class="rt-list warn">@foreach (var step in codeAudit.Strategy) { <li>@step</li> }</ol>
									</div>
								</section>

								@if (codeAudit.TopPairs.Count > 0)
								{
									<section class="rt-box">
										<header class="rt-head"><span class="rt-step">4</span><div><strong>How the threshold was chosen</strong><small>measured, not guessed</small></div></header>
										<div class="audit-body">
											<table class="audit-table">
												<thead><tr><th>Similarity</th><th>Pair</th><th>Cross-repo</th><th>Clustered</th></tr></thead>
												<tbody>
													@foreach (var pair in codeAudit.TopPairs)
													{
														<tr class="@(pair.Similarity >= codeAudit.Threshold ? "p0-req" : "p0-opt")">
															<td>@pair.Similarity.ToString("0.000")</td>
															<td>@pair.Left ~ @pair.Right</td>
															<td>@(pair.CrossRepo ? "yes" : "no")</td>
															<td>@(pair.Similarity >= codeAudit.Threshold ? "yes" : "below threshold")</td>
														</tr>
													}
												</tbody>
											</table>
											<p class="ctx-method">These are the pairs either side of the cut, not the obvious top of the list. The threshold sits in the measured gap between the weakest true duplicate and the strongest unrelated pair — here that gap is narrow, and the nearest miss is a genuine near-relative rather than noise. Re-measure with <code>--calibrate-corpus</code> before pointing this at a different estate.</p>
										</div>
									</section>
								}

								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">5</span><div><strong>Claude Opus 5 designs the consolidation</strong><small>judgement, not typing</small></div></header>
									<div class="rt-actions">
										<small>Claude sees the audit; the implementation spec it writes is the only thing Gemma will see.</small>
										<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || codeAudit.DuplicatedClusters == 0 || ConsolidationBusy)" @onclick="RunConsolidation">@ConsolidationButtonText</button>
									</div>
									@if (!_bridgeConnected)
									{
										<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
									}
									@if (_session?.Consolidation.Error is { } consolidationError)
									{
										<div class="rt-error" role="alert">@consolidationError</div>
									}
									@if (_session?.Consolidation.Design is { } sharedDesign)
									{
										<div class="audit-body">
											<div class="coach-label">Designed by @_session.Consolidation.DesignModel</div>
											<h4>@sharedDesign.LibraryName</h4>
											<p class="rt-reco">@sharedDesign.Summary</p>
											@if (sharedDesign.Modules.Count > 0)
											{
												<table class="audit-table">
													<thead><tr><th>Module</th><th>Responsibility</th><th>Public API</th><th>Replaces</th></tr></thead>
													<tbody>
														@foreach (var module in sharedDesign.Modules)
														{
															<tr><td>@module.Name</td><td>@module.Responsibility</td><td><code>@module.PublicApi</code></td><td>@string.Join(", ", module.Replaces)</td></tr>
														}
													</tbody>
												</table>
											}
											@if (sharedDesign.MigrationSteps.Count > 0)
											{
												<h4>Migration</h4><ol class="rt-list good">@foreach (var step in sharedDesign.MigrationSteps) { <li>@step</li> }</ol>
											}
											@if (sharedDesign.Risks.Count > 0)
											{
												<h4>Risks</h4><ul class="rt-list warn">@foreach (var risk in sharedDesign.Risks) { <li>@risk</li> }</ul>
											}
											@if (sharedDesign.OutOfScope.Count > 0)
											{
												<h4>Deliberately not consolidated</h4><ul class="rt-list">@foreach (var item in sharedDesign.OutOfScope) { <li>@item</li> }</ul>
											}
											<h4>Implementation spec handed to Gemma</h4>
											<pre class="rt-code">@sharedDesign.ImplementationSpec</pre>
										</div>
									}
									else if (_session?.Consolidation.Status == "designing")
									{
										<div class="rt-pending"><span></span>Claude is designing the shared library from the audit…</div>
									}
									else
									{
										<div class="rt-placeholder">Claude's consolidation design will appear here.</div>
									}
								</section>

								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">6</span><div><strong>Gemma 4 implements the design</strong><small>one task per module, spec in, code out — no repository access</small></div></header>
									@if (_session?.Consolidation.Build is { } build)
									{
										<div class="audit-body">
											<div class="coach-label">@(build.ModulesCompleted)/@(build.ModulesTotal) modules · implemented by @(_session.Consolidation.BuildModel ?? "Gemma") from the spec alone — it never saw the three repositories.</div>
											@if (build.FailedModules.Count > 0)
											{
												<h4>Modules that failed</h4><ul class="rt-list warn">@foreach (var failure in build.FailedModules) { <li>@failure</li> }</ul>
											}
											@if (build.Assumptions.Count > 0)
											{
												<h4>Gaps the spec left open</h4><ul class="rt-list warn">@foreach (var assumption in build.Assumptions) { <li>@assumption</li> }</ul>
											}
											@foreach (var file in build.Files)
											{
												<h4>@file.Path</h4>
												<p class="repo-diverge">@file.Purpose</p>
												<pre class="rt-code">@file.Source</pre>
											}
											@if (build.ModulesCompleted < build.ModulesTotal)
											{
												<div class="rt-pending"><span></span>Building module @(build.ModulesCompleted + 1) of @build.ModulesTotal…</div>
											}
										</div>
									}
									else if (_session?.Consolidation.Status is "designing" or "building")
									{
										<div class="rt-pending"><span></span>Waiting for the design before the modules can be built…</div>
									}
									else
									{
										<div class="rt-placeholder">Gemma's implementation will appear here.</div>
									}
								</section>

								@if (_session?.Consolidation.Tokens is { } spend)
								{
									<section class="rt-qa">
										<header class="rt-head"><span class="rt-step">!</span><div><strong>Where the tokens went</strong><small>@(spend.Exact ? "exact Gemma tokenizer counts" : "estimated")</small></div></header>
										<table class="audit-table">
											<thead><tr><th>Stage</th><th>Model</th><th>Prompt tokens</th><th>Output tokens</th><th>What it bought</th></tr></thead>
											<tbody>
												<tr><td>Design</td><td>@(_session.Consolidation.DesignModel ?? "Claude Opus 5")</td><td>@spend.DesignPromptTokens.ToString("N0")</td><td>@spend.DesignOutputTokens.ToString("N0")</td><td>Boundaries, migration sequence, risk — the part that needs judgement.</td></tr>
												<tr><td>Build</td><td>@(_session.Consolidation.BuildModel ?? "Gemma 4")</td><td>@spend.BuildPromptTokens.ToString("N0")</td><td>@spend.BuildOutputTokens.ToString("N0")</td><td>Volume code from a closed specification — mechanical.</td></tr>
											</tbody>
										</table>
										<ul class="rt-list good">
											<li>The frontier model never received the corpus. Sending all @spend.CorpusTokens.ToString("N0") tokens of source to Claude would have cost roughly @((spend.CorpusTokens / (double)Math.Max(spend.DesignPromptTokens, 1)).ToString("0.0"))× the design prompt, before it wrote a line.</li>
											<li>@(spend.BuildOutputTokens > spend.DesignOutputTokens ? "Most of the generated volume came from the cheaper model, which is the intended split." : "The design was larger than the implementation here — on a bigger consolidation the ratio inverts.")</li>
											<li>This only holds if the spec is genuinely self-contained. If Gemma has to guess, the retry cost lands back on the expensive model — see the token economics scene for cost per successful outcome.</li>
										</ul>
									</section>
								}
							}
						}
					</section>
					break;
				case 29:
					<section>
						<p class="kicker">FREE IS THE WRONG WORD</p>
						<h2 id="scene-title">Budget in cost per outcome, not cost per token</h2>
						<p class="rt-intro">An open-weight model has <strong>no per-token vendor invoice</strong> — it does not have zero cost. And a model that fails a third of the time is billed for every failure. The only unit that survives contact with Finance is <strong>cost per successful outcome</strong>.</p>

						<div class="rt-actions">
							<small>Deterministic — illustrative rates, no model call.</small>
							<button class="primary-command compact" type="button" @onclick="RunEconomics">Compute the economics</button>
						</div>

						@if (_economics is { } econ)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>The escalation ladder</strong><small>@econ.PromptTokens.ToString("N0") prompt + @econ.OutputTokens.ToString("N0") output tokens per attempt</small></div></header>
								<div class="audit-body">
									<table class="audit-table">
										<thead><tr><th>Rung</th><th>Model</th><th>Billing</th><th>Success</th><th>Cost / attempt</th><th>Attempts / success</th><th>Cost / success</th></tr></thead>
										<tbody>
											@foreach (var row in econ.Rows)
											{
												<tr class="@(row.Rung == econ.CheapestPerSuccess ? "econ-best" : null)">
													<td>@row.Rung</td>
													<td>@row.Model</td>
													<td>@row.Kind</td>
													<td>@row.SuccessPercent%</td>
													<td>@row.CostPerAttempt.ToString("C4")</td>
													<td>@row.AttemptsPerSuccess</td>
													<td><strong>@row.CostPerSuccess.ToString("C4")</strong></td>
												</tr>
											}
										</tbody>
									</table>
									<ul class="rt-list good">@foreach (var row in econ.Rows) { <li><strong>@row.Model:</strong> @row.Note</li> }</ul>
								</div>
							</section>

							@if (econ.RateCardMisleads)
							{
								<div class="compare-status" role="status"><strong>The rate card would pick the wrong model.</strong> Cheapest per attempt is <em>@econ.CheapestPerAttempt</em>; cheapest per success is <em>@econ.CheapestPerSuccess</em>. Routing on price alone buys more retries, not more outcomes.</div>
							}

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Routing policy</strong><small>what to tell the teams</small></div></header>
								<ol class="rt-list warn">@foreach (var line in econ.Policy) { <li>@line</li> }</ol>
							</section>
						}
					</section>
					break;
				case 30:
					<section>
						<p class="kicker">A LIBRARY THAT SCALES WHAT WORKS</p>
						<h2 id="scene-title">Contributions are admitted on evidence, then run</h2>
						<p class="rt-intro">A shared prompt library scales whatever you put in it — including the mistakes. So there is an <strong>entry gate</strong> rather than an upload button. But complete paperwork does not prove a prompt works, so an admitted contribution is then <strong>executed</strong> against a real class, and a second model judges what the prompt caused.</p>

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>Contribute a pattern</strong><small>pre-filled with a working example — edit any field to see the gate react</small></div></header>
							<div class="p0-form">
								<label>Title<input type="text" @bind="_submission.Title" /></label>
								<label>Problem it solves<input type="text" @bind="_submission.Problem" /></label>
								<label>Evidence of outcome (include a number)<input type="text" @bind="_submission.Evidence" /></label>
								<label>Context it depends on<input type="text" @bind="_submission.ContextNeeded" /></label>
								<label>Known failure modes<input type="text" @bind="_submission.FailureModes" /></label>
							</div>
							<label class="p0-prompt-label">The prompt itself — this is the artefact being shared, and the instruction Gemma will receive</label>
							<textarea class="rt-code-input" spellcheck="false" maxlength="4000" @bind="_submission.Approach" @bind:event="oninput" aria-label="Shared prompt"></textarea>
							<div class="rt-actions">
								<small>The gate is deterministic. Running the pattern needs the bridge.</small>
								<button class="primary-command compact" type="button" disabled="@PatternBusy" @onclick="SubmitPattern">@PatternButtonText</button>
							</div>
							@if (!_bridgeConnected)
							{
								<p class="bridge-required" role="status">The gate runs without the bridge. Connect the VSIX to also execute the pattern.</p>
							}
						</section>

						<div class="rt-flow">
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>The class the pattern runs against</strong><small>Billing.Pricing</small></div></header>
								<pre class="rt-code">@PatternLibrarySamples.SourceClass</pre>
							</section>
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>The change request</strong><small>what Gemma is asked to do</small></div></header>
								<pre class="rt-code">@PatternLibrarySamples.ChangeRequest</pre>
								<p class="ctx-method">Read the class comment against the code before you scroll on. A good shared prompt should make the model notice something here.</p>
							</section>
						</div>

						@if (_libraryReview is { } curation)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">4</span><div><strong>Curation gate</strong><small>@curation.Score% of checks passed · deterministic</small></div></header>
								<div class="audit-body">
									<div class="audit-scoreline">
										<span class="ctx-label @(curation.Admitted ? "ctx-rich" : "ctx-poor")">@(curation.Admitted ? "ADMITTED" : "HELD")</span>
										<p>@curation.Verdict</p>
									</div>
									<table class="audit-table">
										<thead><tr><th>Check</th><th>Requirement</th><th>Why it is required</th><th>Result</th></tr></thead>
										<tbody>
											@foreach (var check in curation.Checks)
											{
												<tr class="@(check.Passed ? "p0-opt" : "p0-req")"><td>@check.Name</td><td>@check.Requirement</td><td>@check.Why</td><td>@(check.Passed ? "pass" : "FAIL")</td></tr>
											}
										</tbody>
									</table>
									@if (!curation.Admitted)
									{
										<p class="ctx-method">The pattern was not run. The gate is a precondition, not a warning — an undocumented prompt that happens to work is still not shareable.</p>
									}
								</div>
							</section>
						}

						@if (_session?.PatternRun.Error is { } patternError)
						{
							<div class="compare-status failed" role="alert">@patternError</div>
						}

						@if (_session?.PatternRun.ModifiedClass is { } produced)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">5</span><div><strong>What the shared prompt produced</strong><small>@(_session.PatternRun.GemmaModel ?? "Gemma 4") · the prompt was its only instruction</small></div></header>
								<pre class="rt-code">@produced</pre>
							</section>
						}
						else if (_session?.PatternRun.Status == "applying")
						{
							<div class="rt-pending"><span></span>Gemma is applying the contributed prompt to the class…</div>
						}

						@if (_session?.PatternRun.Review is { } patternReview)
						{
							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">6</span><div><strong>Claude Opus 4.8 judges the prompt</strong><small>@patternReview.Model · fidelity @patternReview.Fidelity/5</small></div></header>
								<p class="rt-reco">@patternReview.Verdict</p>
								<div class="know-grid">
									<div class="know-col learned"><p class="eyebrow">INSTRUCTIONS HONOURED</p><ul>@foreach (var item in patternReview.Followed) { <li>@item</li> }</ul></div>
									<div class="know-col unverified"><p class="eyebrow">INSTRUCTIONS SKIPPED</p><ul>@foreach (var item in patternReview.Ignored) { <li>@item</li> }</ul></div>
								</div>
								@if (patternReview.Risks.Count > 0)
								{
									<h4>What this prompt would do badly at scale</h4>
									<ul class="rt-list warn">@foreach (var risk in patternReview.Risks) { <li>@risk</li> }</ul>
								}
								@if (!string.IsNullOrWhiteSpace(patternReview.PromptRecommendation))
								{
									<h4>Suggested wording change</h4>
									<p class="rt-reco">@patternReview.PromptRecommendation</p>
								}
								<p class="ctx-method">The subject under review is the <strong>prompt</strong>, not the model. A weak result from a capable model is evidence the contribution is weak — which is the entire reason for running it rather than filing it.</p>
							</section>
						}
						else if (_session?.PatternRun.Status == "reviewing")
						{
							<div class="rt-pending"><span></span>Claude is judging what the prompt caused…</div>
						}

						<section class="rt-qa">
							<header class="rt-head"><span class="rt-step">·</span><div><strong>The library</strong><small>@Library.Entries.Count admitted pattern(s)</small></div></header>
							@foreach (var entry in Library.Entries)
							{
								<div class="lib-entry">
									<strong>@entry.Title</strong>
									<p><em>Problem:</em> @entry.Problem</p>
									<p><em>Approach:</em> @entry.Approach</p>
									<p><em>Evidence:</em> @entry.Evidence</p>
									<p><em>Needs:</em> @entry.ContextNeeded</p>
									<p class="lib-fail"><em>Fails when:</em> @entry.FailureModes</p>
								</div>
							}
							<h4>Read this carefully</h4>
							<ul class="rt-list warn">
								<li>One execution against one class is a demonstration, not the evidence the gate asks for. The Evidence field should carry a measured rate across many runs — this scene shows you how one of those runs is produced.</li>
								<li>Claude reviewing Gemma is a second opinion, not verification. It cannot tell you the prompt generalises.</li>
								<li>The library admits on documentation quality. Nothing here stops a well-documented prompt that is simply wrong — which is why contributions carry failure modes and get re-reviewed.</li>
							</ul>
						</section>
					</section>
					break;
				case 31:
					<section>
						<p class="kicker">PLAN BEFORE CODE</p>
						<h2 id="scene-title">A summary leadership reads, a diagram engineers check</h2>
						<p class="rt-intro">Demanding a plan with an executive summary and a diagram is a <strong>graded skill</strong>, not a nicety. The hardest check is the last one: producing an implementation before the plan is reviewed is exactly the habit this gate exists to break.</p>

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>The plan under review</strong><small>edit it to see the gate react</small></div></header>
							<textarea class="rt-code-input" spellcheck="false" maxlength="8000" @bind="_planText" @bind:event="oninput" aria-label="Plan"></textarea>
							<div class="rt-actions">
								<small>Deterministic structural check — no model call.</small>
								<button class="primary-command compact" type="button" @onclick="ReviewPlan">Review the plan</button>
							</div>
						</section>

						@if (_planReview is { } plan)
						{
							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Result</strong><small>executive summary: @plan.SummaryWords words</small></div></header>
								<div class="audit-scoreline">
									<span class="ctx-label @(plan.Score == 100 ? "ctx-rich" : plan.Score >= 60 ? "ctx-adequate" : "ctx-poor")">@plan.Score%</span>
									<p>@plan.Verdict</p>
								</div>
								<table class="audit-table">
									<thead><tr><th>Check</th><th>Requirement</th><th>Result</th></tr></thead>
									<tbody>
										@foreach (var check in plan.Checks)
										{
											<tr class="@(check.Passed ? "p0-opt" : "p0-req")"><td>@check.Name</td><td>@check.Requirement</td><td>@(check.Passed ? "pass" : "FAIL")</td></tr>
										}
									</tbody>
								</table>
							</section>
						}
					</section>
					break;
				case 32:
					<section>
						<p class="kicker">THE ORDER TO WALK IT IN</p>
						<h2 id="scene-title">Six acts, each ending in a number</h2>
						<p class="rt-intro">This is the sequence for leadership, not the order the platform was built in. Each act answers a question executives actually ask, demonstrates one control, and produces one metric. Select an act to jump to its representative scene.</p>

						<div class="act-grid">
							@foreach (var act in Acts)
							{
								var target = act.SceneIndex;
								<article class="act-card">
									<p class="eyebrow">@act.Act</p>
									<h3>“@act.Question”</h3>
									<p class="act-summary">@act.Summary</p>
									<dl class="verdict-meta"><dt>Control</dt><dd>@act.Control</dd></dl>
									<dl class="verdict-meta"><dt>Metric</dt><dd>@act.Metric</dd></dl>
									<button class="secondary-command" type="button" @onclick="() => GoTo(target)">Open: @act.SceneName →</button>
								</article>
							}
						</div>

						<section class="rt-qa">
							<header class="rt-head"><span class="rt-step">!</span><div><strong>How to present this</strong><small>the part that survives the meeting</small></div></header>
							<ul class="rt-list good">
								<li>Lead with the thesis, not the tooling: the AI, the human input, and drift are three separate failure modes, and most programmes measure only the first.</li>
								<li>Show one act per meeting if you have to. Each is self-contained and each ends in a number.</li>
								<li>Every figure in this platform is illustrative until it is measured on CES repos. Say so before someone else does.</li>
								<li>The controls that matter most are the boring ones — inventory, tiering, and the data gate. They are prerequisites, not achievements.</li>
							</ul>
						</section>
					</section>
					break;
				case 33:
					<section>
						<p class="kicker">GROUND THE CHEAP MODEL, THEN DELEGATE TO IT</p>
						<h2 id="scene-title">Making Gemma 4 a crypto SME</h2>
						<p class="rt-intro">Claude Opus 5 is a strong generalist. On a domain with exact header names, exact defaults and exact error semantics, "strong generalist" is not the same as "will get it right". Here Claude answers <strong>unaided</strong> first, then consults a <strong>grounded Gemma 4</strong> as a subagent, then designs. The improvement is measured against verified facts — not asserted.</p>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>The requirement</strong><small>CRY-4417 · a real design task, not a quiz</small></div></header>
							<pre class="rt-code">@CryptoSmeCorpus.Jira</pre>
						</section>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">2</span><div><strong>What Gemma is grounded on</strong><small>three layers · @CryptoSmeCorpus.Facts.Count verified facts</small></div></header>
							<div class="audit-body">
								<div class="know-grid">
									<div class="know-col own"><p class="eyebrow">LAYER 1 · UNIFIED</p><ul><li>CCXT — one API across 100+ venues, CCXT Pro for WebSocket streaming. Keeps venue two from being a rewrite.</li></ul></div>
									<div class="know-col learned"><p class="eyebrow">LAYER 2 · VENUE MECHANICS</p><ul><li>Binance spot: weight-based rate limiting, timing and signature rules, symbol filters, unknown-outcome handling.</li></ul></div>
									<div class="know-col unverified"><p class="eyebrow">LAYER 3 · FIRM RULES</p><ul><li>Decimal-only arithmetic, per-service credentials, dedicated egress, firm-generated client order ids. Synthetic here; real policy in production.</li></ul></div>
								</div>
								<h4>Sources the pack was built from</h4>
								<ul class="rt-list good">@foreach (var source in CryptoSmeCorpus.Sources) { <li><a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Label</a></li> }</ul>
								<p class="ctx-method">Layers 1 and 2 were transcribed from these pages and each fact is cited in the pack. Layer 3 is synthetic and labelled as such. Today this is a curated pack; the stated intent is that Gemma later runs internally with no per-token vendor cost, carrying both the industry rules and the firm's own.</p>
							</div>
						</section>

						<div class="rt-actions">
							<small>Three stages: Claude unaided, Gemma grounded, Claude designs.</small>
							<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || SmeBusy)" @onclick="RunCryptoSme">@SmeButtonText</button>
						</div>
						@if (!_bridgeConnected)
						{
							<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
						}
						@if (_session?.CryptoSme.Error is { } smeError)
						{
							<div class="compare-status failed" role="alert">@smeError</div>
						}

						@if (_session?.CryptoSme.Unaided is { } unaided)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>Claude Opus 5, unaided</strong><small>@unaided.Model · no documentation supplied</small></div></header>
								<div class="audit-body">
									<div class="audit-scoreline">
										<span class="ctx-label @(unaided.FactScore >= 70 ? "ctx-rich" : unaided.FactScore >= 40 ? "ctx-adequate" : "ctx-poor")">@unaided.FactScore%</span>
										<div><strong>Verified-fact recall</strong><small>@unaided.FactsHit.Count of @CryptoSmeCorpus.Facts.Count facts present</small></div>
									</div>
									<p class="rt-reco">@unaided.Attempt</p>
									@if (unaided.Uncertain.Count > 0)
									{
										<h4>What it flagged as uncertain</h4>
										<ul class="rt-list warn">@foreach (var item in unaided.Uncertain) { <li>@item</li> }</ul>
									}
									@if (unaided.Questions.Count > 0)
									{
										<h4>Questions it put to the SME</h4>
										<ol class="rt-list">@foreach (var item in unaided.Questions) { <li>@item</li> }</ol>
									}
								</div>
							</section>
						}
						else if (_session?.CryptoSme.Status == "unaided")
						{
							<div class="rt-pending"><span></span>Claude is attempting the design from its own knowledge…</div>
						}

						@if (_session?.CryptoSme.Consultation is { } consult)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">4</span><div><strong>Gemma 4 answers as the grounded SME</strong><small>@consult.Model · @consult.PackTokens.ToString("N0") tokens of grounding</small></div></header>
								<div class="audit-body">
									<table class="audit-table">
										<thead><tr><th>Question</th><th>Answer</th><th>Cited to</th></tr></thead>
										<tbody>
											@foreach (var answer in consult.Answers)
											{
												<tr class="@(answer.InPack ? "p0-opt" : "p0-req")">
													<td>@answer.Question</td>
													<td>@answer.Answer</td>
													<td>@(answer.InPack ? answer.Citation : "NOT IN PACK — refused to guess")</td>
												</tr>
											}
										</tbody>
									</table>
									@if (consult.Corrections.Count > 0)
									{
										<h4>Where the pack contradicted Claude's unaided attempt</h4>
										<ul class="rt-list warn">@foreach (var correction in consult.Corrections) { <li>@correction</li> }</ul>
									}
									@if (consult.Unprompted.Count > 0)
									{
										<h4>Material facts nobody asked about</h4>
										<ul class="rt-list good">@foreach (var extra in consult.Unprompted) { <li>@extra</li> }</ul>
										<p class="ctx-method">This list is the point of the stage. A subagent that only answers the questions put to it limits the design to what the asker already suspected.</p>
									}
								</div>
							</section>
						}
						else if (_session?.CryptoSme.Status == "consulting")
						{
							<div class="rt-pending"><span></span>Gemma is answering from the grounding pack…</div>
						}

						@if (_session?.CryptoSme.Design is { } smeDesign)
						{
							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">5</span><div><strong>Final design — Claude Opus 5 using Gemma as a subagent</strong><small>@smeDesign.Model · every step tagged with its source</small></div></header>
								<div class="audit-scoreline">
									<span class="ctx-label @(smeDesign.FactScore >= 70 ? "ctx-rich" : smeDesign.FactScore >= 40 ? "ctx-adequate" : "ctx-poor")">@smeDesign.FactScore%</span>
									<div>
										<strong>Verified-fact recall</strong>
										<small>@(_session.CryptoSme.Unaided is { } baseline ? $"{baseline.FactScore}% unaided → {smeDesign.FactScore}% grounded ({(smeDesign.FactScore - baseline.FactScore >= 0 ? "+" : "")}{smeDesign.FactScore - baseline.FactScore} points)" : "no baseline")</small>
									</div>
								</div>
								<p class="rt-reco">@smeDesign.Summary</p>
								<table class="audit-table">
									<thead><tr><th>Step</th><th>Detail</th><th>Source</th></tr></thead>
									<tbody>
										@foreach (var step in smeDesign.Steps)
										{
											<tr>
												<td>@step.Step</td>
												<td>@step.Detail</td>
												<td><span class="src-tag src-@step.Source">@(step.Source switch { "own" => "Claude knew", "sme" => "from Gemma SME", _ => "unverified" })</span></td>
											</tr>
										}
									</tbody>
								</table>
								@if (smeDesign.Risks.Count > 0)
								{
									<h4>Risks</h4>
									<ul class="rt-list warn">@foreach (var risk in smeDesign.Risks) { <li>@risk</li> }</ul>
								}
								@if (smeDesign.OpenQuestions.Count > 0)
								{
									<h4>Must be verified against the vendor documentation</h4>
									<ul class="rt-list warn">@foreach (var question in smeDesign.OpenQuestions) { <li>@question</li> }</ul>
								}
								@if (smeDesign.FactsMissed.Count > 0)
								{
									<h4>Verified facts still absent from the design</h4>
									<ul class="rt-list warn">@foreach (var missed in smeDesign.FactsMissed) { <li>@missed</li> }</ul>
								}
							</section>
						}
						else if (_session?.CryptoSme.Status == "designing")
						{
							<div class="rt-pending"><span></span>Claude is designing using the SME's answers…</div>
						}

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">·</span><div><strong>The facts being scored</strong><small>deterministic · verified against the sources above</small></div></header>
							<div class="audit-body">
								@if (_session?.CryptoSme.Trace.Count > 0)
								{
									<p class="rt-reco">A flat score is not the same as no effect. This traces each fact through the three stages, so a fact missing from the design can be attributed to the stage that lost it.</p>
									<table class="audit-table">
										<thead><tr><th>Fact</th><th>Unaided</th><th>Asked</th><th>SME gave it</th><th>In design</th><th>Where it was lost</th></tr></thead>
										<tbody>
											@foreach (var row in _session.CryptoSme.Trace)
											{
												<tr class="@(row.InDesign ? "p0-opt" : "p0-req")">
													<td>@row.Name</td>
													<td>@(row.InUnaided ? "yes" : "—")</td>
													<td>@(row.Asked ? "yes" : "—")</td>
													<td>@(row.AnsweredBySme ? "yes" : "—")</td>
													<td>@(row.InDesign ? "yes" : "NO")</td>
													<td>@row.Verdict</td>
												</tr>
											}
										</tbody>
									</table>
									<p class="ctx-method">"Never asked, never supplied, never used" is the most common row, and it is a failure of the <em>delegation</em>, not of the SME. The subagent now also volunteers material facts nobody asked about, which is the fix for that row.</p>
								}
								<table class="audit-table">
									<thead><tr><th>Fact</th><th>Ground truth</th><th>What goes wrong without it</th></tr></thead>
									<tbody>
										@foreach (var fact in CryptoSmeCorpus.Facts)
										{
											<tr>
												<td>@fact.Name</td>
												<td>@fact.Truth</td>
												<td>@fact.Trap</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						</section>

						<section class="rt-qa">
							<header class="rt-head"><span class="rt-step">!</span><div><strong>Read this carefully</strong><small>what this does and does not show</small></div></header>
							<ul class="rt-list warn">
								<li><strong>The recall score is keyword detection.</strong> It measures whether the specific fact appears, not whether it was used correctly. It is a floor, not a grade.</li>
								<li><strong>A flat score can be a real result.</strong> If the unaided attempt and the grounded design score the same, read the trace above before concluding the grounding did nothing — the usual cause is that the facts were never asked about.</li>
								<li><strong>A grounded small model is not a source.</strong> Gemma cites the pack; the pack cites the vendor. Neither is the vendor. Anything tagged <em>unverified</em> must be checked against the primary documentation before it is built.</li>
								<li><strong>This is grounding, not training.</strong> No weights changed. The claimed future state — an internally hosted Gemma carrying industry and firm rules at no per-token vendor cost — still has fixed infrastructure cost, and still needs this pack maintained.</li>
								<li><strong>The pack is a snapshot.</strong> It was transcribed on 2026-09-06. Exchange APIs change; a stale pack grounds the model in confident, wrong detail — worse than no pack at all.</li>
							</ul>
						</section>
					</section>
					break;
			}
		</article>

		<footer class="stage-footer">
			<button class="secondary-command" type="button" disabled="@(_scene == 0)" @onclick="Previous">&larr; Previous</button>
			<div class="narration-text"><span>Narration transcript</span><p>@CurrentNarration</p></div>
			<button class="secondary-command" type="button" disabled="@(_scene == Scenes.Length - 1)" @onclick="Next">Next &rarr;</button>
		</footer>
	</section>

	<aside class="connection-drawer" aria-hidden="@(!_drawerOpen)">
		<button class="drawer-toggle" type="button" title="Hide the local bridge panel" aria-label="Hide the local bridge panel" aria-expanded="true" aria-controls="bridge-drawer" @onclick="ToggleDrawer">Hide &rsaquo;</button>
		<p class="eyebrow">LOCAL BRIDGE</p><h2>Connect VS Code</h2><p>Run <strong>POC Training: Connect</strong> in VS Code and paste this session token.</p>
		<code>@_session?.BridgeToken</code><button type="button" @onclick="CopyToken">Copy token</button>
		<dl><dt>Server</dt><dd>127.0.0.1:5000</dd><dt>Coach</dt><dd>Gemma 4</dd><dt>Review</dt><dd>Claude Opus 5</dd></dl>
	</aside>

	@if (!_drawerOpen)
	{
		<button class="drawer-reopen" type="button" title="Show the local bridge panel" aria-label="Show the local bridge panel" aria-expanded="false" aria-controls="bridge-drawer" @onclick="ToggleDrawer">
			<span class="status-dot @(_bridgeConnected ? "online" : null)"></span>&lsaquo; Local bridge
		</button>
	}
</div>

@code {
