{
  "name": "poc-interactive-training-client",
  "publisher": "ces-poc",
  "displayName": "POC Interactive Training Client",
  "description": "Connects VS Code language models to the local OKF multimedia training POC.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Education",
    "AI"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pocTraining.connect",
        "title": "POC Training: Connect"
      },
      {
        "command": "pocTraining.disconnect",
        "title": "POC Training: Disconnect"
      },
      {
        "command": "pocTraining.openLesson",
        "title": "POC Training: Open Blazor Lesson"
      }
    ],
    "configuration": {
      "title": "POC Interactive Training",
      "properties": {
        "pocTraining.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5000",
          "description": "Loopback URL for the local Blazor training POC."
        },
        "pocTraining.pollIntervalMs": {
          "type": "number",
          "default": 1500,
          "minimum": 750,
          "maximum": 10000,
          "description": "Delay between local task polls."
        },
        "pocTraining.requireApproval": {
          "type": "boolean",
          "default": false,
          "description": "Require explicit approval of each exact action before it runs (competency 12). Off by default so batch scenes stay usable; turning it on demonstrates the R2/R3 approval gate."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "bundle": "npm run check-types && npm run lint && node esbuild.js --production",
    "package": "npm run bundle && vsce package --allow-missing-repository --skip-license --out dist/poc-interactive-training-client.vsix",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
