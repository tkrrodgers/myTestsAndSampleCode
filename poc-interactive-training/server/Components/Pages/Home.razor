							<textarea class="rt-code-input" spellcheck="false" maxlength="12000" @bind="_testPayload" @bind:event="oninput" aria-label="Ephemeral test payload"></textarea>
							<div class="rt-actions">
								<small>@_testPayload.Length / 12000 · deterministic scan</small>
								<button class="primary-command compact" type="button" @onclick="RunDataTier">Classify before sending</button>
							</div>
						</section>

						@if (_assessment is { } assessment)
