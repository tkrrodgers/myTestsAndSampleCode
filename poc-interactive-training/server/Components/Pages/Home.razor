	private static string DomainGloss(Neuron neuron)
	{
		var reads = string.Join(" ", neuron.ReadArtifacts).ToUpperInvariant();
		if (reads.Contains("EASTINVNTRY"))
		{
			return "the vehicle inventory: the cars actually on the lot, and the screen and lookup that show them.";
		}

		if (reads.Contains("MAKE_MODEL"))
		{
			return "the vehicle catalogue: which makes and models exist, and the screens and lookup that let a user choose one.";
		}

		return "a group the tool found; a person names it.";
	}

