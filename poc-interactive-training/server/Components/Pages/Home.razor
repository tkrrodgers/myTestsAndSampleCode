											@if (measured is not null && measured.PromptTokens > 0)
											{
												<p class="repo-stats">@measured.PromptTokens.ToString("N0") prompt tokens</p>
											}
										</article>
									}
								</div>
								<div class="rt-actions">
									<small>@ContextTierSamples.Tiers.Count variants × @curve.RunsPerTier runs, then one comparative review. @(curve.TokensExact ? "Tokens counted with the Gemma tokenizer." : "Tokens estimated.")</small>
									<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || CurveBusy)" @onclick="RunCurve">@(!_bridgeConnected ? "Connect VSIX to run" : CurveBusy ? "Running…" : "Run all three")</button>
								</div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
								}
							</section>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>What Gemma produced</strong><small>median of @curve.RunsPerTier runs · scored against sealed criteria it never sees</small></div></header>
								<div class="audit-body">
									<table class="audit-table">
										<thead><tr><th>Variant</th><th>Prompt tokens</th><th>Median</th><th>Range</th><th>Criteria met</th><th>Progress</th></tr></thead>
										<tbody>
											@foreach (var tierRow in curve.Tiers)
											{
												var done = tierRow.Runs.Count(run => run.Status is "completed" or "failed");
												<tr class="@(curve.Degradation is { } d && tierRow.Id == d.BestTier ? "curve-plateau" : null)">
													<td>@tierRow.Label</td>
													<td>@tierRow.PromptTokens.ToString("N0")</td>
													<td><strong>@tierRow.MedianScore</strong></td>
													<td>@(done > 0 ? $"{tierRow.WorstScore}–{tierRow.BestScore}" : "—")</td>
													<td>@tierRow.MedianMet.Count / @ContextTierSamples.Criteria.Count</td>
													<td><div class="audit-bar"><i style="width:@tierRow.MedianScore%"></i></div><small>@done / @curve.RunsPerTier runs</small></td>
												</tr>
											}
										</tbody>
									</table>
									@if (CurveBusy)
									{
										<div class="rt-pending"><span></span>Running every variant. The repetition is deliberate — one score on a stochastic system is a reading, not a direction.</div>
									}
								</div>
							</section>

							@foreach (var tierDetail in curve.Tiers.Where(item => item.Runs.Any(run => run.Status == "completed")))
							{
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">·</span><div><strong>@tierDetail.Label</strong><small>@tierDetail.MedianScore / 100 · @tierDetail.PromptTokens.ToString("N0") tokens</small></div></header>
									<div class="audit-body">
										@if (tierDetail.MedianMissed.Count > 0)
										{
											<h4>Missed at this tier</h4>
											<ul class="rt-list warn">@foreach (var name in tierDetail.MedianMissed) { <li>@name</li> }</ul>
										}
										@{
											var shown = tierDetail.Runs.FirstOrDefault(run => run.Status == "completed" && run.Score == tierDetail.MedianScore)
														?? tierDetail.Runs.First(run => run.Status == "completed");
										}
										<h4>Gemma's plan</h4>
										<pre class="rt-code">@shown.Plan</pre>
									</div>
								</section>
							}

							@if (curve.Degradation is { } degradation)
							{
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">4</span><div><strong>The degradation</strong><small>deterministic · no model produced these numbers</small></div></header>
									<div class="know-grid">
										<div class="know-col learned"><p class="eyebrow">BEST</p><ul><li>@degradation.BestTier</li></ul></div>
										<div class="know-col unverified"><p class="eyebrow">WORST</p><ul><li>@degradation.WorstTier — @degradation.Drop points lower</li></ul></div>
										<div class="know-col own"><p class="eyebrow">FLOOR</p><ul><li>@degradation.FloorTier is the weakest variant still within 80% of the best. Below it, do not run the cheap model unattended.</li></ul></div>
									</div>
									<p class="rt-reco">@degradation.Note</p>
									@if (degradation.LostCriteria.Count > 0)
									{
										<h4>Lost when the documentation was removed</h4>
										<ul class="rt-list warn">@foreach (var name in degradation.LostCriteria) { <li>@name</li> }</ul>
									}
									<h4>Sealed criteria</h4>
									<ul class="rt-list good">@foreach (var criterion in ContextTierSamples.Criteria) { <li><strong>@criterion.Name</strong> — @criterion.Description <em>(derivable from @ContextTierSamples.Tiers[criterion.UnlockedAtTier].Label onwards)</em></li> }</ul>
									<p class="ctx-method">Scored by keyword detection against criteria the planning model never sees. It is reproducible and trendable, but it rewards saying the right words — which is why a judgement layer follows rather than replaces it.</p>
								</section>
							}

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">@(curve.Degradation is null ? "4" : "5")</span><div><strong>Claude Opus 4.8 reviews all three</strong><small>@(curve.JudgeModel ?? "Claude Opus 4.8") · engineering substance, not keywords</small></div></header>
								@if (curve.Verdict is { } curveVerdict)
								{
									<p class="rt-reco">@curveVerdict.Summary</p>
									<table class="audit-table">
										<thead><tr><th>Variant</th><th>Correctness</th><th>Grounding</th><th>Assessment</th></tr></thead>
										<tbody>
											@foreach (var judged in curveVerdict.Tiers)
											{
												<tr>
													<td>@judged.Tier</td>
													<td>@judged.Correctness/5</td>
													<td>@judged.Grounding/5</td>
													<td>@judged.Assessment</td>
												</tr>
											}
										</tbody>
									</table>
									@foreach (var judged in curveVerdict.Tiers.Where(item => item.Errors.Count > 0))
									{
										<h4>Factual errors in @judged.Tier</h4>
										<ul class="rt-list warn">@foreach (var error in judged.Errors) { <li>@error</li> }</ul>
									}
									@if (curveVerdict.DegradationEvidence.Count > 0)
									{
										<h4>What was actually lost</h4>
										<ul class="rt-list warn">@foreach (var item in curveVerdict.DegradationEvidence) { <li>@item</li> }</ul>
									}
									@if (!string.IsNullOrWhiteSpace(curveVerdict.MinimumViableContext))
									{
										<h4>Minimum context a team must maintain</h4>
										<p class="rt-reco">@curveVerdict.MinimumViableContext</p>
									}
									@if (!string.IsNullOrWhiteSpace(curveVerdict.Caveat))
									{
										<h4>What this does not establish</h4>
										<p class="ctx-method">@curveVerdict.Caveat</p>
									}
								}
								else if (curve.Status == "judging")
								{
									<div class="rt-pending"><span></span>Claude is comparing the three plans against the ground truth…</div>
								}
								else if (curve.Error is { } curveError)
								{
									<div class="compare-status failed" role="alert">@curveError</div>
								}
								else
								{
									<div class="rt-placeholder">The comparative review will appear here once all three variants have run.</div>
								}
								<h4>Read this carefully</h4>
								<ul class="rt-list warn">
									<li>One ticket on one repository. This shows the shape of the effect, not its size across your estate — measure your own before quoting a number.</li>
									<li>The deterministic score rewards vocabulary. Claude's correctness rating is the check on that, and it is a model's opinion, not a validated grade.</li>
									<li>The undocumented variant is not empty — it is <em>wrong</em>. Stale documentation is the expensive failure mode, because the model has no way to know it is stale.</li>
								</ul>
							</section>
						}
					</section>
					break;
				case 23:
					<section>
						<p class="kicker">AUTHORITY IS PER ACTION, NOT PER AGENT</p>
						<h2 id="scene-title">"Approve deploy" is not approval</h2>
						<p class="rt-intro">An autonomous agent may proceed without per-call approval <em>only</em> on reversible actions inside its registered envelope. Everything else stops for a verified human decision. This uses the same registration you tiered in Phase 0 — change the agent there and the answers here change with it.</p>

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>Proposed action</strong><small>agent: @_agent.Name · autonomy: @_agent.Autonomy</small></div></header>
							<div class="p0-form">
								<label>Action<select @bind="_selectedActionId">@foreach (var action in ActionAuthorityService.Catalog) { <option value="@action.Id">@action.Description</option> }</select></label>
							</div>
							<div class="rt-actions">
								<small>Deterministic — no model call.</small>
								<button class="primary-command compact" type="button" @onclick="RunAuthority">Decide authority</button>
							</div>
						</section>

						@if (_decision is { } decision)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Decision</strong><small>09 §3.4 · 10 §5</small></div></header>
								<div class="audit-body">
									<div class="audit-scoreline">
										<span class="ctx-label verdict-@decision.Verdict.ToLowerInvariant()">@decision.Verdict</span>
										<div><strong>@decision.VerdictLabel</strong><small>@decision.Description</small></div>
									</div>
									<h4>Why</h4>
									<ul class="rt-list warn">@foreach (var reason in decision.Reasons) { <li>@reason</li> }</ul>
									<h4>Exact-action checks the approver must make</h4>
									<ol class="rt-list good">@foreach (var check in decision.ExactActionChecks) { <li>@check</li> }</ol>
								</div>
							</section>

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>Intervention path</strong><small>@decision.Intervention.Severity</small></div></header>
								<p class="rt-reco">@decision.Intervention.Summary</p>
								@if (decision.Intervention.Steps.Count > 0)
								{
									<ol class="rt-list warn">@foreach (var step in decision.Intervention.Steps) { <li>@step</li> }</ol>
									<dl class="verdict-meta"><dt>Owner</dt><dd>@decision.Intervention.Owner</dd><dt>SLA</dt><dd>@decision.Intervention.Sla</dd></dl>
								}
								<p class="ctx-method">The client enforces this too: set <code>pocTraining.requireApproval</code> to make every task stop at this gate.</p>
							</section>
						}
					</section>
					break;
				case 24:
					<section>
						<p class="kicker">THE BIAS YOU BRING</p>
						<h2 id="scene-title">The same question, asked three ways</h2>
						<p class="rt-intro">Engineers police what the model gets wrong and rarely notice how their own framing manufactured the answer. One question goes to one model three times — <strong>leading</strong>, <strong>neutral</strong>, and <strong>dissent-demanded</strong>. Divergence from the neutral answer is measured with embeddings <em>before</em> any model offers an opinion about it.</p>

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>Your question</strong><small>asked identically except for the framing</small></div></header>
							<textarea class="rt-code-input" spellcheck="false" maxlength="4000" @bind="_framingQuestion" @bind:event="oninput" disabled="@FramingBusy" aria-label="Question"></textarea>
							<div class="rt-actions">
								<small>@_framingQuestion.Length / 4000</small>
								<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || _framingQuestion.Trim().Length < 10 || FramingBusy)" @onclick="RunFraming">@(!_bridgeConnected ? "Connect VSIX to run" : FramingBusy ? "Asking…" : "Ask all three ways")</button>
							</div>
							@if (!_bridgeConnected)
							{
								<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
							}
						</section>

						@if (_session?.Framing.Arms.Count > 0)
						{
							<div class="compare-columns">
								@foreach (var arm in _session.Framing.Arms)
								{
									<article class="compare-col @(arm.Id == "neutral" ? "winner" : null)">
										<header class="compare-col-head">
											<span class="slot-badge">@arm.Label</span>
											<strong>@(arm.ModelUsed ?? "Claude")</strong>
											<small>@arm.Framing</small>
										</header>
										@if (arm.Status == "completed")
										{
											<div class="answer-body">@arm.Answer</div>
											<div class="answer-metrics">
												<span class="coverage">@(arm.Id == "neutral" ? "baseline" : $"similarity to neutral {arm.SimilarityToNeutral:0.00}")</span>
											</div>
										}
										else if (arm.Status == "failed")
										{
											<div class="answer-failed">@arm.Error</div>
										}
										else
										{
											<div class="answer-pending"><span></span>Asking…</div>
										}
									</article>
								}
							</div>
						}

						@if (_session?.Framing.Verdict is { } framingVerdict)
						{
							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Did the framing change the substance?</strong><small>reviewed by @_session.Framing.JudgeModel</small></div></header>
								<div class="audit-scoreline">
									<span class="ctx-label @(framingVerdict.SubstanceChanged ? "ctx-poor" : "ctx-rich")">@(framingVerdict.SubstanceChanged ? "CHANGED" : "HELD")</span>
									<p>@framingVerdict.Summary</p>
								</div>
								@if (framingVerdict.Differences.Count > 0)
								{
									<h4>Substantive divergences</h4><ul class="rt-list warn">@foreach (var difference in framingVerdict.Differences) { <li>@difference</li> }</ul>
								}
								@if (!string.IsNullOrWhiteSpace(framingVerdict.Recommendation))
								{
									<h4>How to ask next time</h4><p class="rt-reco">@framingVerdict.Recommendation</p>
								}
							</section>
						}
						else if (FramingBusy)
						{
							<div class="rt-pending"><span></span>Collecting all three answers before comparing them…</div>
						}
						@if (_session?.Framing.Status == "failed")
						{
							<div class="compare-status failed" role="alert">@(_session?.Framing.Error ?? "The framing lab did not complete.")</div>
						}
					</section>
					break;
				case 25:
					<section>
						<p class="kicker">GREEN TESTS ARE NOT COVERAGE</p>
						<h2 id="scene-title">Does the suite cover the risk this change adds?</h2>
						<p class="rt-intro">Line coverage asks <em>"did a test execute this line?"</em> — a test with no assertions satisfies it. Mutation testing asks the question that actually matters: <strong>"would a test have noticed if this line were wrong?"</strong></p>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">?</span><div><strong>What a mutation score is</strong><small>and why it is called that</small></div></header>
							<div class="audit-body">
								<p class="rt-reco">The technique dates to the 1970s and the name is a biological metaphor. You breed small variants of a working program — <strong>mutants</strong> — and see how many the tests can detect.</p>
								<div class="pipeline-chain">
									<span>compile</span><span>run baseline</span><span>inject one defect</span><span>re-run tests</span><span>killed or survived</span><span>score</span>
								</div>
								<table class="audit-table">
									<thead><tr><th>Outcome</th><th>What happened</th><th>What it means</th></tr></thead>
									<tbody>
										<tr class="p0-opt"><td><strong>Killed</strong></td><td>At least one test failed against the mutated code.</td><td>The suite would have caught this defect in review or CI.</td></tr>
										<tr class="p0-req"><td><strong>Survived</strong></td><td>Every test still passed against code that is measurably wrong.</td><td>The suite is blind to this defect. It would ship green.</td></tr>
									</tbody>
								</table>
								<p class="rt-reco"><strong>Mutation score = killed ÷ viable mutants.</strong> A score of 100% does not mean the code is correct — it means the suite noticed every defect <em>this tool knows how to inject</em>. It is a lower bound on test sensitivity, not a proof of correctness.</p>
								<h4>The defects injected here</h4>
								<table class="audit-table">
									<thead><tr><th>Operator</th><th>Mutation</th><th>The real bug it stands in for</th></tr></thead>
									<tbody>
										<tr><td>Boundary widened</td><td><code>&gt;</code> → <code>&gt;=</code>, <code>&lt;</code> → <code>&lt;=</code></td><td>Off-by-one at a threshold — the classic fee, tier and limit defect.</td></tr>
										<tr><td>Boundary narrowed</td><td><code>&gt;=</code> → <code>&gt;</code>, <code>&lt;=</code> → <code>&lt;</code></td><td>An eligible case silently excluded at the edge.</td></tr>
										<tr><td>Arithmetic flipped</td><td><code>+</code> → <code>-</code>, <code>-</code> → <code>+</code></td><td>A sign error in a money calculation.</td></tr>
										<tr><td>Threshold shifted</td><td>numeric literal → value + 1</td><td>A rate, cap or grace period that quietly drifted from policy.</td></tr>
									</tbody>
								</table>
								<h4>Two rules that keep the number honest</h4>
								<ul class="rt-list warn">
									<li><strong>The baseline must be green first.</strong> If the unmutated suite already fails, every mutant looks killed and the score is meaningless. This refuses to run in that state.</li>
									<li><strong>Mutants that will not compile are excluded, not counted as kills.</strong> No test could ever have caught them, so counting them would inflate the score for free — a common way mutation tools flatter a suite.</li>
								</ul>
								<p class="ctx-method">A timeout also counts as a kill: an infinite loop caused by a flipped operator is a detected defect, just detected slowly.</p>
							</div>
						</section>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>The enhancement</strong><small>what the change is meant to add</small></div></header>
							<div class="audit-body"><pre class="rt-code">@RegressionSamples.Enhancement</pre></div>
						</section>

						<div class="rt-flow">
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Code under test</strong><small>editable</small></div></header>
								<textarea class="rt-code-input" spellcheck="false" maxlength="8000" @bind="_regressionSource" @bind:event="oninput" disabled="@_mutationRunning" aria-label="Source"></textarea>
							</section>
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>Existing test suite</strong><small>currently passing</small></div></header>
								<textarea class="rt-code-input" spellcheck="false" maxlength="8000" @bind="_regressionTests" @bind:event="oninput" disabled="@_mutationRunning" aria-label="Tests"></textarea>
							</section>
						</div>

						<div class="rt-actions">
							<small>Deterministic — compiles and runs in-process, no model call.</small>
							<button class="primary-command compact" type="button" disabled="@_mutationRunning" @onclick="RunMutation">@(_mutationRunning ? "Running mutants…" : "Run mutation test")</button>
						</div>

						@if (_mutation is { } mutation)
						{
							@if (!mutation.Ran)
							{
								<div class="compare-status failed" role="alert">@mutation.Error</div>
							}
							else
							{
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">4</span><div><strong>Result</strong><small>@mutation.KilledMutants of @mutation.TotalMutants defects caught</small></div></header>
									<div class="audit-scoreline">
										<span class="ctx-label @(mutation.MutationScore >= 80 ? "ctx-rich" : mutation.MutationScore >= 50 ? "ctx-adequate" : "ctx-poor")">@mutation.MutationScore%</span>
										<div><strong>Mutation score</strong><small>baseline suite: @string.Join(", ", mutation.BaselineTests)</small></div>
										<p>@mutation.Verdict</p>
									</div>
									<table class="audit-table">
										<thead><tr><th>Line</th><th>Injected defect</th><th>Change</th><th>Outcome</th></tr></thead>
										<tbody>
											@foreach (var mutant in mutation.Mutants)
											{
												<tr class="@(mutant.Killed ? "p0-opt" : "p0-req")">
													<td>@mutant.Line</td>
													<td>@mutant.Description</td>
													<td><code>@mutant.Original</code> → <code>@mutant.Mutated</code></td>
													<td>@(mutant.Killed ? $"caught by {mutant.Detail}" : "SURVIVED — no test failed")</td>
												</tr>
											}
										</tbody>
									</table>
									<p class="ctx-method">Every surviving row is a real behaviour change the suite accepted. Add a test until the rows that matter go away.</p>
								</section>

								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">5</span><div><strong>Gemma 4 proposes the missing tests</strong><small>closing named survivors, not "more coverage"</small></div></header>
									<div class="audit-body">
										<p class="rt-reco">A surviving mutant is a <strong>falsifiable target</strong>: either a proposed test fails against the mutated code or it does not. That is why the model is asked to close specific survivors rather than to improve the suite in general — the instruction can be checked.</p>
										<div class="rt-actions">
											<small>Gemma sees the mutation report, the code and the existing tests.</small>
											<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || GuidanceBusy || mutation.Mutants.All(item => item.Killed))" @onclick="RunRegressionGuidance">@GuidanceButtonText</button>
										</div>
										@if (mutation.Mutants.All(item => item.Killed))
										{
											<p class="ctx-method">Nothing survived, so there is nothing to remediate.</p>
										}
										else if (!_bridgeConnected)
										{
											<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
										}
										@if (_session?.RegressionGuidance.Error is { } guidanceError)
										{
											<div class="compare-status failed" role="alert">@guidanceError</div>
										}
										@if (_session?.RegressionGuidance.Remediation is { } remediation)
										{
											<div class="coach-label">Proposed by @remediation.Model</div>
											<p class="rt-reco">@remediation.Summary</p>
											<table class="audit-table">
												<thead><tr><th>Test</th><th>Kills</th><th>Scenario</th><th>Assertion</th></tr></thead>
												<tbody>
													@foreach (var proposal in remediation.Tests)
													{
														<tr><td><code>@proposal.Name</code></td><td>@proposal.TargetsSurvivor</td><td>@proposal.Behaviour</td><td>@proposal.Assertion</td></tr>
													}
												</tbody>
											</table>
											@if (remediation.NotWorthTesting.Count > 0)
											{
												<h4>Deliberately not tested</h4>
												<ul class="rt-list">@foreach (var item in remediation.NotWorthTesting) { <li>@item</li> }</ul>
											}
										}
										else if (_session?.RegressionGuidance.Status == "advising")
										{
											<div class="rt-pending"><span></span>Gemma is working out which tests would close the survivors…</div>
										}
									</div>
								</section>

								<section class="rt-qa">
									<header class="rt-head"><span class="rt-step">6</span><div><strong>Claude Opus 4.8 checks the proposals</strong><small>would each test actually kill what it claims?</small></div></header>
									@if (_session?.RegressionGuidance.Review is { } guidanceReview)
									{
										<div class="coach-label">Reviewed by @guidanceReview.Model</div>
										<p class="rt-reco">@guidanceReview.Verdict</p>
										<table class="audit-table">
											<thead><tr><th>Proposed test</th><th>Would it kill the mutant?</th><th>Reasoning traced against the code</th></tr></thead>
											<tbody>
												@foreach (var testCheck in guidanceReview.Assessments)
												{
													<tr class="@(testCheck.WouldKill ? "p0-opt" : "p0-req")">
														<td><code>@testCheck.Name</code></td>
														<td>@(testCheck.WouldKill ? "yes" : "NO")</td>
														<td>@testCheck.Reasoning</td>
													</tr>
												}
											</tbody>
										</table>
										@if (guidanceReview.Gaps.Count > 0)
										{
											<h4>Survivors still uncovered</h4>
											<ul class="rt-list warn">@foreach (var gap in guidanceReview.Gaps) { <li>@gap</li> }</ul>
										}
										@if (guidanceReview.Overreach.Count > 0)
										{
											<h4>Asserts implementation detail — will break on refactoring</h4>
											<ul class="rt-list warn">@foreach (var item in guidanceReview.Overreach) { <li>@item</li> }</ul>
										}
										@if (!string.IsNullOrWhiteSpace(guidanceReview.NextStep))
										{
											<h4>Before trusting any of this</h4>
											<p class="rt-reco">@guidanceReview.NextStep</p>
										}
									}
									else if (_session?.RegressionGuidance.Status is "advising" or "reviewing")
									{
										<div class="rt-pending"><span></span>Claude is tracing each proposed assertion against the code…</div>
									}
									else
									{
										<div class="rt-placeholder">Claude's assessment of Gemma's proposals will appear here.</div>
									}
									<h4>Read this carefully</h4>
									<ul class="rt-list warn">
										<li>Both model stages are <strong>opinions about tests that do not exist yet</strong>. The mutation score above is executed evidence; nothing below step 4 is.</li>
										<li>The only real proof is to write the proposed tests and re-run the mutation test. If the score does not move, the proposal did not work — whatever either model said about it.</li>
										<li>Claude reviewing Gemma is two models in agreement, not verification. It catches obvious errors; it cannot make an untested claim true.</li>
									</ul>
								</section>
							}
						}
					</section>
					break;
				case 26:
					<section>
						<p class="kicker">REAL DATA, NEVER COMMITTED</p>
						<h2 id="scene-title">The best test data is also the worst leak</h2>
						<p class="rt-intro">A test ticket built from real data reproduces the defect properly — and is a data-exfiltration path if it goes straight to a model. <strong>Not checked in is not the same as not sent.</strong> The gate runs first, the model sees only the scrubbed copy, and the audit record keeps references rather than payloads.</p>

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>Ephemeral test ticket</strong><small>real repro data · in-memory only</small></div></header>
							<textarea class="rt-code-input" spellcheck="false" maxlength="12000" @bind="_ephemeralTicket" @bind:event="oninput" disabled="@EphemeralBusy" aria-label="Ephemeral ticket"></textarea>
							<div class="rt-actions">
								<small>@_ephemeralTicket.Length / 12000</small>
								<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || _ephemeralTicket.Trim().Length < 20 || EphemeralBusy)" @onclick="RunEphemeral">@(!_bridgeConnected ? "Connect VSIX to run" : EphemeralBusy ? "Running…" : "Gate, then run")</button>
							</div>
							@if (!_bridgeConnected)
							{
								<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
							}
						</section>

						@if (_session?.Ephemeral.Gate is { } dataGate)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Pre-flight gate</strong><small>runs before anything leaves the boundary</small></div></header>
								<div class="audit-body">
									<div class="audit-scoreline">
										<span class="ctx-label decision-@dataGate.Decision.ToLowerInvariant().Replace("-", "")">@dataGate.Decision</span>
										<div><strong>@dataGate.TierName</strong><small>@dataGate.Findings.Count finding type(s)</small></div>
										<p>@dataGate.Rationale</p>
									</div>
									@if (_session.Ephemeral.Record is { } record)
									{
										<h4>Ephemeral record</h4>
										<table class="audit-table">
											<tbody>
												<tr><td>Ticket id</td><td>@record.TicketId</td></tr>
												<tr><td>Owner</td><td>@record.Owner</td></tr>
												<tr><td>Storage</td><td>@record.Storage</td></tr>
												<tr><td>Retention</td><td>@record.Ttl</td></tr>
												<tr><td>Logging</td><td>@record.LogPolicy</td></tr>
												<tr><td>Payload digest</td><td><code>@record.PayloadDigest</code></td></tr>
											</tbody>
										</table>
										@if (record.Purged.Count > 0)
										{
											<h4>Removed before the model saw it</h4>
											<ul class="rt-list warn">@foreach (var item in record.Purged) { <li>@item</li> }</ul>
										}
									}
								</div>
							</section>

							@if (_session.Ephemeral.Status == "blocked")
							{
								<div class="compare-status failed" role="alert"><strong>Blocked.</strong> Restricted content was found, so nothing was sent to a model. Redaction does not make credentials safe — the owner authorises handling first. This is the gate working, not a failure.</div>
							}
							else
							{
								<div class="rt-flow">
									<section class="rt-box">
										<header class="rt-head"><span class="rt-step">3</span><div><strong>What the model actually received</strong><small>scrubbed copy</small></div></header>
										<pre class="rt-code">@dataGate.Scrubbed</pre>
									</section>
									<section class="rt-box">
										<header class="rt-head"><span class="rt-step">4</span><div><strong>Reproduction plan</strong><small>@(_session.Ephemeral.AgentModel ?? "Gemma")</small></div></header>
										@if (!string.IsNullOrEmpty(_session.Ephemeral.AgentPlan))
										{
											<div class="rt-story">@_session.Ephemeral.AgentPlan</div>
										}
										else if (EphemeralBusy)
										{
											<div class="rt-pending"><span></span>Running the test against the scrubbed ticket…</div>
										}
										else
										{
											<div class="rt-placeholder">The plan will appear here — proving the test still works after scrubbing.</div>
										}
									</section>
								</div>
							}
						}
						@if (_session?.Ephemeral.Status == "failed")
						{
							<div class="compare-status failed" role="alert">@(_session?.Ephemeral.Error ?? "The ephemeral run did not complete.")</div>
						}
					</section>
					break;
				case 27:
					<section>
						<p class="kicker">DISCOVER WIDE, SCOPE NARROW, DESIGN DEEP</p>
						<h2 id="scene-title">Each tier answers a question the tier below it cannot</h2>
						<p class="rt-intro">Cortex maps the whole estate. An <strong>APM ID</strong> bounds what a team owns. A repository's <strong>/okf</strong> bundle is the atomic truth about its own code. The value is not that three tiers exist — it is that each one answers a question the others cannot, and loading them in the wrong order either misses services or buries the model in irrelevant context.</p>

						<div class="rt-actions">
							<small>Deterministic — no model call, works without the bridge.</small>
							<button class="primary-command compact" type="button" @onclick="RunPortfolio">Load the tiers</button>
						</div>

						@if (_portfolio is { } portfolio)
