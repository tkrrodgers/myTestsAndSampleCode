	private async Task Narrate(AutoStep step, string? observed)
	{
		var spoken = string.Join(" ", step.Facts);
		var source = "fact list (no model)";

		if (_autoProfile == AutoProfile.Full && _bridgeConnected && _session is not null)
		{
			Store.QueueNarration(_session.SessionId, step, observed);
			var deadline = DateTimeOffset.UtcNow.AddSeconds(20);
			while (DateTimeOffset.UtcNow < deadline && !_autoAbort)
			{
				_session = Store.GetSession(_session.SessionId);
				if (_session.Narration.Status is "completed" or "failed")
				{
					break;
				}

				await Task.Delay(400);
			}

			if (_session.Narration is { Status: "completed", Text: { } text })
			{
				spoken = text;
				source = _session.Narration.FallbackUsed
					? $"narrated by {_session.Narration.Model} — Gemma 4 was unavailable"
					: $"narrated by {_session.Narration.Model}";
			}
			else
			{
				source = "fact list (no model) — narration did not return in time";
			}
		}

		_autoNarration = spoken;
		_autoNarrationSource = source;
		await InvokeAsync(StateHasChanged);
		_speechNotice ??= Describe(await JS.InvokeAsync<string>("autopilot.speak", spoken, 1.0));
		await Task.Delay(Math.Min(12000, 1500 + spoken.Length * 55));
	}

	private AutoFail Fail(AutoStep step, string message, AutoFail policy)
	{
		_autoFailures++;
		_autoLog.Add(message);
		_autoNarration = $"This step did not complete. {message}. The run continues, and the failure is recorded rather than hidden.";
		_autoNarrationSource = "autopilot (deterministic)";
		return policy;
	}

	// Deferred to after render so the scroll lands on the new scene rather than the outgoing one.
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (_scrollPending)
		{
			_scrollPending = false;
			await JS.InvokeVoidAsync("trainingSpeech.scrollToTop");
		}
	}

	private static int SceneIndex(string id) => Array.FindIndex(Scenes, scene => scene.Id == id);

	// Cross-references resolve by scene id so inserting a scene cannot silently repoint every link.
	private RenderFragment SceneLink(string id) => builder =>
	{
		var index = SceneIndex(id);
		if (index < 0)
		{
			builder.AddContent(0, id);
			return;
		}

		builder.OpenElement(1, "button");
		builder.AddAttribute(2, "class", "scene-link");
		builder.AddAttribute(3, "type", "button");
		builder.AddAttribute(4, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => GoTo(index)));
		builder.AddContent(5, $"{index + 1}. {Scenes[index].Title}");
		builder.CloseElement();
	};
