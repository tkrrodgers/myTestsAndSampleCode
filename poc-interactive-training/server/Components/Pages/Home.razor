								<div class="know-grid">
									<div class="know-col learned"><p class="eyebrow">INSTRUCTIONS HONOURED</p><ul>@foreach (var item in patternReview.Followed) { <li>@item</li> }</ul></div>
									<div class="know-col unverified"><p class="eyebrow">INSTRUCTIONS SKIPPED</p><ul>@foreach (var item in patternReview.Ignored) { <li>@item</li> }</ul></div>
								</div>
								@if (patternReview.Risks.Count > 0)
