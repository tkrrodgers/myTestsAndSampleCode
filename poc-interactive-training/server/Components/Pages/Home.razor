								}
							</div>
						</section>

						<section class="rt-qa" data-auto="ls.verdict">
							<header class="rt-head"><span class="rt-step">5</span><div><strong>A blinded judge on the part a compiler cannot score</strong><small>@(ls?.Verdict?.JudgeModel ?? "Claude Opus 4.8 sees slot letters, never vendor names — and none of the contestants judges itself")</small></div></header>
							@if (ls?.Verdict is { } lsVerdict)
							{
								<p class="rt-reco">@lsVerdict.Summary</p>
								<table class="audit-table">
									<thead><tr><th>Slot</th><th>Revealed</th><th>Design score</th><th>Verdict</th><th>Strengths</th><th>Weaknesses</th></tr></thead>
									<tbody>
										@foreach (var judged in lsVerdict.Slots.OrderByDescending(s => s.DesignScore))
										{
											<tr>
												<td><strong>@judged.Slot</strong></td>
												<td>@(ls.SlotToModel.GetValueOrDefault(judged.Slot) ?? "?")</td>
												<td>@judged.DesignScore / 10</td>
												<td>@judged.Verdict</td>
												<td><ul class="rt-list good">@foreach (var item in judged.Strengths) { <li>@item</li> }</ul></td>
												<td><ul class="rt-list warn">@foreach (var item in judged.Weaknesses) { <li>@item</li> }</ul></td>
											</tr>
