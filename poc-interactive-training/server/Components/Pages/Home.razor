								}
								else if (!string.IsNullOrWhiteSpace(assessment.Scrubbed))
								{
									<h4>Scrubbed copy (safe to send)</h4>
									<pre class="rt-code">@assessment.Scrubbed</pre>
								}

								<h4>Incident path — @assessment.Incident.Severity</h4>
								<p class="rt-reco">@assessment.Incident.Summary</p>
								@if (assessment.Incident.Steps.Count > 0)
								{
									<ol class="rt-list warn">@foreach (var step in assessment.Incident.Steps) { <li>@step</li> }</ol>
									<dl class="verdict-meta"><dt>Owner</dt><dd>@assessment.Incident.Owner</dd><dt>SLA</dt><dd>@assessment.Incident.Sla</dd></dl>
								}
							</section>
						}
					</section>
					break;
				case 22:
					<section>
						<p class="kicker">HOW MUCH CONTEXT DOES THE CHEAP MODEL NEED?</p>
						<h2 id="scene-title">Same ticket, same code, three levels of documentation</h2>
						<p class="rt-intro">A real defect in <strong>@ContextTierSamples.RepoName</strong>: short puts are margined with the call formula. <strong>Gemma 4</strong> writes an implementation plan for it three times. The ticket, the prompt, the model and the <em>source code are byte-identical</em> every time — only the documentation around the code changes. Any difference in the plans is therefore attributable to context and nothing else.</p>

						@if (_session?.ContextCurve is { } curve)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>The ticket</strong><small>a real change, hard enough to need the rules</small></div></header>
								<div class="audit-body">
									<pre class="rt-code">@ContextTierSamples.Ticket</pre>
									<p class="ctx-method">Gemma is told to produce a markdown plan, never code. Planning is where missing context shows up as confident invention rather than a compiler error — which is exactly the failure teams do not catch.</p>
								</div>
							</section>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Three variants of the same repository</strong><small>identical source, different knowledge</small></div></header>
								<div class="repo-grid">
									@foreach (var variant in ContextTierSamples.Tiers)
									{
										var measured = curve.Tiers.FirstOrDefault(item => item.Id == variant.Id);
										<article class="repo-card">
											<h3>@variant.Label</h3>
											<p class="repo-diverge">@variant.Description</p>
											@if (measured is not null && measured.PromptTokens > 0)
											{
												<p class="repo-stats">@measured.PromptTokens.ToString("N0") prompt tokens</p>
											}
										</article>
									}
								</div>
								<div class="rt-actions">
									<small>@ContextTierSamples.Tiers.Count variants × @curve.RunsPerTier runs, then one comparative review. @(curve.TokensExact ? "Tokens counted with the Gemma tokenizer." : "Tokens estimated.")</small>
									<button class="primary-command compact" type="button" data-auto="s23.run" disabled="@(!_bridgeConnected || CurveBusy)" @onclick="RunCurve">@(!_bridgeConnected ? "Connect VSIX to run" : CurveBusy ? "Running…" : "Run all three")</button>
								</div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
