	private async Task StartAutopilot()
	{
		if (_autoRunning || _session is null)
		{
			return;
		}

		_autoRunning = true;
		_autoCompleted = false;
		_autoAbort = false;
		_autoFailures = 0;
		_autoStepIndex = 0;
		_autoLog.Clear();
		_autoRef ??= DotNetObjectReference.Create(this);
		await JS.InvokeVoidAsync("autopilot.registerAbort", _autoRef);

		var steps = AutopilotManifest.ForProfile(_autoProfile, AllowInProcessExecution).ToList();
		_autoTotal = steps.Count;

		var skipScene = -1;
		foreach (var step in steps)
		{
			if (_autoAbort)
			{
				break;
			}

			if (step.SceneNumber == skipScene)
			{
				continue;
			}

			skipScene = -1;
			_autoStepIndex++;

			if (_scene != step.SceneNumber - 1)
			{
				GoTo(step.SceneNumber - 1);
				await InvokeAsync(StateHasChanged);
				await Task.Delay(700);
			}

			var outcome = await RunAutoStep(step);
			if (outcome == AutoFail.AbortRun)
			{
				_autoStatus = "Aborted";
				break;
			}

			if (outcome == AutoFail.SkipScene)
			{
				skipScene = step.SceneNumber;
			}
		}

		await JS.InvokeVoidAsync("autopilot.clear");
		await JS.InvokeVoidAsync("autopilot.stopSpeaking");
		_autoStatus = _autoAbort ? $"Stopped by the presenter at step {_autoStepIndex} of {_autoTotal}" : $"Finished — {_autoFailures} step(s) did not complete";
		_autoRunning = false;
		_autoCompleted = true;
		await InvokeAsync(StateHasChanged);
	}

	private void StopAutopilot() => _autoAbort = true;

	private async Task<AutoFail> RunAutoStep(AutoStep step)
	{
		_autoStatus = $"Scene {step.SceneNumber} · {step.StepId}";
		await InvokeAsync(StateHasChanged);

		// Static narration is spoken before the action so the audience knows what is about to happen.
		if (!step.ResultNarration)
		{
			await Narrate(step, null);
		}

		var acted = true;
		if (step.Kind != AutoKind.Observe && step.Selector is { } selector)
		{
			await JS.InvokeVoidAsync("autopilot.highlight", selector);
			await Task.Delay(500);

			acted = step.Kind switch
			{
				AutoKind.Click => await JS.InvokeAsync<bool>("autopilot.click", selector),
				AutoKind.Select or AutoKind.Fill => await JS.InvokeAsync<bool>("autopilot.setValue", selector, step.Value),
				AutoKind.Scroll => await JS.InvokeAsync<bool>("autopilot.scrollTo", selector),
				_ => true
			};
		}

		if (!acted)
		{
			return Fail(step, $"{step.StepId}: control was missing or disabled", step.OnFailure);
		}

		var completed = await WaitForStep(step);
		if (!completed)
		{
			return Fail(step, $"{step.StepId}: did not complete within {step.TimeoutSeconds}s", step.OnTimeout);
		}

		if (step.ResultNarration)
		{
			await Narrate(step, ObservedValues(step));
		}

		await Task.Delay(900);
		return AutoFail.NarrateAndContinue;
	}

	private async Task<bool> WaitForStep(AutoStep step)
	{
		var deadline = DateTimeOffset.UtcNow.AddSeconds(step.TimeoutSeconds);
		switch (step.WaitType)
		{
			case AutoWait.Settle:
				await Task.Delay(TimeSpan.FromSeconds(Math.Min(step.TimeoutSeconds, 3)));
				return true;

			case AutoWait.Element:
				while (DateTimeOffset.UtcNow < deadline && !_autoAbort)
				{
					if (await JS.InvokeAsync<bool>("autopilot.exists", step.WaitKey!))
					{
						return true;
					}

					await Task.Delay(500);
				}

				return false;

			case AutoWait.State:
				while (DateTimeOffset.UtcNow < deadline && !_autoAbort)
				{
					_session = Store.GetSession(_session!.SessionId);
					var status = AutoStatus(step.WaitKey!);
					if (status is "completed" or "failed")
					{
						await InvokeAsync(StateHasChanged);
						return status == "completed";
					}

					await InvokeAsync(StateHasChanged);
					await Task.Delay(1000);
				}

				return false;
		}

		return true;
	}

