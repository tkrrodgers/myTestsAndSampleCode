							}
						</section>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">3</span><div><strong>Gemma 4 audit — overview &amp; gaps</strong><small>uses the context to find inconsistencies</small></div></header>
							@if (!string.IsNullOrEmpty(_session?.ContextAudit.GemmaOverview))
							{
								<div class="audit-body">
									<p class="rt-reco">@_session.ContextAudit.GemmaOverview</p>
