	// The Web Speech API reports success while producing no audio in several browsers:
	// speechSynthesis.speaking goes true and no event ever fires. "Supported" and "audible" are
	// different questions, and only the second one matters to a listener.
	private static string? Describe(string status) => status switch
	{
		"speaking" or "empty" => null,
		"stalled" => "The browser accepted the narration and then produced no audio. Check the tab is not muted (right-click the tab → Unmute site) and that the system output device is correct, then press play again. VS Code's embedded browser never plays speech at all — use Edge or Chrome.",
		"no-voices" => "No speech voices are installed in this browser, so narration produced silence. The narration text on screen is unaffected.",
		"unsupported" => "This browser does not implement speech synthesis. The narration text on screen is unaffected.",
		"silent" => "Narration did not start. Check the system output device and that the page is not muted.",
		_ => $"Narration did not start ({status})."
	};
	private async Task CopyToken() => await JS.InvokeVoidAsync("trainingSpeech.copy", _session?.BridgeToken ?? string.Empty);

	public ValueTask DisposeAsync()
	{
		Room.Changed -= OnRoomChanged;
		_pollCancellation.Cancel();
		_timer?.Dispose();
		_pollCancellation.Dispose();
		return ValueTask.CompletedTask;
	}
