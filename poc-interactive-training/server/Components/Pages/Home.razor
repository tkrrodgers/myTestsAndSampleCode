							<div class="rt-actions">
								<small>@_contextCode.Length / 16000</small>
								<button class="primary-command compact" type="button" data-auto="s15.run" disabled="@(!_bridgeConnected || _contextCode.Trim().Length < 20 || ContextBusy)" @onclick="RunContextAudit">@ContextButtonText</button>
							</div>
							@if (!_bridgeConnected)
							{
								<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before auditing.</p>
