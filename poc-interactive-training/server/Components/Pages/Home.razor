		? "Connect VSIX to run"
		: MigrationBusy ? "Migrating…" : "Run all three arms";
	private static string GroundingLabel(string grounding) => grounding switch
	{
		"none" => "no grounding — COBOL source only",
		"structural" => "AST / DDG / PDG artifacts",
		_ => "facts resolved by the COBOL compiler"
	};

	protected override void OnInitialized()
	{
		_session = Store.CreateSession();
		_timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
		_ = PollAsync();
	}

	private async Task PollAsync()
	{
		try
		{
			while (_timer is not null && await _timer.WaitForNextTickAsync(_pollCancellation.Token))
			{
				if (_session is null) continue;
				var previousReview = _session.ReviewStatus;
				_session = Store.GetSession(_session.SessionId);
				_bridgeConnected = Store.IsBridgeConnected(_session.SessionId);
				await InvokeAsync(StateHasChanged);
				if (previousReview != "completed" && _session.ReviewStatus == "completed") await JS.InvokeVoidAsync("trainingSpeech.focus", "review-feedback");
			}
		}
		catch (OperationCanceledException) { }
	}

	private void StartLesson() { if (_session is null) return; _started = true; Store.QueueCoach(_session.SessionId); }
	private void SubmitReview() { if (_session is null) return; Store.QueueReview(_session.SessionId, _learnerPrompt.Trim()); _session = Store.GetSession(_session.SessionId); }
	private void RunComparison() { if (_session is null || string.IsNullOrEmpty(_comparisonTopicId)) return; Store.QueueComparison(_session.SessionId, _comparisonTopicId); _session = Store.GetSession(_session.SessionId); }
	private void RunRoundTrip() { if (_session is null || _roundTripClass.Trim().Length < 20) return; Store.QueueRoundTrip(_session.SessionId, _roundTripClass.Trim()); _session = Store.GetSession(_session.SessionId); }
	private void RunModernize() { if (_session is null || _legacyCode.Trim().Length < 20) return; Store.QueueModernize(_session.SessionId, _legacyCode.Trim()); _session = Store.GetSession(_session.SessionId); }
	private void RunAudit() { if (_session is null || _auditCode.Trim().Length < 20) return; Store.QueueAudit(_session.SessionId, _auditCode.Trim()); _session = Store.GetSession(_session.SessionId); }
	private void RunContextAudit() { if (_session is null || _contextCode.Trim().Length < 20) return; Store.QueueContextAudit(_session.SessionId, _contextCode.Trim()); _session = Store.GetSession(_session.SessionId); }
	private void RunClaraPoc() { if (_session is null || _claraJira.Trim().Length < 20) return; Store.QueueClaraPoc(_session.SessionId, _claraJira.Trim()); _session = Store.GetSession(_session.SessionId); }
	private void RunLanguageTest() { if (_session is null || _languageJira.Trim().Length < 20) return; Store.QueueLanguageTest(_session.SessionId, _languageJira.Trim()); _session = Store.GetSession(_session.SessionId); }
	private void RunMigration() { if (_session is null) return; Store.QueueMigration(_session.SessionId); _session = Store.GetSession(_session.SessionId); }

	private async Task RunBenchmark()
	{
		if (_benchmarkRunning) return;
		_benchmarkRunning = true;
		try
		{
			var measured = await Task.Run(() => (Conformance: ClaraConformance.Run(), Benchmark: Benchmark.Run()));
			_conformance = measured.Conformance;
			_benchmark = measured.Benchmark;
		}
		finally
		{
			_benchmarkRunning = false;
		}
	}
	private void Answer(int question, int option) => _answers[question] = option;
	private string? AnswerClass(int question, int option) => !_answers.TryGetValue(question, out var selected) || selected != option ? null : Questions[question].CorrectIndex == option ? "correct" : "incorrect";
	private void GoTo(int scene) => _scene = Math.Clamp(scene, 0, Scenes.Length - 1);
	private void ToggleDrawer() => _drawerOpen = !_drawerOpen;	private void Next() => GoTo(_scene + 1);
	private void Previous() => GoTo(_scene - 1);
	private void ReplayAnimation() => _animationRun++;
	private async Task Speak() => await JS.InvokeVoidAsync("trainingSpeech.speak", CurrentNarration);
	private async Task StopSpeaking() => await JS.InvokeVoidAsync("trainingSpeech.stop");
	private async Task CopyToken() => await JS.InvokeVoidAsync("trainingSpeech.copy", _session?.BridgeToken ?? string.Empty);

	public ValueTask DisposeAsync()
	{
		_pollCancellation.Cancel();
		_timer?.Dispose();
		_pollCancellation.Dispose();
		return ValueTask.CompletedTask;
	}
}
