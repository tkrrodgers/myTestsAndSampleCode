									<div class="rt-pending cc-progress" role="status" aria-live="polite" data-auto="fx.progress">
										<span></span>
										<div>
											<strong>@FocusProgressHeadline</strong>
											<small>@FocusProgressDetail</small>
										</div>
									</div>
								}

								@if (fx?.Arms.Count > 0)
								{
									var fxA = fx.Arms.FirstOrDefault(a => a.Arm == "A");
									<table class="audit-table" data-auto="fx.results">
										<thead><tr><th>Arm</th><th>What Claude received</th><th>Prompt tokens</th><th>vs A</th><th>Output tokens</th><th>vs A</th><th>Illustrative cost</th><th>vs A</th><th>Compiled</th><th>Cases</th><th>Crypto terms in code</th><th>Status</th></tr></thead>
										<tbody>
											@foreach (var arm in fx.Arms)
											{
												<tr class="@(arm.Status == "completed" && arm.Passed == ClassifyContextSamples.TestVectors.Length ? "p0-opt" : arm.Status is "completed" or "failed" ? "p0-req" : null)">
