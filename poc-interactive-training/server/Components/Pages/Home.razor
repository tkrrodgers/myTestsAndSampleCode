	private static string Delta(int? baseline, int value, bool isBaseline)
	{
		if (isBaseline || baseline is null or 0) return "—";
		var percent = (int)Math.Round(100.0 * (value - baseline.Value) / baseline.Value);
		return percent == 0 ? "same" : percent < 0 ? $"{-percent}% less" : $"{percent}% more";
	}

	// Illustrative frontier rates from the token-economics scene; output is weighted ~5x input.
	private static decimal ArmCost(ImplementationArm arm) =>
		arm.PromptTokens / 1_000_000m * TokenEconomicsService.VendorInputPerMillion
		+ arm.OutputTokens / 1_000_000m * TokenEconomicsService.VendorOutputPerMillion;

	private static string CostDelta(ImplementationArm baseline, ImplementationArm arm)
	{
		if (arm.Arm == baseline.Arm) return "—";
		var a = ArmCost(baseline);
		if (a == 0) return "—";
		var percent = (int)Math.Round(100m * (ArmCost(arm) - a) / a);
		return percent == 0 ? "same" : percent < 0 ? $"{-percent}% cheaper" : $"{percent}% dearer";
	}

