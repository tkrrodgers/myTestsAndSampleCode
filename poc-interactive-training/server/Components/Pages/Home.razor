												<td><span class="src-tag src-@step.Source">@(step.Source switch { "own" => "Claude", "gemini" => "Gemini + verified", _ => "needs verification" })</span></td>
											</tr>
										}
									</tbody>
								</table>
								@if (!string.IsNullOrWhiteSpace(design.ProvenanceNote))
								{
									<h4>Before this design is trusted</h4><p class="rt-reco">@design.ProvenanceNote</p>
								}
							}
							else if (_session?.LlmSupport.Status == "synthesizing")
							{
								<div class="rt-pending"><span></span>Claude is producing the grounded migration design…</div>
							}
							else
							{
								<div class="rt-placeholder">The final, source-tagged migration design will appear here.</div>
							}
							@if (_session?.LlmSupport.Status == "failed")
							{
								<div class="compare-status failed" role="alert">@(_session?.LlmSupport.Error ?? "The demo did not complete.")</div>
							}
						</section>
					</section>
					break;
				case 10:
					<section>
						<p class="kicker">GROUNDING ROUND TRIP</p>
