	private void Answer(int question, int option) => _answers[question] = option;
	private string? AnswerClass(int question, int option) => !_answers.TryGetValue(question, out var selected) || selected != option ? null : Questions[question].CorrectIndex == option ? "correct" : "incorrect";
	private void GoTo(int scene) => _scene = Math.Clamp(scene, 0, Scenes.Length - 1);

	private static int SceneIndex(string id) => Array.FindIndex(Scenes, scene => scene.Id == id);

	// Cross-references resolve by scene id so inserting a scene cannot silently repoint every link.
	private RenderFragment SceneLink(string id) => builder =>
	{
		var index = SceneIndex(id);
		if (index < 0)
		{
			builder.AddContent(0, id);
			return;
		}

		builder.OpenElement(1, "button");
		builder.AddAttribute(2, "class", "scene-link");
		builder.AddAttribute(3, "type", "button");
		builder.AddAttribute(4, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => GoTo(index)));
		builder.AddContent(5, $"{index + 1}. {Scenes[index].Title}");
		builder.CloseElement();
	};
