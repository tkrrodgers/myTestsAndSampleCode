							</div>
						</section>

						@if (_assessment is { } assessment)
						{
							<section class="rt-qa" data-auto="s22.tier-decision">
								<header class="rt-head"><span class="rt-step">4</span><div><strong>Decision &amp; incident path</strong><small>severity, containment, owner, SLA</small></div></header>
								<div class="audit-scoreline">
									<span class="ctx-label decision-@assessment.Decision.ToLowerInvariant().Replace("-", "")">@assessment.Decision</span>
									<div><strong>@assessment.TierName</strong><small>highest tier detected</small></div>
									<p>@assessment.Rationale</p>
								</div>

								@if (assessment.Findings.Count > 0)
								{
									<h4>Findings</h4>
