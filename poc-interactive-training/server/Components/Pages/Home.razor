									<div>
										<button class="secondary-command compact" type="button" disabled="@(!_bridgeConnected || DriftBusy)" @onclick="() => RunDrift(true)">Score the control</button>
										<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || DriftBusy)" @onclick="() => RunDrift(false)">@(DriftBusy ? "Scoring…" : "Score the agent patch")</button>
									</div>
								</div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">The structural layer below works without the bridge. Connect the VSIX to add the semantic layer.</p>
								}
							</section>

							@if (drift.Structural is { } structural)
							{
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">3</span><div><strong>Structural layer</strong><small>deterministic · diffed against the human patch</small></div></header>
									<div class="@(structural.Score == 100 ? "compare-status" : "compare-status failed")" role="status">
										Structural score @structural.Score / 100
									</div>
									<table class="audit-table">
										<thead><tr><th>Check</th><th>Held</th><th>Detail</th></tr></thead>
										<tbody>
											@foreach (var finding in structural.Findings)
											{
												<tr><td>@finding.Name</td><td>@(finding.Present ? "yes" : "no")</td><td>@finding.Detail</td></tr>
											}
										</tbody>
									</table>
									<h4>Functional layer — the verification oracle</h4>
									<ul class="rt-list">@foreach (var check in DriftSamples.Oracle) { <li>@check.Name — <code>@check.Assertion</code></li> }</ul>
								</section>
							}

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">4</span><div><strong>Semantic layer</strong><small>@(drift.Semantic?.Model ?? "Claude Opus 5") · goal fidelity and scope discipline</small></div></header>
								@if (drift.Semantic is { } semantic)
								{
									<div class="clara-signature">
										Goal fidelity <strong>@semantic.GoalFidelity/5</strong> · scope discipline <strong>@semantic.ScopeDiscipline/5</strong>
									</div>
									<p class="rt-reco">@semantic.Verdict</p>
									@if (semantic.Deviations.Count > 0)
									{
										<h4>Departures from the ticket</h4>
										<ul class="rt-list warn">@foreach (var item in semantic.Deviations) { <li>@item</li> }</ul>
									}
									<h4>Read this carefully</h4>
									<ul class="rt-list warn">
										<li>One golden case. A drift programme needs 30–50; this proves the scorecard, not the trend.</li>
										<li>Drift is measured over time. A single score is a reading, not a direction.</li>
										<li>The functional and structural layers are reproducible. The semantic layer is a model's opinion and should be anchored to a human-labelled gold set before anyone acts on it.</li>
									</ul>
								}
								else if (DriftBusy)
								{
									<div class="rt-pending"><span></span>Claude is assessing goal fidelity and scope discipline…</div>
								}
								else if (drift.Status == "failed")
								{
									<div class="compare-status failed" role="alert">@(drift.Error ?? "The review did not complete.")</div>
								}
								else
								{
									<div class="rt-placeholder">The semantic assessment will appear here.</div>
								}
							</section>
						}
					</section>
					break;
				case 20:
					<section>
						<p class="kicker">PHASE 0 — BEFORE ANY OF THIS IS SAFE</p>
						<h2 id="scene-title">Name it, tier it, and gate what it sees</h2>
						<p class="rt-intro">You cannot monitor a population you have not enumerated, and "not checked in" does not mean "not sent to a model". These three controls are prerequisites, not follow-ups — so they are <strong>fully deterministic and run with no model at all</strong>. If the bridge is down, the gate still holds.</p>

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>Register the agent</strong><small>risk tier derived from blast radius × autonomy × data tier</small></div></header>
							<div class="p0-form">
								<label>Name<input type="text" @bind="_agent.Name" /></label>
								<label>Owner<input type="text" @bind="_agent.Owner" /></label>
								<label>Release id<input type="text" @bind="_agent.ReleaseId" /></label>
								<label>Model (pinned)<input type="text" @bind="_agent.Model" /></label>
								<label>Blast radius<select @bind="_agent.BlastRadius">@foreach (var level in AgentRegistryService.BlastRadiusLevels) { <option value="@level">@level</option> }</select></label>
								<label>Autonomy<select @bind="_agent.Autonomy">@foreach (var level in AgentRegistryService.AutonomyLevels) { <option value="@level">@level</option> }</select></label>
								<label>Data tier<select @bind="_agent.DataTier">@foreach (var level in AgentRegistryService.DataTiers) { <option value="@level">@level</option> }</select></label>
								<label>Status<select @bind="_agent.AgentStatus">@foreach (var level in AgentRegistryService.AgentStatuses) { <option value="@level">@level</option> }</select></label>
								<label class="p0-check"><input type="checkbox" @bind="_agent.ToolEnabled" /> Tool-enabled (can take actions)</label>
								@if (_agent.ToolEnabled)
								{
									<label>Runtime identity<input type="text" @bind="_agent.RuntimeIdentity" /></label>
									<label>Action policy<input type="text" @bind="_agent.ActionPolicy" /></label>
									<label>Approval mode<input type="text" @bind="_agent.ApprovalMode" /></label>
								}
							</div>
							<div class="rt-actions">
								<small>Deterministic — no model call.</small>
								<button class="primary-command compact" type="button" @onclick="RunTiering">Tier this agent</button>
							</div>
						</section>

						@if (_tier is { } tier)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Risk tier &amp; controls owed</strong><small>10 §4–5 · proportionate, read as a budget</small></div></header>
								<div class="audit-body">
									<div class="audit-scoreline">
										<span class="ctx-label tier-r@tier.Tier">R@tier.Tier</span>
										<div><strong>@tier.TierName</strong><small>review cadence: @tier.ReviewCadence</small></div>
									</div>
									@if (!tier.Registrable)
									{
										<div class="compare-status failed" role="alert"><strong>Not registrable.</strong> Missing non-negotiable fields: @string.Join(", ", tier.MissingFields). Without these you cannot reproduce, tier, authorize, or stop this release.</div>
									}
									<h4>Why this tier</h4>
									<ul class="rt-list warn">@foreach (var reason in tier.Reasons) { <li>@reason</li> }</ul>
									<h4>Controls owed</h4>
									<table class="audit-table">
										<thead><tr><th>Control</th><th>This agent</th></tr></thead>
										<tbody>
											@foreach (var control in tier.Controls)
											{
												<tr class="@(control.Required ? "p0-req" : "p0-opt")"><td>@control.Control</td><td>@control.Requirement</td></tr>
											}
										</tbody>
									</table>
									<p class="ctx-method">R3 is a risk label, not permission to run autonomously.</p>
								</div>
							</section>
						}

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">3</span><div><strong>Data-tier gate</strong><small>correction C4 · what may leave the boundary</small></div></header>
							<textarea class="rt-code-input" spellcheck="false" maxlength="12000" @bind="_testPayload" @bind:event="oninput" aria-label="Ephemeral test payload"></textarea>
							<div class="rt-actions">
								<small>@_testPayload.Length / 12000 · deterministic scan</small>
								<button class="primary-command compact" type="button" @onclick="RunDataTier">Classify before sending</button>
							</div>
						</section>

						@if (_assessment is { } assessment)
						{
							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">4</span><div><strong>Decision &amp; incident path</strong><small>severity, containment, owner, SLA</small></div></header>
								<div class="audit-scoreline">
									<span class="ctx-label decision-@assessment.Decision.ToLowerInvariant().Replace("-", "")">@assessment.Decision</span>
									<div><strong>@assessment.TierName</strong><small>highest tier detected</small></div>
									<p>@assessment.Rationale</p>
								</div>

								@if (assessment.Findings.Count > 0)
								{
									<h4>Findings</h4>
									<table class="audit-table">
										<thead><tr><th>Pattern</th><th>Category</th><th>Count</th><th>Sample</th></tr></thead>
										<tbody>
											@foreach (var finding in assessment.Findings)
											{
												<tr><td>@finding.Label</td><td>@finding.Category</td><td>@finding.Count</td><td><code>@finding.Sample</code></td></tr>
											}
										</tbody>
									</table>
								}

								@if (assessment.Decision == "BLOCK")
								{
									<div class="compare-status failed" role="alert">Scrubbed output withheld deliberately. Restricted content is not made safe by redaction — the owner must authorise handling first.</div>
								}
								else if (!string.IsNullOrWhiteSpace(assessment.Scrubbed))
								{
									<h4>Scrubbed copy (safe to send)</h4>
									<pre class="rt-code">@assessment.Scrubbed</pre>
								}

								<h4>Incident path — @assessment.Incident.Severity</h4>
								<p class="rt-reco">@assessment.Incident.Summary</p>
								@if (assessment.Incident.Steps.Count > 0)
								{
									<ol class="rt-list warn">@foreach (var step in assessment.Incident.Steps) { <li>@step</li> }</ol>
									<dl class="verdict-meta"><dt>Owner</dt><dd>@assessment.Incident.Owner</dd><dt>SLA</dt><dd>@assessment.Incident.Sla</dd></dl>
								}
							</section>
						}
					</section>
					break;
				case 21:
					<section>
						<p class="kicker">HOW MUCH CONTEXT DOES THE CHEAP MODEL NEED?</p>
						<h2 id="scene-title">Same ticket, same code, three levels of documentation</h2>
						<p class="rt-intro">A real defect in <strong>@ContextTierSamples.RepoName</strong>: short puts are margined with the call formula. <strong>Gemma 4</strong> writes an implementation plan for it three times. The ticket, the prompt, the model and the <em>source code are byte-identical</em> every time — only the documentation around the code changes. Any difference in the plans is therefore attributable to context and nothing else.</p>

						@if (_session?.ContextCurve is { } curve)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>The ticket</strong><small>a real change, hard enough to need the rules</small></div></header>
								<div class="audit-body">
									<pre class="rt-code">@ContextTierSamples.Ticket</pre>
									<p class="ctx-method">Gemma is told to produce a markdown plan, never code. Planning is where missing context shows up as confident invention rather than a compiler error — which is exactly the failure teams do not catch.</p>
								</div>
							</section>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Three variants of the same repository</strong><small>identical source, different knowledge</small></div></header>
								<div class="repo-grid">
									@foreach (var variant in ContextTierSamples.Tiers)
									{
										var measured = curve.Tiers.FirstOrDefault(item => item.Id == variant.Id);
										<article class="repo-card">
											<h3>@variant.Label</h3>
											<p class="repo-diverge">@variant.Description</p>
											@if (measured is not null && measured.PromptTokens > 0)
											{
												<p class="repo-stats">@measured.PromptTokens.ToString("N0") prompt tokens</p>
											}
										</article>
									}
								</div>
								<div class="rt-actions">
									<small>@ContextTierSamples.Tiers.Count variants × @curve.RunsPerTier runs, then one comparative review. @(curve.TokensExact ? "Tokens counted with the Gemma tokenizer." : "Tokens estimated.")</small>
									<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || CurveBusy)" @onclick="RunCurve">@(!_bridgeConnected ? "Connect VSIX to run" : CurveBusy ? "Running…" : "Run all three")</button>
								</div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
								}
							</section>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>What Gemma produced</strong><small>median of @curve.RunsPerTier runs · scored against sealed criteria it never sees</small></div></header>
								<div class="audit-body">
									<table class="audit-table">
										<thead><tr><th>Variant</th><th>Prompt tokens</th><th>Median</th><th>Range</th><th>Criteria met</th><th>Progress</th></tr></thead>
										<tbody>
											@foreach (var tierRow in curve.Tiers)
											{
												var done = tierRow.Runs.Count(run => run.Status is "completed" or "failed");
												<tr class="@(curve.Degradation is { } d && tierRow.Id == d.BestTier ? "curve-plateau" : null)">
													<td>@tierRow.Label</td>
													<td>@tierRow.PromptTokens.ToString("N0")</td>
													<td><strong>@tierRow.MedianScore</strong></td>
													<td>@(done > 0 ? $"{tierRow.WorstScore}–{tierRow.BestScore}" : "—")</td>
													<td>@tierRow.MedianMet.Count / @ContextTierSamples.Criteria.Count</td>
													<td><div class="audit-bar"><i style="width:@tierRow.MedianScore%"></i></div><small>@done / @curve.RunsPerTier runs</small></td>
												</tr>
											}
										</tbody>
									</table>
									@if (CurveBusy)
									{
										<div class="rt-pending"><span></span>Running every variant. The repetition is deliberate — one score on a stochastic system is a reading, not a direction.</div>
									}
								</div>
							</section>

							@foreach (var tierDetail in curve.Tiers.Where(item => item.Runs.Any(run => run.Status == "completed")))
							{
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">·</span><div><strong>@tierDetail.Label</strong><small>@tierDetail.MedianScore / 100 · @tierDetail.PromptTokens.ToString("N0") tokens</small></div></header>
									<div class="audit-body">
										@if (tierDetail.MedianMissed.Count > 0)
										{
											<h4>Missed at this tier</h4>
											<ul class="rt-list warn">@foreach (var name in tierDetail.MedianMissed) { <li>@name</li> }</ul>
										}
										@{
											var shown = tierDetail.Runs.FirstOrDefault(run => run.Status == "completed" && run.Score == tierDetail.MedianScore)
														?? tierDetail.Runs.First(run => run.Status == "completed");
										}
										<h4>Gemma's plan</h4>
										<pre class="rt-code">@shown.Plan</pre>
									</div>
								</section>
							}

							@if (curve.Degradation is { } degradation)
							{
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">4</span><div><strong>The degradation</strong><small>deterministic · no model produced these numbers</small></div></header>
									<div class="know-grid">
										<div class="know-col learned"><p class="eyebrow">BEST</p><ul><li>@degradation.BestTier</li></ul></div>
										<div class="know-col unverified"><p class="eyebrow">WORST</p><ul><li>@degradation.WorstTier — @degradation.Drop points lower</li></ul></div>
										<div class="know-col own"><p class="eyebrow">FLOOR</p><ul><li>@degradation.FloorTier is the weakest variant still within 80% of the best. Below it, do not run the cheap model unattended.</li></ul></div>
									</div>
									<p class="rt-reco">@degradation.Note</p>
									@if (degradation.LostCriteria.Count > 0)
									{
										<h4>Lost when the documentation was removed</h4>
										<ul class="rt-list warn">@foreach (var name in degradation.LostCriteria) { <li>@name</li> }</ul>
									}
									<h4>Sealed criteria</h4>
									<ul class="rt-list good">@foreach (var criterion in ContextTierSamples.Criteria) { <li><strong>@criterion.Name</strong> — @criterion.Description <em>(derivable from @ContextTierSamples.Tiers[criterion.UnlockedAtTier].Label onwards)</em></li> }</ul>
									<p class="ctx-method">Scored by keyword detection against criteria the planning model never sees. It is reproducible and trendable, but it rewards saying the right words — which is why a judgement layer follows rather than replaces it.</p>
								</section>
							}

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">@(curve.Degradation is null ? "4" : "5")</span><div><strong>Claude Opus 4.8 reviews all three</strong><small>@(curve.JudgeModel ?? "Claude Opus 4.8") · engineering substance, not keywords</small></div></header>
								@if (curve.Verdict is { } curveVerdict)
								{
									<p class="rt-reco">@curveVerdict.Summary</p>
									<table class="audit-table">
										<thead><tr><th>Variant</th><th>Correctness</th><th>Grounding</th><th>Assessment</th></tr></thead>
										<tbody>
											@foreach (var judged in curveVerdict.Tiers)
											{
												<tr>
													<td>@judged.Tier</td>
													<td>@judged.Correctness/5</td>
													<td>@judged.Grounding/5</td>
													<td>@judged.Assessment</td>
												</tr>
											}
										</tbody>
									</table>
									@foreach (var judged in curveVerdict.Tiers.Where(item => item.Errors.Count > 0))
									{
										<h4>Factual errors in @judged.Tier</h4>
										<ul class="rt-list warn">@foreach (var error in judged.Errors) { <li>@error</li> }</ul>
									}
									@if (curveVerdict.DegradationEvidence.Count > 0)
									{
										<h4>What was actually lost</h4>
										<ul class="rt-list warn">@foreach (var item in curveVerdict.DegradationEvidence) { <li>@item</li> }</ul>
									}
									@if (!string.IsNullOrWhiteSpace(curveVerdict.MinimumViableContext))
									{
										<h4>Minimum context a team must maintain</h4>
										<p class="rt-reco">@curveVerdict.MinimumViableContext</p>
									}
									@if (!string.IsNullOrWhiteSpace(curveVerdict.Caveat))
									{
										<h4>What this does not establish</h4>
										<p class="ctx-method">@curveVerdict.Caveat</p>
									}
								}
								else if (curve.Status == "judging")
								{
									<div class="rt-pending"><span></span>Claude is comparing the three plans against the ground truth…</div>
								}
								else if (curve.Error is { } curveError)
								{
									<div class="compare-status failed" role="alert">@curveError</div>
								}
								else
								{
									<div class="rt-placeholder">The comparative review will appear here once all three variants have run.</div>
								}
								<h4>Read this carefully</h4>
								<ul class="rt-list warn">
									<li>One ticket on one repository. This shows the shape of the effect, not its size across your estate — measure your own before quoting a number.</li>
									<li>The deterministic score rewards vocabulary. Claude's correctness rating is the check on that, and it is a model's opinion, not a validated grade.</li>
									<li>The undocumented variant is not empty — it is <em>wrong</em>. Stale documentation is the expensive failure mode, because the model has no way to know it is stale.</li>
								</ul>
							</section>
						}
					</section>
					break;
				case 22:
					<section>
						<p class="kicker">AUTHORITY IS PER ACTION, NOT PER AGENT</p>
						<h2 id="scene-title">"Approve deploy" is not approval</h2>
						<p class="rt-intro">An autonomous agent may proceed without per-call approval <em>only</em> on reversible actions inside its registered envelope. Everything else stops for a verified human decision. This uses the same registration you tiered in Phase 0 — change the agent there and the answers here change with it.</p>

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>Proposed action</strong><small>agent: @_agent.Name · autonomy: @_agent.Autonomy</small></div></header>
							<div class="p0-form">
								<label>Action<select @bind="_selectedActionId">@foreach (var action in ActionAuthorityService.Catalog) { <option value="@action.Id">@action.Description</option> }</select></label>
							</div>
							<div class="rt-actions">
								<small>Deterministic — no model call.</small>
								<button class="primary-command compact" type="button" @onclick="RunAuthority">Decide authority</button>
							</div>
						</section>

						@if (_decision is { } decision)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Decision</strong><small>09 §3.4 · 10 §5</small></div></header>
								<div class="audit-body">
									<div class="audit-scoreline">
										<span class="ctx-label verdict-@decision.Verdict.ToLowerInvariant()">@decision.Verdict</span>
										<div><strong>@decision.VerdictLabel</strong><small>@decision.Description</small></div>
									</div>
									<h4>Why</h4>
									<ul class="rt-list warn">@foreach (var reason in decision.Reasons) { <li>@reason</li> }</ul>
									<h4>Exact-action checks the approver must make</h4>
									<ol class="rt-list good">@foreach (var check in decision.ExactActionChecks) { <li>@check</li> }</ol>
								</div>
							</section>

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>Intervention path</strong><small>@decision.Intervention.Severity</small></div></header>
								<p class="rt-reco">@decision.Intervention.Summary</p>
								@if (decision.Intervention.Steps.Count > 0)
								{
									<ol class="rt-list warn">@foreach (var step in decision.Intervention.Steps) { <li>@step</li> }</ol>
									<dl class="verdict-meta"><dt>Owner</dt><dd>@decision.Intervention.Owner</dd><dt>SLA</dt><dd>@decision.Intervention.Sla</dd></dl>
								}
								<p class="ctx-method">The client enforces this too: set <code>pocTraining.requireApproval</code> to make every task stop at this gate.</p>
							</section>
						}
					</section>
					break;
				case 23:
					<section>
						<p class="kicker">THE BIAS YOU BRING</p>
						<h2 id="scene-title">The same question, asked three ways</h2>
						<p class="rt-intro">Engineers police what the model gets wrong and rarely notice how their own framing manufactured the answer. One question goes to one model three times — <strong>leading</strong>, <strong>neutral</strong>, and <strong>dissent-demanded</strong>. Divergence from the neutral answer is measured with embeddings <em>before</em> any model offers an opinion about it.</p>

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>Your question</strong><small>asked identically except for the framing</small></div></header>
							<textarea class="rt-code-input" spellcheck="false" maxlength="4000" @bind="_framingQuestion" @bind:event="oninput" disabled="@FramingBusy" aria-label="Question"></textarea>
							<div class="rt-actions">
								<small>@_framingQuestion.Length / 4000</small>
								<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || _framingQuestion.Trim().Length < 10 || FramingBusy)" @onclick="RunFraming">@(!_bridgeConnected ? "Connect VSIX to run" : FramingBusy ? "Asking…" : "Ask all three ways")</button>
							</div>
							@if (!_bridgeConnected)
							{
								<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
							}
						</section>

						@if (_session?.Framing.Arms.Count > 0)
						{
							<div class="compare-columns">
								@foreach (var arm in _session.Framing.Arms)
								{
									<article class="compare-col @(arm.Id == "neutral" ? "winner" : null)">
										<header class="compare-col-head">
											<span class="slot-badge">@arm.Label</span>
											<strong>@(arm.ModelUsed ?? "Claude")</strong>
											<small>@arm.Framing</small>
										</header>
										@if (arm.Status == "completed")
										{
											<div class="answer-body">@arm.Answer</div>
											<div class="answer-metrics">
												<span class="coverage">@(arm.Id == "neutral" ? "baseline" : $"similarity to neutral {arm.SimilarityToNeutral:0.00}")</span>
											</div>
										}
										else if (arm.Status == "failed")
										{
											<div class="answer-failed">@arm.Error</div>
										}
										else
										{
											<div class="answer-pending"><span></span>Asking…</div>
										}
									</article>
								}
							</div>
						}

						@if (_session?.Framing.Verdict is { } framingVerdict)
						{
							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Did the framing change the substance?</strong><small>reviewed by @_session.Framing.JudgeModel</small></div></header>
								<div class="audit-scoreline">
									<span class="ctx-label @(framingVerdict.SubstanceChanged ? "ctx-poor" : "ctx-rich")">@(framingVerdict.SubstanceChanged ? "CHANGED" : "HELD")</span>
									<p>@framingVerdict.Summary</p>
								</div>
								@if (framingVerdict.Differences.Count > 0)
								{
									<h4>Substantive divergences</h4><ul class="rt-list warn">@foreach (var difference in framingVerdict.Differences) { <li>@difference</li> }</ul>
								}
								@if (!string.IsNullOrWhiteSpace(framingVerdict.Recommendation))
								{
									<h4>How to ask next time</h4><p class="rt-reco">@framingVerdict.Recommendation</p>
								}
							</section>
						}
						else if (FramingBusy)
						{
							<div class="rt-pending"><span></span>Collecting all three answers before comparing them…</div>
						}
						@if (_session?.Framing.Status == "failed")
						{
							<div class="compare-status failed" role="alert">@(_session?.Framing.Error ?? "The framing lab did not complete.")</div>
						}
					</section>
					break;
				case 24:
					<section>
						<p class="kicker">GREEN TESTS ARE NOT COVERAGE</p>
						<h2 id="scene-title">Does the suite cover the risk this change adds?</h2>
						<p class="rt-intro">The fixture is <strong>compiled and executed</strong>, then one deliberate defect is injected at a time and the tests are run again. A defect the tests fail to notice is a defect the suite would have shipped. No model is involved in the verdict — this is executed evidence, like the COBOL oracle.</p>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>The enhancement</strong><small>what the change is meant to add</small></div></header>
							<div class="audit-body"><pre class="rt-code">@RegressionSamples.Enhancement</pre></div>
						</section>

						<div class="rt-flow">
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Code under test</strong><small>editable</small></div></header>
								<textarea class="rt-code-input" spellcheck="false" maxlength="8000" @bind="_regressionSource" @bind:event="oninput" disabled="@_mutationRunning" aria-label="Source"></textarea>
							</section>
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>Existing test suite</strong><small>currently passing</small></div></header>
								<textarea class="rt-code-input" spellcheck="false" maxlength="8000" @bind="_regressionTests" @bind:event="oninput" disabled="@_mutationRunning" aria-label="Tests"></textarea>
							</section>
						</div>

						<div class="rt-actions">
							<small>Deterministic — compiles and runs in-process, no model call.</small>
							<button class="primary-command compact" type="button" disabled="@_mutationRunning" @onclick="RunMutation">@(_mutationRunning ? "Running mutants…" : "Run mutation test")</button>
						</div>

						@if (_mutation is { } mutation)
						{
							@if (!mutation.Ran)
							{
								<div class="compare-status failed" role="alert">@mutation.Error</div>
							}
							else
							{
								<section class="rt-qa">
									<header class="rt-head"><span class="rt-step">4</span><div><strong>Result</strong><small>@mutation.KilledMutants of @mutation.TotalMutants defects caught</small></div></header>
									<div class="audit-scoreline">
										<span class="ctx-label @(mutation.MutationScore >= 80 ? "ctx-rich" : mutation.MutationScore >= 50 ? "ctx-adequate" : "ctx-poor")">@mutation.MutationScore%</span>
										<div><strong>Mutation score</strong><small>baseline suite: @string.Join(", ", mutation.BaselineTests)</small></div>
										<p>@mutation.Verdict</p>
									</div>
									<table class="audit-table">
										<thead><tr><th>Line</th><th>Injected defect</th><th>Change</th><th>Outcome</th></tr></thead>
										<tbody>
											@foreach (var mutant in mutation.Mutants)
											{
												<tr class="@(mutant.Killed ? "p0-opt" : "p0-req")">
													<td>@mutant.Line</td>
													<td>@mutant.Description</td>
													<td><code>@mutant.Original</code> ? <code>@mutant.Mutated</code></td>
													<td>@(mutant.Killed ? $"caught by {mutant.Detail}" : "SURVIVED — no test failed")</td>
												</tr>
											}
										</tbody>
									</table>
									<p class="ctx-method">Every surviving row is a real behaviour change the suite accepted. Add a test until the rows that matter go away.</p>
								</section>
							}
						}
					</section>
					break;
				case 25:
					<section>
						<p class="kicker">REAL DATA, NEVER COMMITTED</p>
						<h2 id="scene-title">The best test data is also the worst leak</h2>
						<p class="rt-intro">A test ticket built from real data reproduces the defect properly — and is a data-exfiltration path if it goes straight to a model. <strong>Not checked in is not the same as not sent.</strong> The gate runs first, the model sees only the scrubbed copy, and the audit record keeps references rather than payloads.</p>

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>Ephemeral test ticket</strong><small>real repro data · in-memory only</small></div></header>
							<textarea class="rt-code-input" spellcheck="false" maxlength="12000" @bind="_ephemeralTicket" @bind:event="oninput" disabled="@EphemeralBusy" aria-label="Ephemeral ticket"></textarea>
							<div class="rt-actions">
								<small>@_ephemeralTicket.Length / 12000</small>
								<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || _ephemeralTicket.Trim().Length < 20 || EphemeralBusy)" @onclick="RunEphemeral">@(!_bridgeConnected ? "Connect VSIX to run" : EphemeralBusy ? "Running…" : "Gate, then run")</button>
							</div>
							@if (!_bridgeConnected)
							{
								<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
							}
						</section>

						@if (_session?.Ephemeral.Gate is { } dataGate)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Pre-flight gate</strong><small>runs before anything leaves the boundary</small></div></header>
								<div class="audit-body">
									<div class="audit-scoreline">
										<span class="ctx-label decision-@dataGate.Decision.ToLowerInvariant().Replace("-", "")">@dataGate.Decision</span>
										<div><strong>@dataGate.TierName</strong><small>@dataGate.Findings.Count finding type(s)</small></div>
										<p>@dataGate.Rationale</p>
									</div>
									@if (_session.Ephemeral.Record is { } record)
									{
										<h4>Ephemeral record</h4>
										<table class="audit-table">
											<tbody>
												<tr><td>Ticket id</td><td>@record.TicketId</td></tr>
												<tr><td>Owner</td><td>@record.Owner</td></tr>
												<tr><td>Storage</td><td>@record.Storage</td></tr>
												<tr><td>Retention</td><td>@record.Ttl</td></tr>
												<tr><td>Logging</td><td>@record.LogPolicy</td></tr>
												<tr><td>Payload digest</td><td><code>@record.PayloadDigest</code></td></tr>
											</tbody>
										</table>
										@if (record.Purged.Count > 0)
										{
											<h4>Removed before the model saw it</h4>
											<ul class="rt-list warn">@foreach (var item in record.Purged) { <li>@item</li> }</ul>
										}
									}
								</div>
							</section>

							@if (_session.Ephemeral.Status == "blocked")
							{
								<div class="compare-status failed" role="alert"><strong>Blocked.</strong> Restricted content was found, so nothing was sent to a model. Redaction does not make credentials safe — the owner authorises handling first. This is the gate working, not a failure.</div>
							}
							else
							{
								<div class="rt-flow">
									<section class="rt-box">
										<header class="rt-head"><span class="rt-step">3</span><div><strong>What the model actually received</strong><small>scrubbed copy</small></div></header>
										<pre class="rt-code">@dataGate.Scrubbed</pre>
									</section>
									<section class="rt-box">
										<header class="rt-head"><span class="rt-step">4</span><div><strong>Reproduction plan</strong><small>@(_session.Ephemeral.AgentModel ?? "Gemma")</small></div></header>
										@if (!string.IsNullOrEmpty(_session.Ephemeral.AgentPlan))
										{
											<div class="rt-story">@_session.Ephemeral.AgentPlan</div>
										}
										else if (EphemeralBusy)
										{
											<div class="rt-pending"><span></span>Running the test against the scrubbed ticket…</div>
										}
										else
										{
											<div class="rt-placeholder">The plan will appear here — proving the test still works after scrubbing.</div>
										}
									</section>
								</div>
							}
						}
						@if (_session?.Ephemeral.Status == "failed")
						{
							<div class="compare-status failed" role="alert">@(_session?.Ephemeral.Error ?? "The ephemeral run did not complete.")</div>
						}
					</section>
					break;
				case 26:
					<section>
						<p class="kicker">THREE TIERS, ONE SOURCE OF TRUTH</p>
						<h2 id="scene-title">Cortex routes. The repo decides.</h2>
						<p class="rt-intro">A tier hierarchy only earns its keep when you can say what happens if the tiers <strong>disagree</strong>. The rule: Tier 3 is closest to the code and is authoritative on specifics; Tier 1 exists for routing. And freshness never cascades downward — a parent that looks current says nothing about its children.</p>

						<div class="rt-actions">
							<small>Deterministic — no model call, works without the bridge.</small>
							<button class="primary-command compact" type="button" @onclick="RunPortfolio">Map the portfolio</button>
						</div>

						@if (_portfolio is { } portfolio)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>Tier 1 — @portfolio.CortexName</strong><small>routing only</small></div></header>
								<div class="audit-body">
									<div class="audit-scoreline">
										<span class="ctx-label @(portfolio.PortfolioScore >= 70 ? "ctx-rich" : portfolio.PortfolioScore >= 45 ? "ctx-adequate" : "ctx-poor")">@portfolio.PortfolioScore</span>
										<div><strong>Portfolio average</strong><small>weakest repo: @portfolio.WeakestRepo at @portfolio.WeakestScore</small></div>
										<p>An agent routed to the weakest repo gets the weakest experience. The average is the headline; the minimum is the risk.</p>
									</div>
									@if (portfolio.CortexStale)
									{
										<div class="compare-status failed" role="alert">The Cortex tier itself expired on @portfolio.CortexStaleAfter. Portfolio routing is running on unverified knowledge.</div>
									}
								</div>
							</section>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Tier 2 — AMP groups</strong><small>convention and ownership · select to drill down</small></div></header>
								<div class="audit-body">
									<table class="audit-table">
										<thead><tr><th>AMP ID</th><th>Group</th><th>Convention</th><th>Average</th><th>Weakest</th><th>Stale repos</th></tr></thead>
										<tbody>
											@foreach (var amp in portfolio.Amps)
											{
												var ampId = amp.AmpId;
												<tr class="p0-clickable @(_expandedAmp == ampId ? "curve-plateau" : null)" @onclick="() => ToggleAmp(ampId)">
													<td>@amp.AmpId</td>
													<td>@amp.Name</td>
													<td>@amp.Convention</td>
													<td>@amp.AverageScore</td>
													<td>@amp.WeakestScore</td>
													<td>@amp.StaleRepos / @amp.RepoCount@(amp.Stale ? " · tier stale" : string.Empty)</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</section>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>Tier 3 — repos</strong><small>authoritative on specifics@(_expandedAmp is null ? "" : $" · filtered to {_expandedAmp}")</small></div></header>
								<div class="audit-body">
									<table class="audit-table">
										<thead><tr><th>Repo</th><th>AMP</th><th>Score</th><th>Present</th><th>Missing</th><th>Freshness</th></tr></thead>
										<tbody>
											@foreach (var repo in portfolio.Repos.Where(repo => _expandedAmp is null || repo.AmpId == _expandedAmp))
											{
												<tr class="@(repo.Stale ? "p0-req" : "p0-opt")">
													<td>@repo.Name</td>
													<td>@repo.AmpId</td>
													<td><strong>@repo.Score</strong></td>
													<td>@string.Join(", ", repo.Present)</td>
													<td>@(repo.Missing.Count > 0 ? string.Join(", ", repo.Missing) : "—")</td>
													<td>@(repo.Stale ? $"STALE since {repo.StaleAfter}" : $"fresh to {repo.StaleAfter}")</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</section>

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">4</span><div><strong>Where the tiers disagree</strong><small>precedence rule R4</small></div></header>
								@if (portfolio.Conflicts.Count > 0)
								{
									<table class="audit-table">
										<thead><tr><th>Repo</th><th>Field</th><th>Cortex says</th><th>Repo says</th><th>Resolution</th></tr></thead>
										<tbody>
											@foreach (var conflict in portfolio.Conflicts)
											{
												<tr><td>@conflict.Repo</td><td>@conflict.Field</td><td>@conflict.CortexSays</td><td><strong>@conflict.RepoSays</strong></td><td>@conflict.Resolution</td></tr>
											}
										</tbody>
									</table>
								}
								else
								{
									<p class="rt-reco">No disagreements found between the portfolio record and the repos.</p>
								}

								@if (portfolio.StalenessCascades.Count > 0)
								{
									<h4>Staleness does not cascade</h4>
									<ul class="rt-list warn">@foreach (var cascade in portfolio.StalenessCascades) { <li>@cascade</li> }</ul>
								}
								<p class="ctx-method">Publish the precedence rule before the hierarchy is used for routing — hierarchies fail when tiers conflict and nobody said who wins.</p>
							</section>
						}
					</section>
					break;
				case 27:
					<section>
						<p class="kicker">THREE REAL SERVICES, ONE SHARED SPINE</p>
						<h2 id="scene-title">Find the duplication by meaning, then let the right model do each job</h2>
						<p class="rt-intro">Three production broker-dealer services are read from disk. They share an identical framework spine and diverge completely in their trading logic. <strong>embeddinggemma</strong> finds the duplication by meaning, <strong>Claude Opus 5</strong> designs the consolidation, and <strong>Gemma 4</strong> writes the code from that design — the expensive model is billed for judgement, not for typing.</p>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>The corpus</strong><small>real repositories, not a fixture</small></div></header>
							<div class="repo-grid">
								@foreach (var repo in TradingCorpus.Repos)
								{
									var loaded = _commonCode?.Repos.FirstOrDefault(item => item.Name == repo.Name);
									<article class="repo-card">
										<h3>@repo.Name</h3>
										<p class="repo-asset">@repo.AssetClass</p>
										<p class="repo-diverge">@repo.Divergence</p>
										<dl class="verdict-meta"><dt>OKF quality</dt><dd>@repo.OkfQuality</dd></dl>
										@if (loaded is not null)
										{
											<p class="repo-stats">@loaded.Files files · @loaded.Lines lines · @loaded.NonFunctionalFiles framework / @loaded.FunctionalFiles trading</p>
										}
									</article>
								}
							</div>
							<div class="rt-actions">
								<small>Deterministic — embeddings only, no bridge needed.</small>
								<button class="primary-command compact" type="button" disabled="@_commonCodeRunning" @onclick="RunCommonCode">@(_commonCodeRunning ? "Embedding…" : "Run the audit")</button>
							</div>
						</section>

						@if (_commonCode is { } codeAudit)
						{
							@if (!codeAudit.CorpusAvailable)
							{
								<div class="rt-error" role="alert">@codeAudit.CorpusStatus</div>
							}
							else
							{
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">2</span><div><strong>Did it actually separate them?</strong><small>scored against the source tree, not asserted</small></div></header>
									<div class="audit-body">
										<div class="know-grid">
											<div class="know-col learned"><p class="eyebrow">KNOWN DUPLICATES</p><ul><li>mean @codeAudit.Separation.DuplicateMean.ToString("0.000"), weakest @codeAudit.Separation.DuplicateMin.ToString("0.000")</li></ul></div>
											<div class="know-col unverified"><p class="eyebrow">EVERYTHING ELSE</p><ul><li>mean @codeAudit.Separation.UnrelatedMean.ToString("0.000"), strongest @codeAudit.Separation.UnrelatedMax.ToString("0.000")</li></ul></div>
											<div class="know-col own"><p class="eyebrow">MARGIN</p><ul><li>@codeAudit.Separation.Margin.ToString("0.000") — @codeAudit.Separation.NearestNeighbourHits/@codeAudit.Separation.NearestNeighbourTotal framework files whose nearest cross-repo neighbour is the same class</li></ul></div>
										</div>
										<p class="ctx-method">@codeAudit.CorpusStatus Method: @(codeAudit.UsedEmbeddings ? "embeddinggemma-300m int8, windowed mean-pooling over whole files" : "token-overlap fallback") at cosine ≥ @codeAudit.Threshold.ToString("0.000"). @(codeAudit.Separation.Margin > 0 ? $"The two populations do not overlap, but the margin is only {codeAudit.Separation.Margin:0.000} wide — a single threshold works here and would not survive a noisier estate." : "The populations overlap: no single threshold separates them cleanly, so treat the clusters as candidates for review rather than findings.")</p>
									</div>
								</section>

								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">3</span><div><strong>The prize</strong><small>@codeAudit.DuplicatedClusters duplicated cluster(s) across @codeAudit.UnitCount files</small></div></header>
									<div class="audit-body">
										<div class="know-grid">
											<div class="know-col learned"><p class="eyebrow">NON-FUNCTIONAL DUPLICATION</p><ul><li>@codeAudit.NonFunctionalPrize lines — framework code with one correct answer. Start here.</li></ul></div>
											<div class="know-col unverified"><p class="eyebrow">FUNCTIONAL DUPLICATION</p><ul><li>@(codeAudit.FunctionalPrize == 0 ? "None found. The trading logic genuinely diverges by asset class — which is also evidence the audit is not simply clustering everything that looks like C#." : $"{codeAudit.FunctionalPrize} lines — business rules encoded more than once. Higher prize, higher risk.")</li></ul></div>
										</div>
										<table class="audit-table">
											<thead><tr><th>Kind</th><th>Members</th><th>Repos</th><th>Duplicate lines</th><th>Recommendation</th></tr></thead>
											<tbody>
												@foreach (var cluster in codeAudit.Clusters.Where(cluster => cluster.IsDuplication))
												{
													<tr class="p0-req">
														<td>@cluster.Kind</td>
														<td>@string.Join(", ", cluster.Members.Select(member => $"{member.Repo}/{member.Name}"))</td>
														<td>@cluster.Repos.Count</td>
														<td>@cluster.DuplicateLines</td>
														<td>@cluster.Recommendation</td>
													</tr>
												}
											</tbody>
										</table>
										<ol class="rt-list warn">@foreach (var step in codeAudit.Strategy) { <li>@step</li> }</ol>
									</div>
								</section>

								@if (codeAudit.TopPairs.Count > 0)
								{
									<section class="rt-box">
										<header class="rt-head"><span class="rt-step">4</span><div><strong>How the threshold was chosen</strong><small>measured, not guessed</small></div></header>
										<div class="audit-body">
											<table class="audit-table">
												<thead><tr><th>Similarity</th><th>Pair</th><th>Cross-repo</th><th>Clustered</th></tr></thead>
												<tbody>
													@foreach (var pair in codeAudit.TopPairs)
													{
														<tr class="@(pair.Similarity >= codeAudit.Threshold ? "p0-req" : "p0-opt")">
															<td>@pair.Similarity.ToString("0.000")</td>
															<td>@pair.Left ~ @pair.Right</td>
															<td>@(pair.CrossRepo ? "yes" : "no")</td>
															<td>@(pair.Similarity >= codeAudit.Threshold ? "yes" : "below threshold")</td>
														</tr>
													}
												</tbody>
											</table>
											<p class="ctx-method">These are the pairs either side of the cut, not the obvious top of the list. The threshold sits in the measured gap between the weakest true duplicate and the strongest unrelated pair — here that gap is narrow, and the nearest miss is a genuine near-relative rather than noise. Re-measure with <code>--calibrate-corpus</code> before pointing this at a different estate.</p>
										</div>
									</section>
								}

								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">5</span><div><strong>Claude Opus 5 designs the consolidation</strong><small>judgement, not typing</small></div></header>
									<div class="rt-actions">
										<small>Claude sees the audit; the implementation spec it writes is the only thing Gemma will see.</small>
										<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || codeAudit.DuplicatedClusters == 0 || ConsolidationBusy)" @onclick="RunConsolidation">@ConsolidationButtonText</button>
									</div>
									@if (!_bridgeConnected)
									{
										<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
									}
									@if (_session?.Consolidation.Error is { } consolidationError)
									{
										<div class="rt-error" role="alert">@consolidationError</div>
									}
									@if (_session?.Consolidation.Design is { } sharedDesign)
									{
										<div class="audit-body">
											<div class="coach-label">Designed by @_session.Consolidation.DesignModel</div>
											<h4>@sharedDesign.LibraryName</h4>
											<p class="rt-reco">@sharedDesign.Summary</p>
											@if (sharedDesign.Modules.Count > 0)
											{
												<table class="audit-table">
													<thead><tr><th>Module</th><th>Responsibility</th><th>Public API</th><th>Replaces</th></tr></thead>
													<tbody>
														@foreach (var module in sharedDesign.Modules)
														{
															<tr><td>@module.Name</td><td>@module.Responsibility</td><td><code>@module.PublicApi</code></td><td>@string.Join(", ", module.Replaces)</td></tr>
														}
													</tbody>
												</table>
											}
											@if (sharedDesign.MigrationSteps.Count > 0)
											{
												<h4>Migration</h4><ol class="rt-list good">@foreach (var step in sharedDesign.MigrationSteps) { <li>@step</li> }</ol>
											}
											@if (sharedDesign.Risks.Count > 0)
											{
												<h4>Risks</h4><ul class="rt-list warn">@foreach (var risk in sharedDesign.Risks) { <li>@risk</li> }</ul>
											}
											@if (sharedDesign.OutOfScope.Count > 0)
											{
												<h4>Deliberately not consolidated</h4><ul class="rt-list">@foreach (var item in sharedDesign.OutOfScope) { <li>@item</li> }</ul>
											}
											<h4>Implementation spec handed to Gemma</h4>
											<pre class="rt-code">@sharedDesign.ImplementationSpec</pre>
										</div>
									}
									else if (_session?.Consolidation.Status == "designing")
									{
										<div class="rt-pending"><span></span>Claude is designing the shared library from the audit…</div>
									}
									else
									{
										<div class="rt-placeholder">Claude's consolidation design will appear here.</div>
									}
								</section>

								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">6</span><div><strong>Gemma 4 implements the design</strong><small>one task per module, spec in, code out — no repository access</small></div></header>
									@if (_session?.Consolidation.Build is { } build)
									{
										<div class="audit-body">
											<div class="coach-label">@(build.ModulesCompleted)/@(build.ModulesTotal) modules · implemented by @(_session.Consolidation.BuildModel ?? "Gemma") from the spec alone — it never saw the three repositories.</div>
											@if (build.FailedModules.Count > 0)
											{
												<h4>Modules that failed</h4><ul class="rt-list warn">@foreach (var failure in build.FailedModules) { <li>@failure</li> }</ul>
											}
											@if (build.Assumptions.Count > 0)
											{
												<h4>Gaps the spec left open</h4><ul class="rt-list warn">@foreach (var assumption in build.Assumptions) { <li>@assumption</li> }</ul>
											}
											@foreach (var file in build.Files)
											{
												<h4>@file.Path</h4>
												<p class="repo-diverge">@file.Purpose</p>
												<pre class="rt-code">@file.Source</pre>
											}
											@if (build.ModulesCompleted < build.ModulesTotal)
											{
												<div class="rt-pending"><span></span>Building module @(build.ModulesCompleted + 1) of @build.ModulesTotal…</div>
											}
										</div>
									}
									else if (_session?.Consolidation.Status is "designing" or "building")
									{
										<div class="rt-pending"><span></span>Waiting for the design before the modules can be built…</div>
									}
									else
									{
										<div class="rt-placeholder">Gemma's implementation will appear here.</div>
									}
								</section>

								@if (_session?.Consolidation.Tokens is { } spend)
								{
									<section class="rt-qa">
										<header class="rt-head"><span class="rt-step">!</span><div><strong>Where the tokens went</strong><small>@(spend.Exact ? "exact Gemma tokenizer counts" : "estimated")</small></div></header>
										<table class="audit-table">
											<thead><tr><th>Stage</th><th>Model</th><th>Prompt tokens</th><th>Output tokens</th><th>What it bought</th></tr></thead>
											<tbody>
												<tr><td>Design</td><td>@(_session.Consolidation.DesignModel ?? "Claude Opus 5")</td><td>@spend.DesignPromptTokens.ToString("N0")</td><td>@spend.DesignOutputTokens.ToString("N0")</td><td>Boundaries, migration sequence, risk — the part that needs judgement.</td></tr>
												<tr><td>Build</td><td>@(_session.Consolidation.BuildModel ?? "Gemma 4")</td><td>@spend.BuildPromptTokens.ToString("N0")</td><td>@spend.BuildOutputTokens.ToString("N0")</td><td>Volume code from a closed specification — mechanical.</td></tr>
											</tbody>
										</table>
										<ul class="rt-list good">
											<li>The frontier model never received the corpus. Sending all @spend.CorpusTokens.ToString("N0") tokens of source to Claude would have cost roughly @((spend.CorpusTokens / (double)Math.Max(spend.DesignPromptTokens, 1)).ToString("0.0"))× the design prompt, before it wrote a line.</li>
											<li>@(spend.BuildOutputTokens > spend.DesignOutputTokens ? "Most of the generated volume came from the cheaper model, which is the intended split." : "The design was larger than the implementation here — on a bigger consolidation the ratio inverts.")</li>
											<li>This only holds if the spec is genuinely self-contained. If Gemma has to guess, the retry cost lands back on the expensive model — see the token economics scene for cost per successful outcome.</li>
										</ul>
									</section>
								}
							}
						}
					</section>
					break;
				case 28:
					<section>
						<p class="kicker">FREE IS THE WRONG WORD</p>
						<h2 id="scene-title">Budget in cost per outcome, not cost per token</h2>
						<p class="rt-intro">An open-weight model has <strong>no per-token vendor invoice</strong> — it does not have zero cost. And a model that fails a third of the time is billed for every failure. The only unit that survives contact with Finance is <strong>cost per successful outcome</strong>.</p>

						<div class="rt-actions">
							<small>Deterministic — illustrative rates, no model call.</small>
							<button class="primary-command compact" type="button" @onclick="RunEconomics">Compute the economics</button>
						</div>

						@if (_economics is { } econ)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>The escalation ladder</strong><small>@econ.PromptTokens.ToString("N0") prompt + @econ.OutputTokens.ToString("N0") output tokens per attempt</small></div></header>
								<div class="audit-body">
									<table class="audit-table">
										<thead><tr><th>Rung</th><th>Model</th><th>Billing</th><th>Success</th><th>Cost / attempt</th><th>Attempts / success</th><th>Cost / success</th></tr></thead>
										<tbody>
											@foreach (var row in econ.Rows)
											{
												<tr class="@(row.Rung == econ.CheapestPerSuccess ? "econ-best" : null)">
													<td>@row.Rung</td>
													<td>@row.Model</td>
													<td>@row.Kind</td>
													<td>@row.SuccessPercent%</td>
													<td>@row.CostPerAttempt.ToString("C4")</td>
													<td>@row.AttemptsPerSuccess</td>
													<td><strong>@row.CostPerSuccess.ToString("C4")</strong></td>
												</tr>
											}
										</tbody>
									</table>
									<ul class="rt-list good">@foreach (var row in econ.Rows) { <li><strong>@row.Model:</strong> @row.Note</li> }</ul>
								</div>
							</section>

							@if (econ.RateCardMisleads)
							{
								<div class="compare-status" role="status"><strong>The rate card would pick the wrong model.</strong> Cheapest per attempt is <em>@econ.CheapestPerAttempt</em>; cheapest per success is <em>@econ.CheapestPerSuccess</em>. Routing on price alone buys more retries, not more outcomes.</div>
							}

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Routing policy</strong><small>what to tell the teams</small></div></header>
								<ol class="rt-list warn">@foreach (var line in econ.Policy) { <li>@line</li> }</ol>
							</section>
						}
					</section>
					break;
				case 29:
					<section>
						<p class="kicker">A LIBRARY THAT SCALES WHAT WORKS</p>
						<h2 id="scene-title">Contributions are admitted on evidence</h2>
						<p class="rt-intro">A shared prompt library scales whatever you put in it — including the mistakes. So this has an <strong>entry gate</strong>, not an upload button: every contribution must carry its outcome evidence, the context it depends on, and at least one known way it fails.</p>

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>Contribute a pattern</strong><small>all six fields are required</small></div></header>
							<div class="p0-form">
								<label>Title<input type="text" @bind="_submission.Title" /></label>
								<label>Problem it solves<input type="text" @bind="_submission.Problem" /></label>
								<label>The prompt or approach<input type="text" @bind="_submission.Approach" /></label>
								<label>Evidence of outcome (include a number)<input type="text" @bind="_submission.Evidence" /></label>
								<label>Context it depends on<input type="text" @bind="_submission.ContextNeeded" /></label>
								<label>Known failure modes<input type="text" @bind="_submission.FailureModes" /></label>
							</div>
							<div class="rt-actions">
								<small>Deterministic curation gate — no model call.</small>
								<button class="primary-command compact" type="button" @onclick="SubmitPattern">Submit to the library</button>
							</div>
						</section>

						@if (_libraryReview is { } curation)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Curation gate</strong><small>@curation.Score% of checks passed</small></div></header>
								<div class="audit-body">
									<div class="audit-scoreline">
										<span class="ctx-label @(curation.Admitted ? "ctx-rich" : "ctx-poor")">@(curation.Admitted ? "ADMITTED" : "HELD")</span>
										<p>@curation.Verdict</p>
									</div>
									<table class="audit-table">
										<thead><tr><th>Check</th><th>Requirement</th><th>Why it is required</th><th>Result</th></tr></thead>
										<tbody>
											@foreach (var check in curation.Checks)
											{
												<tr class="@(check.Passed ? "p0-opt" : "p0-req")"><td>@check.Name</td><td>@check.Requirement</td><td>@check.Why</td><td>@(check.Passed ? "pass" : "FAIL")</td></tr>
											}
										</tbody>
									</table>
								</div>
							</section>
						}

						<section class="rt-qa">
							<header class="rt-head"><span class="rt-step">@(_libraryReview is null ? "2" : "3")</span><div><strong>The library</strong><small>@Library.Entries.Count admitted pattern(s)</small></div></header>
							@foreach (var entry in Library.Entries)
							{
								<div class="lib-entry">
									<strong>@entry.Title</strong>
									<p><em>Problem:</em> @entry.Problem</p>
									<p><em>Approach:</em> @entry.Approach</p>
									<p><em>Evidence:</em> @entry.Evidence</p>
									<p><em>Needs:</em> @entry.ContextNeeded</p>
									<p class="lib-fail"><em>Fails when:</em> @entry.FailureModes</p>
								</div>
							}
						</section>
					</section>
					break;
				case 30:
					<section>
						<p class="kicker">PLAN BEFORE CODE</p>
						<h2 id="scene-title">A summary leadership reads, a diagram engineers check</h2>
						<p class="rt-intro">Demanding a plan with an executive summary and a diagram is a <strong>graded skill</strong>, not a nicety. The hardest check is the last one: producing an implementation before the plan is reviewed is exactly the habit this gate exists to break.</p>

						<section class="rt-box rt-input-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>The plan under review</strong><small>edit it to see the gate react</small></div></header>
							<textarea class="rt-code-input" spellcheck="false" maxlength="8000" @bind="_planText" @bind:event="oninput" aria-label="Plan"></textarea>
							<div class="rt-actions">
								<small>Deterministic structural check — no model call.</small>
								<button class="primary-command compact" type="button" @onclick="ReviewPlan">Review the plan</button>
							</div>
						</section>

						@if (_planReview is { } plan)
						{
							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Result</strong><small>executive summary: @plan.SummaryWords words</small></div></header>
								<div class="audit-scoreline">
									<span class="ctx-label @(plan.Score == 100 ? "ctx-rich" : plan.Score >= 60 ? "ctx-adequate" : "ctx-poor")">@plan.Score%</span>
									<p>@plan.Verdict</p>
								</div>
								<table class="audit-table">
									<thead><tr><th>Check</th><th>Requirement</th><th>Result</th></tr></thead>
									<tbody>
										@foreach (var check in plan.Checks)
										{
											<tr class="@(check.Passed ? "p0-opt" : "p0-req")"><td>@check.Name</td><td>@check.Requirement</td><td>@(check.Passed ? "pass" : "FAIL")</td></tr>
										}
									</tbody>
								</table>
							</section>
						}
					</section>
					break;
				case 31:
					<section>
						<p class="kicker">THE ORDER TO WALK IT IN</p>
						<h2 id="scene-title">Six acts, each ending in a number</h2>
						<p class="rt-intro">This is the sequence for leadership, not the order the platform was built in. Each act answers a question executives actually ask, demonstrates one control, and produces one metric. Select an act to jump to its representative scene.</p>

						<div class="act-grid">
							@foreach (var act in Acts)
							{
								var target = act.SceneIndex;
								<article class="act-card">
									<p class="eyebrow">@act.Act</p>
									<h3>“@act.Question”</h3>
									<p class="act-summary">@act.Summary</p>
									<dl class="verdict-meta"><dt>Control</dt><dd>@act.Control</dd></dl>
									<dl class="verdict-meta"><dt>Metric</dt><dd>@act.Metric</dd></dl>
									<button class="secondary-command" type="button" @onclick="() => GoTo(target)">Open: @act.SceneName →</button>
								</article>
							}
						</div>

						<section class="rt-qa">
							<header class="rt-head"><span class="rt-step">!</span><div><strong>How to present this</strong><small>the part that survives the meeting</small></div></header>
							<ul class="rt-list good">
								<li>Lead with the thesis, not the tooling: the AI, the human input, and drift are three separate failure modes, and most programmes measure only the first.</li>
								<li>Show one act per meeting if you have to. Each is self-contained and each ends in a number.</li>
								<li>Every figure in this platform is illustrative until it is measured on CES repos. Say so before someone else does.</li>
								<li>The controls that matter most are the boring ones — inventory, tiering, and the data gate. They are prerequisites, not achievements.</li>
							</ul>
						</section>
					</section>
					break;
			}
		</article>

		<footer class="stage-footer">
			<button class="secondary-command" type="button" disabled="@(_scene == 0)" @onclick="Previous">? Previous</button>
			<div class="narration-text"><span>Narration transcript</span><p>@CurrentNarration</p></div>
			<button class="secondary-command" type="button" disabled="@(_scene == Scenes.Length - 1)" @onclick="Next">Next ?</button>
		</footer>
	</section>

	<aside class="connection-drawer" aria-hidden="@(!_drawerOpen)">
		<button class="drawer-toggle" type="button" title="Hide the local bridge panel" aria-label="Hide the local bridge panel" aria-expanded="true" aria-controls="bridge-drawer" @onclick="ToggleDrawer">Hide &rsaquo;</button>
		<p class="eyebrow">LOCAL BRIDGE</p><h2>Connect VS Code</h2><p>Run <strong>POC Training: Connect</strong> in VS Code and paste this session token.</p>
		<code>@_session?.BridgeToken</code><button type="button" @onclick="CopyToken">Copy token</button>
		<dl><dt>Server</dt><dd>127.0.0.1:5000</dd><dt>Coach</dt><dd>Gemma 4</dd><dt>Review</dt><dd>Claude Opus 5</dd></dl>
	</aside>

	@if (!_drawerOpen)
	{
		<button class="drawer-reopen" type="button" title="Show the local bridge panel" aria-label="Show the local bridge panel" aria-expanded="false" aria-controls="bridge-drawer" @onclick="ToggleDrawer">
			<span class="status-dot @(_bridgeConnected ? "online" : null)"></span>&lsaquo; Local bridge
		</button>
	}
</div>

