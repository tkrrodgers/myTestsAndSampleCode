													<td>@(entry.Status == "completed" ? entry.OutputTokens.ToString("N0") : "—")</td>
													<td>@(entry.DurationMs > 0 ? (entry.DurationMs / 1000.0).ToString("0") : "—")</td>
													<td>@(entry.Status == "completed" ? (entry.JavaProvided ? "provided" : "declined") : "—")</td>
													<td>@(entry.JavaConfidence ?? "—")</td>
													<td>@(entry.Status == "pending" ? "queued" : entry.Status == "running" ? "thinking…" : entry.Status == "failed" ? entry.Error : "scored")</td>
												</tr>
											}
										</tbody>
									</table>
									<p class="rt-note">
										<strong>How to read it.</strong> <em>Compiler checks</em> are exact matches against Step 2 &mdash; a model either knows
										how IBM COBOL lays out storage or it does not. <em>SME insights</em> is a keyword floor: it can miss an insight
										phrased unusually, but it cannot award one that is absent. <em>Java declined</em> with an honest low confidence is a
										better engineering answer than confident Java that gets the bytes wrong; read the two columns together. Seconds and
										output tokens are the cost side: a model that scores the same for a third of the tokens is the right model for
										the routine version of this job.
									</p>

									@foreach (var entry in ls.Entries.Where(e => e.Status == "completed").OrderByDescending(e => e.CheckablePassed).ThenByDescending(e => e.InsightsFound))
