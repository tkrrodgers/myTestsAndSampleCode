								<label>Autonomy<select @bind="_agent.Autonomy">@foreach (var level in AgentRegistryService.AutonomyLevels) { <option value="@level">@level</option> }</select></label>
								<label>Data tier<select @bind="_agent.DataTier">@foreach (var level in AgentRegistryService.DataTiers) { <option value="@level">@level</option> }</select></label>
								<label>Status<select @bind="_agent.AgentStatus">@foreach (var level in AgentRegistryService.AgentStatuses) { <option value="@level">@level</option> }</select></label>
