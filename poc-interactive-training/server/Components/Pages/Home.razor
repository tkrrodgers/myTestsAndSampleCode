		? "Connect VSIX to modernize"
		: ModernizeBusy ? "Modernizing…" : "Modernize with Claude";

	private bool AuditBusy => _session?.Audit.Status is "analyzed" or "queued" or "running";
	private string AuditButtonText => !_bridgeConnected
		? "Connect VSIX to audit"
		: AuditBusy ? "Auditing…" : "Run audit";
	private static string SeverityClass(string severity) => severity switch { "high" => "sev-high", "medium" => "sev-medium", _ => "sev-low" };

	private bool ContextBusy => _session?.ContextAudit.Status is "analyzed" or "queued" or "gemma" or "judging";
