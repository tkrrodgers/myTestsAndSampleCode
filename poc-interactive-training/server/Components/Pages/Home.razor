				case 7:
					<section>
						<p class="kicker">YOU DRIVE THE INVESTIGATION</p>
						<h2 id="scene-title">Write the prompt Claude will review</h2>
						<div class="challenge-stack">
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>Direct the investigation</strong><small>require evidence, restraint and a verification path &mdash; not an immediate code dump</small></div></header>
								<div class="audit-body">
									<p class="challenge-intro">Direct an AI to investigate FUL-1842. The six checks below are the rubric Claude will score the prompt against.</p>
									<div class="rubric-list"><span>Index first</span><span>Source paths</span><span>Concept + boundary</span><span>ADR constraint</span><span>Code + tests</span><span>Open questions</span></div>
									<label for="learner-prompt">Your investigation prompt</label>
									<textarea id="learner-prompt" maxlength="6000" @bind="_learnerPrompt" @bind:event="oninput" placeholder="Investigate FUL-1842 by starting with..."></textarea>
									<p class="ctx-method">Pre-filled with a worked example so a walkthrough can go straight to the review. Edit or clear it to see the rubric respond &mdash; deleting the numbered steps is the fastest way to show what a weak prompt costs.</p>
									<div class="prompt-actions"><small>@_learnerPrompt.Length / 6000</small><button class="primary-command compact" type="button" data-auto="s09.submit" disabled="@(!_bridgeConnected || _learnerPrompt.Trim().Length < 40 || _session?.ReviewStatus is "queued" or "running")" @onclick="SubmitReview">@ReviewButtonText</button></div>
									@if (!_bridgeConnected)
									{
										<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before requesting Claude.</p>
									}
								</div>
							</section>

							<section class="rt-box">
								<header class="rt-head">
									<span class="rt-step">2</span>
									<div><strong>Claude's decision trace</strong><small>streamed live as each rubric check is decided<span>@ReviewElapsed</span></small></div>
									<span class="live-indicator @(_session?.ReviewStatus == "running" ? "active" : _session?.ReviewStatus == "failed" ? "failed" : null)">@ReviewTraceState</span>
								</header>
								<div class="audit-body">
									<p class="trace-disclosure">Observable rubric checks as Claude emits them. This is the reviewer narrating its own steps, not private chain-of-thought, and it is not proof that the final feedback is correct.</p>
									<div class="trace-stream" id="review-trace-stream">
										@if (_session?.ReviewTrace.Count > 0)
										{
											<ol class="review-trace-list">
												@foreach (var traceEvent in _session.ReviewTrace)
												{
													<li @key="traceEvent.Sequence" class="trace-arrived">
														<span>@traceEvent.Sequence.ToString("00")</span>
														<div><strong>@traceEvent.Stage</strong><blockquote>@traceEvent.Evidence</blockquote><p>@traceEvent.Decision</p></div>
													</li>
												}
											</ol>
										}
										@if (_session?.ReviewStatus is "queued" or "running")
										{
											<div class="trace-typing">
												<span class="trace-typing-dots" aria-hidden="true"><i></i><i></i><i></i></span>
												<p>@(string.IsNullOrWhiteSpace(_session.ReviewPartial) ? "Waiting for the next step…" : _session.ReviewPartial)<span class="trace-caret" aria-hidden="true"></span></p>
											</div>
										}
										else if (_session?.ReviewTrace.Count == 0)
										{
											<div class="trace-awaiting"><span></span><p>@ReviewTraceMessage</p></div>
										}
									</div>
								</div>
							</section>

							<section class="rt-box" id="review-feedback" tabindex="-1" aria-live="polite">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>Independent review</strong><small>@(_session?.Review is null ? "appears when the trace above completes" : $"reviewed by {_session.ReviewModel}")</small></div></header>
								<div class="audit-body">
									@if (_session?.Review is null)
									{
										@if (_session?.ReviewStatus == "failed")
										{
											<div class="review-empty failed"><span>!</span><h3>Claude review didn't finish</h3><p>@(_session?.LastError ?? "The review task failed. Confirm a language model is signed in and available in VS Code, then request feedback again.")</p></div>
										}
										else
										{
											<div class="review-empty"><span>CL</span><h3>Feedback appears here</h3><p>Claude reviews the prompt against the visible rubric. It does not assign a validated grade.</p></div>
										}
									}
									else
									{
										<div class="coach-label">AI coaching commentary — not a validated grade.</div>
										<h3>@_session.Review.Summary</h3>
										<div class="review-columns">
											<div><h4>Strengths</h4><ul>@foreach (var item in _session.Review.Strengths) { <li>@item</li> }</ul></div>
											<div><h4>Improve next</h4><ul>@foreach (var item in _session.Review.Improvements) { <li>@item</li> }</ul></div>
											@if (_session.Review.UnsupportedAssumptions.Count > 0)
											{
												<div><h4>Unsupported assumptions</h4><ul>@foreach (var item in _session.Review.UnsupportedAssumptions) { <li>@item</li> }</ul></div>
											}
										</div>
										<details><summary>Suggested revision</summary><p>@_session.Review.SuggestedPrompt</p></details>
									}
								</div>
							</section>
						</div>
					</section>
					break;
				case 8:
					<section>
						<p class="kicker">CAPABILITY COMPARISON</p>
						<h2 id="scene-title">Ask three models the same question</h2>
						<p class="compare-intro">This measures <strong>what the three models already know about Google Cloud</strong>. They are asked the question and given nothing else — no documentation, no hints, no retrieval. Then the official Google Cloud documentation is <strong>fetched over the network</strong> and handed to <strong>Claude Opus 4.8</strong>, which scores the anonymised answers against that retrieved text and must quote it to justify every factuality judgement.</p>

						<div class="know-grid">
							<div class="know-col unverified"><p class="eyebrow">1 · CLOSED BOOK</p><ul><li>Three models, same question, no context. Each answers from its own training alone, in its own column.</li></ul></div>
							<div class="know-col own"><p class="eyebrow">2 · RETRIEVE</p><ul><li>The server fetches the real documentation pages listed below and converts them to text. Retrieval status is shown, so a dead link is visible rather than silent.</li></ul></div>
							<div class="know-col learned"><p class="eyebrow">3 · GROUNDED JUDGE</p><ul><li>Claude Opus 4.8 sees the answers blinded as A / B / C and the retrieved text. It scores against that text only, and separates "contradicted" from "not covered".</li></ul></div>
						</div>

						<div class="compare-controls">
							<select class="compare-select" data-auto="s10.topic" @bind="_comparisonTopicId" disabled="@ComparisonBusy">
								<option value="">Choose a topic…</option>
								@foreach (var topic in ComparisonCatalog.Topics)
								{
									<option value="@topic.Id">@topic.Title</option>
								}
							</select>
							<button class="primary-command compact" type="button" data-auto="s10.run" disabled="@(!_bridgeConnected || string.IsNullOrEmpty(_comparisonTopicId) || ComparisonBusy)" @onclick="RunComparison">@CompareButtonText</button>
