									{
										<h4>Gaps identified</h4><ul class="rt-list warn">@foreach (var gap in _session.ContextAudit.GemmaGaps) { <li>@gap</li> }</ul>
									}
									<small>Audited by @_session.ContextAudit.GemmaModel</small>
