														<code>@failureCode</code>
													}
													<span class="answer-failed-hint">Check the <em>POC Interactive Training</em> output channel in VS Code for the full client-side error.</span>
												</div>
												break;
											default:
												<div class="answer-pending"><span></span>Waiting for @answer.RequestedModel…</div>
												break;
										}
									</article>
								}
							</div>
						}

						@if (_session?.Comparison.Answers.Count > 0 && _session.Comparison.Answers.Any(answer => answer.Status == "failed") && !ComparisonBusy)
						{
							<div class="compare-status failed" role="status">
								<strong>This comparison is incomplete.</strong>
								@(_session.Comparison.Answers.Count(answer => answer.Status == "completed")) of @_session.Comparison.Answers.Count models answered, so the ranking below covers only those. A model that fails to answer has not been shown to be worse than one that did — most often the model is simply not available or not signed in for this VS Code session. Treat the missing column as no data, not as a result.
							</div>
						}

						@if (_session?.Comparison.Status == "judging")
						{
