	protected override void OnInitialized()
	{
		_session = Store.CreateSession();
		_changeJira = _session.GroundedChange.Jira;
		_timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
		Room.Changed += OnRoomChanged;
		_ = PollAsync();
	}

	private async Task PollAsync()
	{
		try
		{
			while (_timer is not null && await _timer.WaitForNextTickAsync(_pollCancellation.Token))
			{
				if (_session is null) continue;
				var previousReview = _session.ReviewStatus;
				var previousTrace = _session.ReviewTrace.Count;
				var previousPartial = _session.ReviewPartial;
				_session = Store.GetSession(_session.SessionId);
				_bridgeConnected = Store.IsBridgeConnected(_session.SessionId);
				_judgeStartedAt = _session.Comparison.Status is "grounding" or "judging" ? _judgeStartedAt ?? DateTimeOffset.UtcNow : null;

				var reviewBusy = _session.ReviewStatus is "queued" or "running";
				_reviewStartedAt = reviewBusy ? _reviewStartedAt ?? DateTimeOffset.UtcNow : null;

				// A one-second poll makes streamed text arrive in visible jumps; tighten it only while streaming.
				_timer.Period = reviewBusy ? TimeSpan.FromMilliseconds(300) : TimeSpan.FromSeconds(1);

				await InvokeAsync(StateHasChanged);

				if (reviewBusy && (_session.ReviewTrace.Count != previousTrace || _session.ReviewPartial != previousPartial))
				{
					await JS.InvokeVoidAsync("trainingSpeech.stickToBottom", "review-trace-stream");
				}

				if (previousReview != "completed" && _session.ReviewStatus == "completed") await JS.InvokeVoidAsync("trainingSpeech.focus", "review-feedback");
			}
		}
		catch (OperationCanceledException) { }
	}

