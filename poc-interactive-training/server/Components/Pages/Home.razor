										<thead><tr><th>Pattern</th><th>Category</th><th>Count</th><th>Sample</th></tr></thead>
										<tbody>
											@foreach (var finding in assessment.Findings)
											{
												<tr><td>@finding.Label</td><td>@finding.Category</td><td>@finding.Count</td><td><code>@finding.Sample</code></td></tr>
