								@if (migration.Oracle.Count > 0)
								{
									<table class="audit-table">
										<thead><tr><th>Input record</th><th>Legacy output</th></tr></thead>
										<tbody>
											@foreach (var run in migration.Oracle)
											{
												<tr><td><code>@run.Input</code></td><td>@(string.IsNullOrEmpty(run.Error) ? run.Output : run.Error)</td></tr>
											}
										</tbody>
									</table>
								}
								else
								{
									<div class="rt-placeholder">The oracle runs when you start the migration.</div>
								}

								@if (migration.CompilerFields.Count > 0)
								{
									<h4>What the compiler resolved (given only to arm C)</h4>
									<table class="audit-table">
										<thead><tr><th>Field</th><th>Offset</th><th>Bytes</th><th>Type, digits, scale</th></tr></thead>
										<tbody>
											@foreach (var field in migration.CompilerFields)
											{
												<tr><td>@field.Name</td><td>@field.Offset</td><td>@field.Size</td><td>@field.Attribute</td></tr>
											}
										</tbody>
									</table>
								}
							</section>

							<section class="rt-box rt-input-box">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>Run the comparison</strong><small>@migration.Arms.Count of 3 arms complete</small></div></header>
								<div class="rt-actions">
									<small>Gemma 4 migrates the same program three times</small>
									<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || MigrationBusy || !migration.ToolchainAvailable)" @onclick="RunMigration">@MigrationButtonText</button>
								</div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
								}
							</section>

							@foreach (var arm in migration.Arms)
							{
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">@arm.Arm</span><div><strong>Arm @arm.Arm — @GroundingLabel(arm.Grounding)</strong><small>@(arm.ModelUsed ?? arm.RequestedModel) · @arm.PromptTokens.ToString("N0") prompt tokens</small></div></header>
									@if (arm.Cases.Count > 0)
									{
										<div class="@(arm.Passed == arm.Cases.Count ? "compare-status" : "compare-status failed")" role="status">
											@arm.Passed of @arm.Cases.Count cases match the legacy program.
										</div>
										<table class="audit-table">
											<thead><tr><th>Input</th><th>Legacy says</th><th>This arm says</th><th></th></tr></thead>
											<tbody>
												@foreach (var item in arm.Cases)
												{
													<tr>
														<td><code>@item.Input</code></td>
														<td>@item.Expected</td>
														<td>@item.Actual@(string.IsNullOrEmpty(item.Note) ? "" : $" ({item.Note})")</td>
														<td>@(item.Matched ? "match" : "MISMATCH")</td>
													</tr>
												}
											</tbody>
										</table>
									}
									else if (!string.IsNullOrEmpty(arm.Error))
									{
										<div class="compare-status failed" role="alert">@arm.Error</div>
										@if (arm.CompileErrors.Count > 0)
										{
											<ul class="rt-list warn">@foreach (var error in arm.CompileErrors) { <li>@error</li> }</ul>
										}
									}
									else if (arm.Status is "pending" or "running")
									{
										<div class="rt-pending"><span></span>Migrating…</div>
									}

									@if (!string.IsNullOrEmpty(arm.Code))
									{
										<pre class="rt-code">@arm.Code</pre>
									}
								</section>
							}

							@if (migration.Status == "completed" && migration.Arms.Count == 3)
							{
								<section class="rt-qa">
									<header class="rt-head"><span class="rt-step">✓</span><div><strong>Verdict</strong><small>decided by execution, not by a model</small></div></header>
									<table class="audit-table">
										<thead><tr><th>Arm</th><th>Grounding</th><th>Cases passed</th><th>Prompt tokens</th></tr></thead>
										<tbody>
											@foreach (var arm in migration.Arms)
											{
												<tr><td>@arm.Arm</td><td>@GroundingLabel(arm.Grounding)</td><td>@arm.Passed / @arm.Cases.Count</td><td>@arm.PromptTokens.ToString("N0")</td></tr>
											}
										</tbody>
									</table>
									<h4>Read this carefully</h4>
									<ul class="rt-list warn">
										<li>One program, one run per arm. This demonstrates a method; it does not measure a migration programme.</li>
										<li>The case set covers the branches we thought of. A boundary we did not think of is not covered — note that a deliberately wrong implementation still passes most of these cases.</li>
										<li>The target is C# rather than Java because the server can execute C# deterministically. The grounding question is the same either way.</li>
										<li>Arm C's advantage, if any, comes from facts the compiler resolved — not from the compiler's C being easier to read. It is not; it is <code>goto</code> chains and <code>cob_decimal</code> calls.</li>
										<li><strong>The oracle is only as right as its dialect.</strong> Before trusting this against production, confirm the <code>TRUNC</code> option the mainframe build actually uses — <code>TRUNC(BIN)</code>, <code>TRUNC(STD)</code> or <code>TRUNC(OPT)</code>. Mismatch it and every number downstream inherits the error.</li>
									</ul>
								</section>
							}
						}
					</section>
					break;
				case 17:
					<section>
						<p class="kicker">STOP BAD WORK BEFORE IT STARTS</p>
						<h2 id="scene-title">A ticket an agent cannot act on</h2>
						<p class="rt-intro">Most agent failures are underspecified tickets, not weak models. A <strong>deterministic pre-check</strong> scores the ticket before any model sees it. Claude then grades it against the same rubric and rewrites it so it would pass.</p>

						@if (_session?.TicketGate is { } gate)
						{
							<section class="rt-box rt-input-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>The ticket</strong><small>edit it and re-run to see the score move</small></div></header>
								<textarea class="rt-code-input" spellcheck="false" maxlength="8000" @bind="_ticketText" @bind:event="oninput" disabled="@TicketBusy" aria-label="JIRA ticket"></textarea>
								<div class="rt-actions">
									<small>@_ticketText.Length / 8000</small>
									<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || TicketBusy)" @onclick="RunTicketGate">@TicketButtonText</button>
								</div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running the gate.</p>
								}
							</section>

							@if (LivePrecheck is { } precheck)
							{
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">2</span><div><strong>Deterministic pre-check</strong><small>no model, no bridge · recomputed as you type</small></div></header>
									<div class="@(precheck.Passed ? "compare-status" : "compare-status failed")" role="status">
										Score @precheck.Score / 100 — @(precheck.Passed ? "PASSES the gate" : "FAILS the gate (needs 70)")
									</div>
									<table class="audit-table">
										<thead><tr><th>Criterion</th><th>Met</th><th>Detail</th></tr></thead>
										<tbody>
											@foreach (var signal in precheck.Signals)
											{
												<tr><td>@signal.Name</td><td>@(signal.Present ? "yes" : "no")</td><td>@signal.Detail</td></tr>
											}
										</tbody>
									</table>
									@if (precheck.VagueTerms.Count > 0)
									{
										<h4>Vague language found</h4>
										<ul class="rt-list warn">@foreach (var term in precheck.VagueTerms) { <li>“@term”</li> }</ul>
									}
								</section>
							}

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>Review and rewrite</strong><small>@(gate.Review?.Model ?? "Claude Opus 5")</small></div></header>
								@if (gate.Review is { } graded)
								{
									<div class="@(graded.Passed ? "compare-status" : "compare-status failed")" role="status">
										Model score @graded.Score / 100 — @(graded.Passed ? "would pass" : "would not pass")
									</div>
									<p class="rt-reco">@graded.Verdict</p>
									<table class="audit-table">
										<thead><tr><th>Criterion</th><th>Met</th><th>Note</th></tr></thead>
										<tbody>
											@foreach (var finding in graded.Findings)
											{
												<tr><td>@finding.Name</td><td>@(finding.Present ? "yes" : "no")</td><td>@finding.Detail</td></tr>
											}
										</tbody>
									</table>
									@if (!string.IsNullOrEmpty(graded.Rewritten))
									{
										<h4>The same ticket, rewritten to pass</h4>
										<pre class="rt-story">@graded.Rewritten</pre>
									}
								}
								else if (TicketBusy)
								{
									<div class="rt-pending"><span></span>Claude is grading the ticket…</div>
								}
								else if (gate.Status == "failed")
								{
									<div class="compare-status failed" role="alert">@(gate.Error ?? "The review did not complete.")</div>
								}
								else
								{
									<div class="rt-placeholder">The review and rewrite will appear here.</div>
								}
							</section>
						}
					</section>
					break;
				case 18:
					<section>
						<p class="kicker">FIND WHAT WAS PLANTED</p>
						<h2 id="scene-title">Auditing a cloud design an AI helped write</h2>
						<p class="rt-intro">A proposed GCP sandbox with defects deliberately planted in it. Gemma audits it against the five-pillar checklist; Claude then grades that audit against the sealed list of what was actually planted. The list is revealed only after grading.</p>

						@if (_session?.TrapHunt is { } hunt)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>The proposed design</strong><small>Terraform · human + LLM authored</small></div></header>
								<pre class="rt-code">@hunt.Design</pre>
								<div class="rt-actions">
									<small>@GovernanceSamples.PlantedTraps.Length defects are planted in this file</small>
									<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || TrapBusy)" @onclick="RunTrapHunt">@TrapButtonText</button>
								</div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running the audit.</p>
								}
							</section>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>The audit</strong><small>@(hunt.FindingsModel ?? "Gemma 4")</small></div></header>
								@if (!string.IsNullOrEmpty(hunt.Findings))
								{
									<pre class="rt-story">@hunt.Findings</pre>
								}
								else if (hunt.Status == "hunting")
								{
									<div class="rt-pending"><span></span>Gemma is auditing the design…</div>
								}
								else
								{
									<div class="rt-placeholder">The agent's findings will appear here.</div>
								}
							</section>

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>Graded against the sealed list</strong><small>@(hunt.JudgeModel ?? "Claude Opus 5")</small></div></header>
								@if (hunt.Grade is { } grade)
								{
									<div class="@(grade.TrapsFound == grade.TrapsTotal ? "compare-status" : "compare-status failed")" role="status">
										Found @grade.TrapsFound of @grade.TrapsTotal planted defects.
									</div>
									<p class="rt-reco">@grade.Verdict</p>
									@if (grade.Matched.Count > 0)
									{
										<h4>Caught</h4><ul class="rt-list good">@foreach (var item in grade.Matched) { <li>@item</li> }</ul>
									}
									@if (grade.Missed.Count > 0)
									{
										<h4>Missed</h4><ul class="rt-list warn">@foreach (var item in grade.Missed) { <li>@item</li> }</ul>
									}
									@if (grade.FalsePositives.Count > 0)
									{
										<h4>False positives — these cost a reviewer's time</h4>
										<ul class="rt-list warn">@foreach (var item in grade.FalsePositives) { <li>@item</li> }</ul>
									}
									@if (hunt.PlantedTraps.Count > 0)
									{
										<h4>What was planted</h4>
										<ol class="rt-list">@foreach (var item in hunt.PlantedTraps) { <li>@item</li> }</ol>
									}
								}
								else if (hunt.Status == "judging")
								{
									<div class="rt-pending"><span></span>Claude is grading the audit…</div>
								}
								else if (hunt.Status == "failed")
								{
									<div class="compare-status failed" role="alert">@(hunt.Error ?? "The audit did not complete.")</div>
								}
								else
								{
									<div class="rt-placeholder">The grade will appear here once the audit completes.</div>
								}
							</section>
						}
					</section>
					break;
				case 19:
					<section>
						<p class="kicker">IS THE AGENT STILL DOING THE JOB?</p>
						<h2 id="scene-title">One golden case, three layers of drift</h2>
						<p class="rt-intro">A frozen commit, the ticket, and the patch a competent human wrote. A candidate patch is scored across three layers: <strong>functional</strong>, <strong>structural</strong> and <strong>semantic</strong>. The first two are deterministic. Only the last asks a model — and only about intent.</p>

						@if (_session?.Drift is { } drift)
						{
							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>The golden case</strong><small>ticket + frozen commit + the human patch</small></div></header>
								<pre class="rt-story">@drift.Ticket</pre>
								<div class="rt-flow">
									<div><h4>Frozen baseline</h4><pre class="rt-code">@drift.FrozenCode</pre></div>
									<div><h4>Human patch</h4><pre class="rt-code">@drift.HumanPatch</pre></div>
								</div>
							</section>

							<section class="rt-box rt-input-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>Candidate patch</strong><small>@drift.CandidateLabel</small></div></header>
								<pre class="rt-code">@drift.CandidatePatch</pre>
								<div class="rt-actions">
									<small>Score the drifted patch, or the human patch as a control</small>
									<div>
										<button class="secondary-command compact" type="button" disabled="@(!_bridgeConnected || DriftBusy)" @onclick="() => RunDrift(true)">Score the control</button>
										<button class="primary-command compact" type="button" disabled="@(!_bridgeConnected || DriftBusy)" @onclick="() => RunDrift(false)">@(DriftBusy ? "Scoring…" : "Score the agent patch")</button>
									</div>
								</div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">The structural layer below works without the bridge. Connect the VSIX to add the semantic layer.</p>
								}
							</section>

							@if (drift.Structural is { } structural)
							{
								<section class="rt-box">
									<header class="rt-head"><span class="rt-step">3</span><div><strong>Structural layer</strong><small>deterministic · diffed against the human patch</small></div></header>
									<div class="@(structural.Score == 100 ? "compare-status" : "compare-status failed")" role="status">
										Structural score @structural.Score / 100
									</div>
									<table class="audit-table">
										<thead><tr><th>Check</th><th>Held</th><th>Detail</th></tr></thead>
										<tbody>
											@foreach (var finding in structural.Findings)
											{
												<tr><td>@finding.Name</td><td>@(finding.Present ? "yes" : "no")</td><td>@finding.Detail</td></tr>
											}
										</tbody>
									</table>
									<h4>Functional layer — the verification oracle</h4>
									<ul class="rt-list">@foreach (var check in DriftSamples.Oracle) { <li>@check.Name — <code>@check.Assertion</code></li> }</ul>
								</section>
							}

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">4</span><div><strong>Semantic layer</strong><small>@(drift.Semantic?.Model ?? "Claude Opus 5") · goal fidelity and scope discipline</small></div></header>
								@if (drift.Semantic is { } semantic)
								{
									<div class="clara-signature">
										Goal fidelity <strong>@semantic.GoalFidelity/5</strong> · scope discipline <strong>@semantic.ScopeDiscipline/5</strong>
									</div>
									<p class="rt-reco">@semantic.Verdict</p>
									@if (semantic.Deviations.Count > 0)
									{
										<h4>Departures from the ticket</h4>
										<ul class="rt-list warn">@foreach (var item in semantic.Deviations) { <li>@item</li> }</ul>
									}
									<h4>Read this carefully</h4>
									<ul class="rt-list warn">
										<li>One golden case. A drift programme needs 30–50; this proves the scorecard, not the trend.</li>
										<li>Drift is measured over time. A single score is a reading, not a direction.</li>
										<li>The functional and structural layers are reproducible. The semantic layer is a model's opinion and should be anchored to a human-labelled gold set before anyone acts on it.</li>
									</ul>
								}
								else if (DriftBusy)
								{
									<div class="rt-pending"><span></span>Claude is assessing goal fidelity and scope discipline…</div>
								}
								else if (drift.Status == "failed")
								{
									<div class="compare-status failed" role="alert">@(drift.Error ?? "The review did not complete.")</div>
								}
								else
								{
									<div class="rt-placeholder">The semantic assessment will appear here.</div>
								}
							</section>
						}
					</section>
					break;
			}
		</article>

		<footer class="stage-footer">
			<button class="secondary-command" type="button" disabled="@(_scene == 0)" @onclick="Previous">← Previous</button>
			<div class="narration-text"><span>Narration transcript</span><p>@CurrentNarration</p></div>
			<button class="secondary-command" type="button" disabled="@(_scene == Scenes.Length - 1)" @onclick="Next">Next →</button>
		</footer>
	</section>

	<aside class="connection-drawer" aria-hidden="@(!_drawerOpen)">
		<button class="drawer-toggle" type="button" title="Hide the local bridge panel" aria-label="Hide the local bridge panel" aria-expanded="true" aria-controls="bridge-drawer" @onclick="ToggleDrawer">Hide &rsaquo;</button>
		<p class="eyebrow">LOCAL BRIDGE</p><h2>Connect VS Code</h2><p>Run <strong>POC Training: Connect</strong> in VS Code and paste this session token.</p>
		<code>@_session?.BridgeToken</code><button type="button" @onclick="CopyToken">Copy token</button>
		<dl><dt>Server</dt><dd>127.0.0.1:5000</dd><dt>Coach</dt><dd>Gemma 4</dd><dt>Review</dt><dd>Claude Opus 5</dd></dl>
	</aside>

	@if (!_drawerOpen)
	{
		<button class="drawer-reopen" type="button" title="Show the local bridge panel" aria-label="Show the local bridge panel" aria-expanded="false" aria-controls="bridge-drawer" @onclick="ToggleDrawer">
			<span class="status-dot @(_bridgeConnected ? "online" : null)"></span>&lsaquo; Local bridge
		</button>
	}
</div>

@code {
