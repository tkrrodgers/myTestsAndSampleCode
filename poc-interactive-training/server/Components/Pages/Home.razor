										</div>
									</div>
									<table class="audit-table">
										<thead><tr><th>#</th><th>Section</th><th>Sealed</th><th>Classifier</th><th>Fate in arm I</th></tr></thead>
										<tbody>
											@foreach (var ccd in fxFilter.Decisions)
