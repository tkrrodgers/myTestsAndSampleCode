							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>Tier 1 — Cortex global ecosystem</strong><small>@portfolio.Services.Count services · structure, ownership, health</small></div></header>
								<div class="audit-body">
									<table class="audit-table">
										<thead><tr><th>Service</th><th>APM</th><th>Domain</th><th>Client orders</th><th>Health</th><th>Depends on</th></tr></thead>
