@page "/"
@implements IAsyncDisposable
@inject TrainingSessionStore Store
@inject ClaraBenchmark Benchmark
@inject AgentRegistryService Registry
@inject DataTierClassifier DataTier
@inject ActionAuthorityService Authority
@inject RegressionAdequacyService Regression
@inject PortfolioContextService Portfolio
@inject CommonCodeAuditService CommonCode
@inject TokenEconomicsService Economics
@inject PatternLibraryService Library
@inject AutopilotContract Contract
@inject CobolDomainService CobolDomains
@inject ContextClassifierService Classifier
@inject LlmShootoutService Shootout
@inject LocalInferenceService LocalInference
@inject NotesClassificationService NotesClassifier
@inject RoomChatService Room
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>AI Support &mdash; Interactive Training</PageTitle>

<div class="app-shell @(_drawerOpen ? null : "drawer-closed")">
	<aside class="rail" aria-label="Lesson navigation">
		<div class="brand-mark" aria-hidden="true">AI Support</div>
		<div>
			<p class="eyebrow">CES AI REAL DEMOS</p>
			<h1>Interactive<br />Training</h1>
		</div>
		<ol class="scene-list">
			@for (var index = 0; index < Scenes.Length; index++)
			{
				var sceneIndex = index;
				<li class="@(sceneIndex == _scene ? "active" : null)">
					<button type="button" @onclick="() => GoTo(sceneIndex)">
						<span>@(sceneIndex + 1)</span>@Scenes[sceneIndex].Title
					</button>
				</li>
			}
		</ol>
		<div class="bridge-state" aria-live="polite">
			<span class="status-dot @(_bridgeConnected ? "online" : null)"></span>
			<div>
				<strong>@(_bridgeConnected ? "VSIX connected" : "Waiting for VSIX")</strong>
				<small>@(_session?.CoachStatus ?? "not started")</small>
			</div>
		</div>
	</aside>

	<section class="stage">
		<header class="stage-header">
			<div><p class="eyebrow">SCENE @(_scene + 1) / @Scenes.Length</p><strong>@Scenes[_scene].Title</strong></div>
			<div class="header-actions">
				<button class="icon-button" type="button" title="Play narration" aria-label="Play narration" @onclick="Speak">
					<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4.5 2.6a.6.6 0 0 1 .92-.5l7 5.4a.6.6 0 0 1 0 1l-7 5.4a.6.6 0 0 1-.92-.5z" /></svg>
				</button>
				<button class="icon-button" type="button" title="Stop narration" aria-label="Stop narration" @onclick="StopSpeaking">
					<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4.4 2.8h2.4v10.4H4.4zM9.2 2.8h2.4v10.4H9.2z" /></svg>
				</button>
				<span class="header-divider" aria-hidden="true"></span>
				<button class="icon-button" type="button" title="Previous scene" aria-label="Previous scene" disabled="@(_scene == 0)" @onclick="Previous">
					<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 2.6 4.6 8 10 13.4" /></svg>
				</button>
				<button class="icon-button" type="button" title="Next scene" aria-label="Next scene" disabled="@(_scene == Scenes.Length - 1)" @onclick="Next">
					<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M6 2.6 11.4 8 6 13.4" /></svg>
				</button>
				<span class="header-divider" aria-hidden="true"></span>
				@if (_autoRunning)
				{
					<button class="secondary-command compact auto-stop" type="button" @onclick="StopAutopilot">Stop auto-run (Esc)</button>
				}
				else
				{
					<select class="auto-profile" aria-label="Auto-run profile" @bind="_autoProfile" disabled="@(!Contract.Verify().Passed)">
						<option value="@AutoProfile.Deterministic">Deterministic (no models)</option>
						<option value="@AutoProfile.Full">Full (runs every model stage)</option>
					</select>
					<button class="secondary-command compact" type="button" disabled="@(!AutopilotReady)" title="@AutopilotTitle" @onclick="StartAutopilot">Auto-run</button>
				}
			</div>
		</header>

		@if (_autoRunning || _autoCompleted)
		{
			<div class="auto-bar" role="status" aria-live="polite">
				<span class="auto-dot @(_autoRunning ? "active" : null)"></span>
				<strong>@_autoStatus</strong>
				<small>@_autoStepIndex / @_autoTotal steps &middot; scene @(_scene + 1) of @Scenes.Length</small>
				@if (_autoFailures > 0)
				{
					<small class="auto-failures">@_autoFailures step(s) did not complete &mdash; shown, not hidden</small>
				}
			</div>
		}

		@if (!string.IsNullOrWhiteSpace(_speechNotice))
		{
			<div class="model-banner warning" role="status">@_speechNotice</div>
		}

		@if (_session is not null && _session.CoachFallbackUsed)
		{
			<div class="model-banner warning" role="status">Gemma was unavailable. Narration text was authored by <strong>@_session.CoachModel</strong>; browser speech remains the audio provider.</div>
		}
		else if (_session?.CoachStatus == "completed")
		{
			<div class="model-banner" role="status">Grounded coach ready: <strong>@_session.CoachModel</strong></div>
		}
		@if (!string.IsNullOrWhiteSpace(_session?.LastError))
		{
			<div class="model-banner error" role="alert">@_session.LastError</div>
		}

		<article class="scene" aria-labelledby="scene-title">
			@switch (_scene)
			{
				case 0:
					<div class="intro-scene">
						<header class="intro-hero">
							<p class="kicker">DIRECTOR OF AI &middot; PROGRAMME OVERVIEW</p>
							<h2 id="scene-title">Help teams adopt AI<br /><em>without asking them to take it on trust.</em></h2>
							<p class="lede">
								Six priorities, thirty-eight working demonstrations. Every scene ends in a number, and every scene
								says whether that number came from running something or from asking a model. Where the honest answer
								is &ldquo;we have not built this yet&rdquo;, it is listed at the bottom of this page rather than left out.
							</p>
							<p class="intro-nav-hint">
								Blue references jump straight to the scene. Nothing below has to be read in order &mdash;
								@SceneLink("leadership-map") is the shortest path if you have twenty minutes.
							</p>
						</header>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">0</span><div><strong>Before any of it: the prerequisites</strong><small>deterministic &middot; no model involved</small></div></header>
							<div class="audit-body">
								<p>
									Two controls have to hold before agentic delivery is safe to scale, and neither may depend on a model &mdash;
									a prerequisite that can hallucinate is not a prerequisite. @SceneLink("phase-zero") enumerates and tiers
									every agent and blocks anything unregistered; @SceneLink("action-authority") decides authority per exact
									action against a registered envelope, so approving &ldquo;deploy&rdquo; never means approving deployment.
									@SceneLink("ephemeral-test") is the third: realistic test data is the best fixture and the worst leak, so the
									ticket is gated before it leaves the boundary and the audit record keeps references rather than payloads.
								</p>
								<p class="ctx-method">These three run with no model at all. That is the design, not a limitation.</p>
							</div>
						</section>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">1</span><div><strong>Training and success sharing</strong><small>practical, grounded in real scenarios, adaptable</small></div></header>
							<div class="audit-body">
								<p>
									The curriculum starts from a single defensible investigation: @SceneLink("welcome") follows a JIRA story to
									one code path, @SceneLink("why-okf") explains why a knowledge graph beats keyword search,
									@SceneLink("artifact-tree") shows the artifact structure that makes it reviewable, and
									@SceneLink("jira-trace") walks the evidence chain step by step.
								</p>
								<p>
									Practice, not lecture: @SceneLink("prompt-challenge")
									has Claude coach a learner's prompt against a rubric, and @SceneLink("framing-lab") measures how much the
									asker's own phrasing moved the answer &mdash; the most expensive bias is the one you introduced yourself.
									@SceneLink("animation-demo") and @SceneLink("image-demo") exist to make the point that motion and bitmaps
									aid comprehension but cannot carry the authoritative content.
								</p>
								<p>
									Sharing is @SceneLink("pattern-library"): a shared prompt library scales whatever you put in it, including
									the mistakes, so contributions are admitted on evidence, preconditions and known failure modes rather than
									enthusiasm. @SceneLink("leadership-map") is the same material reordered for an executive audience.
								</p>
							</div>
						</section>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">2</span><div><strong>Quality assurance and agentic readiness</strong><small>is the work ready for an agent, and would we notice if it were not</small></div></header>
							<div class="audit-body">
								<p>
									Most agent failures are underspecified tickets, not weak models. @SceneLink("ticket-gate") scores the story
									deterministically before any model sees it, then has Claude rewrite it so it would pass &mdash; and it uses a
									zero-token-cost model for the grading, which is the point.
								</p>
								<p>
									Green tests are not coverage. @SceneLink("regression-adequacy") compiles and runs the suite, then injects one
									deliberate defect at a time; a defect that survives is a defect the suite would have shipped.
									@SceneLink("drift-scorecard") holds the golden baseline &mdash; a frozen commit, its ticket, and the patch a
									human actually wrote &mdash; and scores a candidate patch functionally, structurally and semantically.
									@SceneLink("trap-hunt") does the same for cloud design against planted defects, and
									@SceneLink("plan-first") refuses to accept an implementation before a readable plan.
								</p>
							</div>
						</section>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">3</span><div><strong>Adoption enablement and token optimisation</strong><small>right model, right task, right context</small></div></header>
							<div class="audit-body">
								<p>
									@SceneLink("model-comparison") asks three models the same question and has a judge blind-score them against
									live vendor documentation. @SceneLink("llm-shootout") is the engineering version: four models design the same
									COBOL-to-Java conversion and a real COBOL compiler marks the checkable part before any judge speaks &mdash; the
									right model for a job is rarely the one that is best at everything. @SceneLink("speculative-decoding") runs on the
									laptop itself and measures whether a small draft model makes a larger one faster &mdash; and shows why that lever exists
									only inside a serving process, never across vendors. @SceneLink("token-economics") makes the harder argument: free is the wrong word and
									cost per token is the wrong unit, because a model that fails a third of the time is billed for every failure.
									Budget in cost per successful outcome.
								</p>
								<p>
									Grounding is what makes the cheap model viable. @SceneLink("round-trip") measures how much behaviour survives a
									class &rarr; story &rarr; class round trip; @SceneLink("llm-support") harvests a specialist model's answer past
									another model's knowledge boundary; @SceneLink("crypto-sme") is the sharpest version &mdash; Claude answers
									unaided, consults a Gemma grounded on vendor documentation, then designs, and the delta is measured against
									verified facts. That scene is also where the uncomfortable finding lives: delegation only retrieves what the
									delegator thought to ask.
								</p>
								<p>
									The right context is the other half of the token bill. @SceneLink("classify-context") has a classifier that runs on
									this machine drop the off-topic sections of a mixed design before the model sees it, then compiles and executes what
									Gemma builds from each version; @SceneLink("focus-ignore") keeps everything and instead names what to ignore, and
									counts output tokens as well as input to see which lever actually pays.
								</p>
							</div>
						</section>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">4</span><div><strong>Agent effectiveness monitoring</strong><small>how much context is enough, and how would we know</small></div></header>
							<div class="audit-body">
								<p>
									@SceneLink("context-curve") is the direct implementation of the priority: the same task and the same model, run
									against a cumulative ladder of context, scored against sealed criteria the model never sees. Add context until
									quality plateaus and remove it until quality collapses &mdash; the plateau is the token budget, measured rather
									than argued. @SceneLink("plan-first") supplies the &ldquo;describe how you would take this from 1.0 to 1.1, and
									name the context you used&rdquo; artifact, and @SceneLink("drift-scorecard") is where a sampled production change
									would be scored.
								</p>
							</div>
						</section>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">5</span><div><strong>Enterprise architecture consolidation</strong><small>three real repositories, not a thought experiment</small></div></header>
							<div class="audit-body">
								<p>
									@SceneLink("common-code") runs embedding similarity over three real trading repositories to find duplication by
									meaning rather than by name, then has Claude design the consolidation and Gemma write it &mdash; the expensive
									model billed for judgement, not for typing. @SceneLink("audit-code") rates the code deterministically with Roslyn
									first, so the model's recommendations rest on reproducible numbers.
								</p>
								<p>
									Modernisation is the same argument over a longer horizon: @SceneLink("modernize") treats legacy comprehension as a
									recurring token tax worth paying down once, and @SceneLink("cobol-migration") proves it by compiling and executing
									every migration against outputs captured from the real legacy program &mdash; nothing in that scene is graded by a
									model. @SceneLink("llm-language") and @SceneLink("language-test") ask the speculative question: what if the business
									rules lived in a language a human and an LLM read identically.
								</p>
								<p>
									A sixty-million-line estate is a mapping problem before it is a migration problem. @SceneLink("cobol-domains") parses
									real IBM COBOL, builds the call and data graphs and partitions them into candidate domains with coverage published
									alongside the map; @SceneLink("notes-to-domains") asks whether the programmers' own notes can rebuild a hand-written
									domain catalog, and shows why the call graph is needed to place the concerns that live everywhere.
								</p>
							</div>
						</section>

						<section class="rt-box">
							<header class="rt-head"><span class="rt-step">6</span><div><strong>Repository context and knowledge mapping</strong><small>Cortex &rarr; APM ID &rarr; repository</small></div></header>
							<div class="audit-body">
								<p>
									@SceneLink("portfolio-tiers") is the three-tier model end to end: Cortex maps the estate and finds candidate
									services, the APM record bounds what a team actually owns and settles scope, and the repository's own OKF bundle
									is the only tier that can name a file. Load them in the wrong order and you either miss a service or bury the model
									in context it should never have seen.
								</p>
								<p>
									@SceneLink("audit-context") is the cheap gate in front of it &mdash; a deterministic scan plus a classifier decide
									whether a repository has usable context before anyone spends tokens on it. @SceneLink("artifact-tree") and
									@SceneLink("why-okf") define what a Tier 3 artifact set has to contain to be worth loading.
								</p>
							</div>
						</section>

						<section class="rt-box" data-auto="s01.gaps">
							<header class="rt-head"><span class="rt-step">!</span><div><strong>What the role calls for and this lab does not yet do</strong><small>stated here so nobody has to discover it in a demo</small></div></header>
							<div class="audit-body">
								<p class="rt-reco">Thirty-eight demonstrations cover the six priorities unevenly. These are the gaps I would fund first.</p>
								<table class="audit-table">
									<thead><tr><th>Missing capability</th><th>Nearest scene</th><th>Why the scene is not sufficient</th></tr></thead>
									<tbody>
										<tr class="p0-req"><td>Golden baseline as a maintained asset</td><td>@SceneLink("drift-scorecard")</td><td>One frozen case is a demonstration. There is no story for how cases are chosen, versioned, or retired as the code moves under them.</td></tr>
										<tr class="p0-req"><td>Sampling method for production review</td><td>@SceneLink("drift-scorecard")</td><td>&ldquo;A representative percentage&rdquo; needs a defined rate, a selection method and a reviewer. Without those it is anecdote, not monitoring.</td></tr>
										<tr class="p0-req"><td>Did the training change behaviour</td><td>&mdash;</td><td>No scene. Nothing tracks a learner over time or measures delivery outcomes before and after.</td></tr>
										<tr class="p0-req"><td>Success-story capture loop</td><td>@SceneLink("pattern-library")</td><td>The library admits prompts. It does not capture outcomes, lessons learned, or the failures that are usually more instructive.</td></tr>
										<tr class="p0-req"><td>Vendor model drift over time</td><td>@SceneLink("drift-scorecard")</td><td>That scene measures agent output against a golden patch. It does not detect the provider silently changing the model underneath you.</td></tr>
										<tr class="p0-req"><td>Runtime incident response and observability</td><td>&mdash;</td><td>No scene. Covered in the written strategy only. This is the gap that matters most once agents touch production.</td></tr>
										<tr class="p0-req"><td>Portfolio-level ROI baseline</td><td>@SceneLink("token-economics")</td><td>Per-task cost modelling with illustrative rates. It does not roll up to a programme baseline anyone could defend in a budget review.</td></tr>
										<tr class="p0-req"><td>Operating model and intake</td><td>&mdash;</td><td>No scene. Who requests an engagement, who does the work, and what teams are accountable for is undefined.</td></tr>
									</tbody>
								</table>
							</div>
						</section>

						<section class="rt-box" data-auto="s01.caveats">
							<header class="rt-head"><span class="rt-step">&#8253;</span><div><strong>How to read the numbers</strong><small>the caveats that belong in the room</small></div></header>
							<div class="audit-body">
								<ul class="rt-list warn">
									<li><strong>Model-scored numbers are judgement, not measurement.</strong> Scenes state which of the two they are. Keyword-based recall scores measure vocabulary, not correctness &mdash; treat them as a floor.</li>
									<li><strong>Most results are single runs.</strong> These models are not deterministic. A difference of a few points between two arms is noise until it is repeated.</li>
									<li><strong>The fixtures are synthetic except where stated.</strong> @SceneLink("common-code") and @SceneLink("portfolio-tiers") use three real repositories; almost everything else is a purpose-built fixture with known planted answers.</li>
									<li><strong>Similarity thresholds are corpus-specific.</strong> The consolidation threshold was calibrated on this corpus and separates duplicates from unrelated code by a narrow margin. It will not transfer unchanged.</li>
									<li><strong>@SceneLink("regression-adequacy") executes mutated code in-process.</strong> That is acceptable on a laptop and not acceptable on a shared host.</li>
									<li><strong>This is a proof of concept.</strong> It exists to make the strategy arguable with evidence, not to be a production platform.</li>
								</ul>
							</div>
						</section>
					</div>
					break;

				case 1:
					<section class="opening-scene">
						<div class="opening-copy">
							<p class="kicker">GROUND BEFORE YOU GENERATE</p>
							<h2 id="scene-title">Find the right code.<br /><em>Know why it is right.</em></h2>
							<p class="lede">A guided investigation from a JIRA story, through an OKF knowledge graph, to one defensible implementation path.</p>
							@if (!_started)
							{
								<button class="primary-command" type="button" data-auto="s02.start" @onclick="StartLesson">Start the investigation <span>&rarr;</span></button>
							}
							else
							{
								<button class="primary-command" type="button" data-auto="s02.continue" @onclick="Next">Continue <span>&rarr;</span></button>
							}
						</div>
						<div class="path-visual" aria-label="JIRA story connects through OKF to code and tests">
							<div class="path-node jira"><span>01</span><strong>JIRA</strong><small>FUL-1842</small></div>
							<div class="path-line"><i></i></div>
							<div class="path-node okf"><span>02</span><strong>OKF</strong><small>governed context</small></div>
							<div class="path-line"><i></i></div>
							<div class="path-node code"><span>03</span><strong>CODE</strong><small>one owned path</small></div>
						</div>
					</section>
					break;
				case 2:
					<section>
						<p class="kicker">SEARCH FINDS WORDS. CONTEXT FINDS MEANING.</p>
						<h2 id="scene-title">Why OKF changes the investigation</h2>
						<div class="comparison-grid">
							<div class="comparison bad">
								<div class="comparison-label">Ungrounded path</div>
								<ol><li>Copy the ticket into chat</li><li>Search every “estimate” match</li><li>Choose the first plausible class</li><li>Ship an unsupported assumption</li></ol>
								<p>No ownership boundary. No decision history. No evidence trail.</p>
							</div>
							<div class="comparison good">
								<div class="comparison-label">OKF-grounded path</div>
								<ol><li>Start from the governed index</li><li>Resolve the business concept</li><li>Follow boundaries and decisions</li><li>Verify the mapped code and tests</li></ol>
								<p>Every material conclusion points back to a reviewable source.</p>
							</div>
						</div>
					</section>
					break;
				case 3:
					<section>
						<p class="kicker">THE CONTEXT ARTIFACT</p>
						<h2 id="scene-title">A map the human and model can inspect</h2>
						<div class="artifact-layout">
							<div class="artifact-tree" role="img" aria-label="Training fixture tree with OKF, JIRA, and source code folders">
								<div class="tree-root">training-fixture/</div>
								<ul>
									<li class="file primer-file">README.md <span>LLM consumer guide</span></li>
									<li class="folder open">okf/<ul><li class="file active">index.md</li><li class="folder">concepts/ <span>delivery-estimate.md</span></li><li class="folder">architecture/ <span>service-boundaries.md</span></li><li class="folder">decisions/ <span>adr-024-delay-source.md</span></li><li class="folder">code-map/ <span>fulfillment-components.md</span></li></ul></li>
									<li class="folder">jira/ <span>FUL-1842.md</span></li>
									<li class="folder">src/ <span>Fulfillment.Application/</span></li>
								</ul>
							</div>
							<div class="artifact-note">
								<span class="note-number">01</span>
								<h3>What OKF means</h3>
								<p><strong>Open Knowledge Format</strong> is a model-neutral directory of small Markdown concepts with YAML metadata and links that form a navigable knowledge graph.</p>
								<ul class="okf-primer-list">
									<li>Read the consumer guide, then start at <code>okf/index.md</code>.</li>
									<li>Follow concept ? boundary/decision ? code map ? current code/tests.</li>
									<li>Check provenance, verification, lifecycle, and freshness.</li>
									<li>Cite paths and surface missing knowledge instead of guessing.</li>
								</ul>
								<p class="trust-note">Structure improves inspectability; it does not guarantee truth or train model weights.</p>
								<div class="source-chip">training-fixture/README.md ? okf/index.md</div>
							</div>
						</div>
					</section>
					break;
				case 4:
					<section>
						<p class="kicker">DOES THE CONTEXT ACTUALLY CARRY THE WORK?</p>
						<h2 id="scene-title">From FUL-1842 to a grounded change</h2>
						<p class="rt-intro">The claim behind every context artifact is that an agent given <em>only</em> the governed context can resolve the ticket correctly. Here it is tested: Gemma 4 gets the OKF bundle and the source, implements <strong>FUL-1842</strong>, and Claude then traces each change back to the <strong>specific document and sentence</strong> that justifies it — and checks whether the deliberately missing fact was flagged rather than invented.</p>

						<div class="trace-grid">
							@for (var index = 0; index < TraceSteps.Length; index++)
							{
								var stepIndex = index;
								<button type="button" class="trace-step @(stepIndex == _traceStep ? "active" : null)" data-auto="s05.step-@(stepIndex + 1)" @onclick="() => _traceStep = stepIndex"><span>@(stepIndex + 1)</span><div><strong>@TraceSteps[stepIndex].Title</strong><small>@TraceSteps[stepIndex].Path</small></div></button>
							}
						</div>
						<div class="trace-evidence" aria-live="polite"><p class="eyebrow">OBSERVABLE EVIDENCE</p><h3>@TraceSteps[_traceStep].Finding</h3><p>@TraceSteps[_traceStep].Result</p><code>@TraceSteps[_traceStep].Path</code></div>

						@if (_session?.GroundedChange is { } change)
						{
							<section class="rt-box" data-auto="s05.context">
								<header class="rt-head"><span class="rt-step">1</span><div><strong>The context the agent is given</strong><small>the OKF bundle and the current source · nothing else is available to it</small></div></header>
								@foreach (var artifact in change.Context.Where(item => item.Kind != "jira"))
								{
									<details class="artifact-detail">
										<summary><code>@artifact.Path</code> <small>@artifact.Kind</small></summary>
										<pre class="rt-code">@artifact.Content</pre>
									</details>
								}
							</section>

							<section class="rt-box rt-input-box">
								<header class="rt-head"><span class="rt-step">2</span><div><strong>The ticket</strong><small>FUL-1842 · it never names the API field for estimate source — that omission is deliberate</small></div></header>
								<textarea class="rt-code-input" spellcheck="false" maxlength="8000" @bind="_changeJira" @bind:event="oninput" disabled="@ChangeBusy" aria-label="JIRA ticket"></textarea>
								<div class="rt-actions">
									<small>@(change.PromptTokens > 0 ? $"{change.PromptTokens:N0} prompt tokens" : "context + ticket")</small>
									<button class="primary-command compact" type="button" data-auto="s05.run" disabled="@(!_bridgeConnected || ChangeBusy)" @onclick="RunGroundedChange">@ChangeButtonText</button>
								</div>
								@if (!_bridgeConnected)
								{
									<p class="bridge-required" role="status">Connect the VSIX with the token shown under Local Bridge before running.</p>
								}
							</section>

							<section class="rt-box">
								<header class="rt-head"><span class="rt-step">3</span><div><strong>The implemented change</strong><small>@(change.ImplementationModel ?? "Gemma 4") · working only from the artifacts above</small></div></header>
								@if (!string.IsNullOrEmpty(change.Implementation))
								{
									<pre class="rt-code">@change.Implementation</pre>
								}
								else if (change.Status == "implementing")
								{
									<div class="rt-pending"><span></span>Gemma 4 is implementing the ticket from the OKF bundle…</div>
								}
								else
								{
									<div class="rt-placeholder">The implementation will appear here.</div>
								}
							</section>

							<section class="rt-qa">
								<header class="rt-head"><span class="rt-step">4</span><div><strong>Where did each change come from?</strong><small>@(change.Audit?.Model ?? "Claude Opus 5") · every decision traced to a quoted sentence</small></div></header>
								@if (change.Audit is { } audit)
								{
									<div class="@(audit.OpenQuestionRaised && audit.PlaceholdersMarked ? "compare-status" : "compare-status failed")" role="status">
										@(!audit.OpenQuestionRaised
											? "The missing API field name was NOT raised — the agent invented or ignored it."
											: audit.PlaceholdersMarked
												? "The missing API field name was raised, and the code left it genuinely unresolved."
												: "Raised as an open question — then hard-coded anyway. Naming a gap in prose is not the same as leaving it open in the code.")
									</div>
									@if (!string.IsNullOrEmpty(audit.OpenQuestionNote))
									{
										<p class="rt-reco">@audit.OpenQuestionNote</p>
									}
									@if (!string.IsNullOrEmpty(audit.PlaceholderNote))
									{
										<p class="rt-reco">@audit.PlaceholderNote</p>
									}
									<table class="audit-table">
										<thead><tr><th>Change</th><th>Justified by</th><th>The statement it rests on</th><th></th></tr></thead>
										<tbody>
											@foreach (var citation in audit.Citations)
											{
												<tr>
													<td>@citation.Change</td>
													<td><code>@citation.Document</code></td>
													<td>“@citation.Statement”</td>
													<td>@(citation.Grounded ? "grounded" : "UNSUPPORTED")</td>
												</tr>
											}
										</tbody>
									</table>
									@if (audit.Ungrounded.Count > 0)
									{
										<h4>Asserted without support in any artifact</h4>
										<ul class="rt-list warn">@foreach (var item in audit.Ungrounded) { <li>@item</li> }</ul>
									}
									<p class="rt-reco">@audit.Verdict</p>
									<h4>Read this carefully</h4>
									<ul class="rt-list warn">
										<li>This shows the context was <em>sufficient</em> for this ticket. It does not show it is sufficient for the next one.</li>
										<li>A quoted sentence proves the claim exists in the artifact. It does not prove the artifact is correct or current — check <code>verified</code> and <code>stale_after</code>.</li>
										<li>The audit is a model reading another model. The planted gap is the firmest signal, and it has two parts: the agent has to name what is missing <em>and</em> leave it unresolved in the code. An implementation that raises the question and then hard-codes an invented literal has reintroduced the failure the omission exists to catch.</li>
									</ul>
								}
								else if (change.Status == "auditing")
								{
									<div class="rt-pending"><span></span>Claude is tracing each change back to its source statement…</div>
								}
								else if (change.Status == "failed")
								{
									<div class="compare-status failed" role="alert">@(change.Error ?? "The demo did not complete.")</div>
								}
								else
								{
									<div class="rt-placeholder">The citation audit will appear here once the change is implemented.</div>
								}
							</section>
						}
					</section>
					break;
				case 5:
					<section>
						<p class="kicker">MOTION WITH A PURPOSE</p>
						<h2 id="scene-title">Watch context narrow the search</h2>
